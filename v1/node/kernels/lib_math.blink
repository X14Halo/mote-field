  // ---- small maths
  float smooth01(float x) {
    float c = clamp(x, 0.0f, 1.0f);
    return c * c * (3.0f - 2.0f * c);
  }
  float len3(float3 v) {
    return sqrt(dot(v, v));
  }
  float3 unit3(float3 v) {
    return v / max(len3(v), 1e-12f);
  }
  float wrap1(float x, float s) {
    float y = x + s * 0.5f;
    return y - s * floor(y / s) - s * 0.5f;
  }
  float erf_a(float x) {
    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)
    float ax = fabs(x);
    float t = 1.0f / (1.0f + 0.3275911f * ax);
    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;
    float r = 1.0f - p * exp(-ax * ax);
    return x < 0.0f ? -r : r;
  }
  float pi1() {
    return 3.14159265358979f;
  }
  int clampi(int x, int a, int b) {
    return x < a ? a : (x > b ? b : x);
  }
