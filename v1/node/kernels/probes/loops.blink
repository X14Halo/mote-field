kernel MFProbeLoops : ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessPoint, eEdgeClamped> src;
  Image<eWrite> dst;
  void process(int2 pos) {
    float s = 0.0f;
    for (int i = 0; i < 8; i++) {
      for (int j = 0; j < 8; j++) {
        if (j == i) {
          continue;
        }
        if (j > 5) {
          break;
        }
        s += 1.0f;
      }
    }
    dst() = float4(s, s, s, 1.0f);
  }
};
