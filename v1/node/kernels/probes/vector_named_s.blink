kernel MFProbeVectorNamedS : ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessRandom, eEdgeClamped> src;
  Image<eWrite> dst;
  void process(int2 pos) {
    float t = 0.0f;
    for (int j = 0; j < 8; j++) {
      for (int i = 0; i < 8; i++) {
        float4 s = src(i, j);
        t += s.w + s.z;
      }
    }
    dst() = float4(t, 0.0f, 0.0f, 1.0f);
  }
};
