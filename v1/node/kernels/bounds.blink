// MoteField: the extent of the set the camera sees (world, scene units), from clean pixels on a grid of samples:
// pixel 0 = low corner, pixel 1 = high corner, each the 0.5 / 99.5 percentile along each axis, so a few stray
// far-away pixels don't stretch it. 'Light only through openings' follows rays out of this box.
kernel MFBounds : ImageComputationKernel<ePixelWise>
{
  Image<eRead, eAccessPoint, eEdgeClamped> space;
  Image<eRead, eAccessRandom, eEdgeClamped> surf;
  Image<eWrite> dst;

  param:
//@decl

  local:
    float Wf;
    float Hf;

  void define() {
//@define
  }

//@params cam_pos cam_right cam_up cam_back cam_th
//@include lib_math
//@include lib_cam

  void init() {
    Wf = float(surf.bounds.width());
    Hf = float(surf.bounds.height());
  }

  // one axis of the world position under sample k of a 160 x 90 grid, or 1e30 if that pixel isn't a clean surface
  float sample_at(int k, int axis) {
    int i = k - (k / 160) * 160;
    int j = k / 160;
    float px = (float(i) + 0.5f) * Wf / 160.0f;
    float py = (float(j) + 0.5f) * Hf / 90.0f;
    float4 s = surf(surf.bounds.x1 + int(px), surf.bounds.y1 + int(py));
    if (s.w < 0.5f || s.z <= 0.0f) {
      return 1e30f;
    }
    float3 P = cam_pos + ray_dir(floor(px) + 0.5f, floor(py) + 0.5f) * s.z;
    return axis == 0 ? P.x : (axis == 1 ? P.y : P.z);
  }

  // the q-th fraction of the samples along one axis (by halving the range: no arrays, for older Blink)
  float percentile(int axis, float q) {
    float mn = 1e30f;
    float mx = -1e30f;
    float n = 0.0f;
    for (int k = 0; k < 14400; k++) {
      float c = sample_at(k, axis);
      if (c < 1e29f) {
        mn = min(mn, c);
        mx = max(mx, c);
        n += 1.0f;
      }
    }
    if (n < 1.0f) {
      return 0.0f;
    }
    float lo = mn;
    float hi = mx;
    for (int it = 0; it < 20; it++) {
      float mid = 0.5f * (lo + hi);
      float below = 0.0f;
      for (int k = 0; k < 14400; k++) {
        float c = sample_at(k, axis);
        if (c <= mid) {
          below += 1.0f;
        }
      }
      if (below >= q * n) {
        hi = mid;
      } else {
        lo = mid;
      }
    }
    return hi;
  }

  void process(int2 xy) {
    float q = xy.x == 0 ? 0.005f : 0.995f;
    dst() = float4(percentile(0, q), percentile(1, q), percentile(2, q), 1.0f);
  }
};
