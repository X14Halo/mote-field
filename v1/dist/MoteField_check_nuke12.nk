set cut_paste_input [stack 0]
version 12.2 v1
Constant {
 inputs 0
 channels rgb
 color {0.02 0.02 0.02 1}
 format "1920 1080 0 0 1920 1080 1 HD_1080"
 name MoteField_check_input
 selected true
 xpos 0
 ypos -100
}
BlinkScript {
 kernelSource "// MoteField: a check that BlinkScript runs here and does integer maths exactly (green square = good, red = not)\nkernel MFCheck : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> src;\n  Image<eWrite> dst;\n\n  param:\n    int motes;\n\n  local:\n    float width;\n    float height;\n    int ok;\n\n  void define() \{\n    defineParam(motes, \"motes\", 400);\n  \}\n\n  // ---- the hash: PCG on 32-bit words, kept as two 16-bit halves (x = high, y = low) so no int ever overflows.\n  // The same bits come out on every CPU and GPU, and they match the Python reference (motefield/rng.py).\n  int2 u_add(int2 a, int2 b) \{\n    int lo = a.y + b.y;\n    return int2((a.x + b.x + (lo >> 16)) & 65535, lo & 65535);\n  \}\n  int mul_lo16(int a, int b) \{\n    return (a * (b & 255) + (((a * (b >> 8)) & 255) << 8)) & 65535;\n  \}\n  int2 u_mul(int2 a, int2 b) \{\n    int p0 = a.y * (b.y & 255);\n    int p1 = a.y * (b.y >> 8);\n    int t = p0 + ((p1 & 255) << 8);\n    int carry = (t >> 16) + (p1 >> 8);\n    return int2((carry + mul_lo16(a.x, b.y) + mul_lo16(a.y, b.x)) & 65535, t & 65535);\n  \}\n  int2 u_xor(int2 a, int2 b) \{\n    return int2(a.x ^ b.x, a.y ^ b.y);\n  \}\n  int2 u_shr(int2 a, int k) \{\n    if (k >= 16) \{\n      return int2(0, a.x >> (k - 16));\n    \}\n    return int2(a.x >> k, ((a.y >> k) | (a.x << (16 - k))) & 65535);\n  \}\n  int2 pcg(int2 v) \{\n    int2 s = u_add(u_mul(v, int2(11410, 30645)), int2(44118, 19205));\n    int2 w = u_mul(u_xor(u_shr(s, (s.x >> 12) + 4), s), int2(4238, 62169));\n    return u_xor(u_shr(w, 22), w);\n  \}\n  int2 word(int v) \{\n    return int2((v >> 16) & 65535, v & 65535);\n  \}\n  int2 hash1(int2 a) \{\n    return pcg(a);\n  \}\n  int2 hash_more(int2 h, int2 w) \{\n    return pcg(u_add(h, w));\n  \}\n  float u01(int2 h) \{\n    return float((h.x << 8) | (h.y >> 8)) * (1.0f / 16777216.0f);\n  \}\n  void init() \{\n    width = float(src.bounds.width());\n    height = float(src.bounds.height());\n    int2 acc = int2(0, 0);\n    for (int i = 0; i < 64; i++) \{\n      acc = u_xor(acc, hash_more(hash_more(hash1(word(1)), int2(17493, 21332)), word(i)));\n    \}\n    ok = (acc.x == 49807 && acc.y == 41382) ? 1 : 0;\n  \}\n\n  void process(int2 pos) \{\n    float x = float(pos.x) + 0.5f;\n    float y = float(pos.y) + 0.5f;\n    float acc = 0.0f;\n    for (int i = 0; i < motes; i++) \{\n      int2 h = hash_more(hash_more(hash1(word(7)), int2(17493, 21332)), word(i));\n      float dx = x - u01(h) * width;\n      float dy = y - u01(pcg(h)) * height;\n      float r2 = dx * dx + dy * dy;\n      if (r2 < 64.0f) \{\n        acc += exp(-r2 / 8.0f);\n      \}\n    \}\n    float4 under = src();\n    float4 c = float4(under.x + acc, under.y + acc, under.z + acc, 1.0f);\n    if (x < 120.0f && y < 120.0f) \{\n      if (ok == 1) \{\n        c = float4(0.1f, 0.9f, 0.2f, 1.0f);\n      \} else \{\n        c = float4(0.9f, 0.1f, 0.1f, 1.0f);\n      \}\n    \}\n    dst() = c;\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 name MoteField_check
 label "green square = good"
 selected true
 xpos 0
 ypos 0
}
