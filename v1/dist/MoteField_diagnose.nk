BlinkScript {
 inputs 2
 ProgramGroup 1
 kernelSource "// MoteField: the extent of the set the camera sees (world, scene units), from clean pixels on a grid of samples:\n// pixel 0 = low corner, pixel 1 = high corner, each the 0.5 / 99.5 percentile along each axis, so a few stray\n// far-away pixels don't stretch it. 'Light only through openings' follows rays out of this box.\nkernel MFBounds : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> surf;\n  Image<eWrite> dst;\n\n  param:\n    float3 cam_pos;\n    float3 cam_right;\n    float3 cam_up;\n    float3 cam_back;\n    float cam_th;\n  local:\n    float Wf;\n    float Hf;\n\n  void define() \{\n    defineParam(cam_pos, \"cam_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(cam_right, \"cam_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(cam_up, \"cam_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(cam_back, \"cam_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(cam_th, \"cam_th\", 0.5f);\n  \}\n\n\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  // ---- the camera: world point -> pixel x, y (Nuke's, y up, pixel centres at .5) and depth along the view\n  float3 project_cam(float3 P, float3 pos, float3 rr, float3 uu, float3 bb, float th) \{\n    float3 d = P - pos;\n    float x = dot(d, rr);\n    float y = dot(d, uu);\n    float z = -dot(d, bb);\n    float zs = z > 1e-9f ? z : 1e-9f;\n    float tv = th * Hf / Wf;\n    return float3((x / zs / th * 0.5f + 0.5f) * Wf, (y / zs / tv * 0.5f + 0.5f) * Hf, z);\n  \}\n  float3 project_mid(float3 P) \{\n    return project_cam(P, cam_pos, cam_right, cam_up, cam_back, cam_th);\n  \}\n  // the unit direction of the ray through pixel position (px, py)\n  float3 ray_dir(float px, float py) \{\n    float tv = cam_th * Hf / Wf;\n    float3 d = cam_right * ((px / Wf * 2.0f - 1.0f) * cam_th) + cam_up * ((py / Hf * 2.0f - 1.0f) * tv) - cam_back;\n    return unit3(d);\n  \}\n  void init() \{\n    Wf = float(surf.bounds.width());\n    Hf = float(surf.bounds.height());\n  \}\n\n  // one axis of the world position seen at pixel position (px, py), or 1e30 if the pixel isn't a clean surface\n  float coord_of(float sw, float sz, float px, float py, int axis) \{\n    if (sw < 0.5f || sz <= 0.0f) \{\n      return 1e30f;\n    \}\n    float3 P = cam_pos + ray_dir(floor(px) + 0.5f, floor(py) + 0.5f) * sz;\n    return axis == 0 ? P.x : (axis == 1 ? P.y : P.z);\n  \}\n\n  // Blink reads images only in process() or in functions it calls directly, so the loops that read the surface\n  // image are all written out here, over a 160 x 90 grid. The q-th fraction of the samples along each axis is found\n  // by halving the range.\n  void process(int2 xy) \{\n    float q = xy.x == 0 ? 0.005f : 0.995f;\n    int x0 = surf.bounds.x1;\n    int y0 = surf.bounds.y1;\n    float r0 = 0.0f;\n    float r1 = 0.0f;\n    float r2 = 0.0f;\n    for (int axis = 0; axis < 3; axis++) \{\n      float mn = 1e30f;\n      float mx = -1e30f;\n      float n = 0.0f;\n      for (int j = 0; j < 90; j++) \{\n        for (int i = 0; i < 160; i++) \{\n          float px = (float(i) + 0.5f) * Wf / 160.0f;\n          float py = (float(j) + 0.5f) * Hf / 90.0f;\n          float4 s = surf(x0 + int(px), y0 + int(py));\n          float c = coord_of(s.w, s.z, px, py, axis);\n          if (c < 1e29f) \{\n            mn = min(mn, c);\n            mx = max(mx, c);\n            n += 1.0f;\n          \}\n        \}\n      \}\n      float lo = mn;\n      float hi = mx;\n      if (n < 1.0f) \{\n        hi = 0.0f;\n      \} else \{\n        for (int it = 0; it < 20; it++) \{\n          float mid = 0.5f * (lo + hi);\n          float below = 0.0f;\n          for (int j = 0; j < 90; j++) \{\n            for (int i = 0; i < 160; i++) \{\n              float px = (float(i) + 0.5f) * Wf / 160.0f;\n              float py = (float(j) + 0.5f) * Hf / 90.0f;\n              float4 s = surf(x0 + int(px), y0 + int(py));\n              float c = coord_of(s.w, s.z, px, py, axis);\n              if (c <= mid) \{\n                below += 1.0f;\n              \}\n            \}\n          \}\n          if (below >= q * n) \{\n            hi = mid;\n          \} else \{\n            lo = mid;\n          \}\n        \}\n      \}\n      if (axis == 0) \{\n        r0 = hi;\n      \} else if (axis == 1) \{\n        r1 = hi;\n      \} else \{\n        r2 = hi;\n      \}\n    \}\n    dst() = float4(r0, r1, r2, 1.0f);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable false
 vectorize false
 name mfdiag_kernel_bounds
 label "15"
 xpos 420
 ypos 140
}
