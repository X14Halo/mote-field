BlinkScript {
 inputs 4
 ProgramGroup 1
 kernelSource "// MoteField: the picture. Each pixel gathers the motes binned to its tile and adds up their light: small blur as a\n// Gaussian integrated over the pixel (so a mote's light never flickers with where it falls on the pixel grid), larger\n// blur as the lens aperture (blades, anamorphic squeeze, cat-eye, centre/rim brightness) normalised to keep the\n// mote's light, all along its motion-blur streak with the shutter's weighting (mirrors splat.draw in the Python\n// reference). Out: rgb, and alpha as set by the node (none, or a matte from the dust's brightness).\nkernel MFDraw : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessRandom, eEdgeClamped> surf;\n  Image<eRead, eAccessRandom, eEdgeClamped> motes;\n  Image<eRead, eAccessRandom, eEdgeClamped> bins;\n  Image<eRead, eAccessRandom, eEdgeClamped> rows;\n  Image<eWrite> dst;\n\n  param:\n    int blades;\n    int hdr_blades;\n    float anamorphic;\n    float hdr_anamorphic;\n    float bokeh_rot;\n    float bokeh_falloff;\n    int shutter_shape;\n    int alpha_mode;\n    float matte_gain;\n    int held;\n  local:\n    int tw;\n    int th;\n    float lens_blades;\n    float lens_sa;\n    float lens_rot;\n    float sg;\n    float cos_half;\n\n  void define() \{\n    defineParam(blades, \"blades\", 0);\n    defineParam(hdr_blades, \"hdr_blades\", 0);\n    defineParam(anamorphic, \"anamorphic\", 0.0f);\n    defineParam(hdr_anamorphic, \"hdr_anamorphic\", 0.0f);\n    defineParam(bokeh_rot, \"bokeh_rot\", 0.0f);\n    defineParam(bokeh_falloff, \"bokeh_falloff\", 0.0f);\n    defineParam(shutter_shape, \"shutter_shape\", 0);\n    defineParam(alpha_mode, \"alpha_mode\", 0);\n    defineParam(matte_gain, \"matte_gain\", 1.0f);\n    defineParam(held, \"held\", 1);\n  \}\n\n\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  float shutter_w(float u) \{\n    return shutter_shape == 0 ? 1.0f / (1.0f + exp(-9.0f * (u - 0.55f))) : 1.0f;\n  \}\n\n  void init() \{\n    int W = surf.bounds.width();\n    int H = surf.bounds.height();\n    tw = (W + 64 - 1) / 64;\n    th = (H + 36 - 1) / 36;\n    lens_blades = float(blades > 0 ? blades : hdr_blades);\n    lens_sa = sqrt(max((hdr_anamorphic > 0.0f ? hdr_anamorphic : 1.0f) + anamorphic, 0.05f));\n    lens_rot = 0.25f + bokeh_rot * 0.0174532925f;\n    sg = lens_blades >= 3.0f ? 6.28318530717959f / lens_blades : 1.0f;\n    cos_half = cos(sg * 0.5f);\n  \}\n\n  // the blur of one sample at offset (dx, dy) from it, radius R px (sums to 1 over the picture)\n  float spot(float dx, float dy, float R, float inv, float cx, float cy) \{\n    if (R < 2.5f) \{\n      float sp = sqrt(0.25f * R * R + 0.12f + 1.0f / 6.0f - 1.0f / 12.0f);\n      float lim = 4.0f * sp + 1.0f;\n      if (fabs(dx) > lim || fabs(dy) > lim) \{\n        return 0.0f;\n      \}\n      float k = 0.707106781f / sp;\n      float gx = 0.5f * (erf_a((dx + 0.5f) * k) - erf_a((dx - 0.5f) * k));\n      float gy = 0.5f * (erf_a((dy + 0.5f) * k) - erf_a((dy - 0.5f) * k));\n      return gx * gy;\n    \}\n    float aa = clamp(1.5f / R, 0.04f, 0.5f);\n    float xa = dx * lens_sa;\n    float ya = dy / lens_sa;\n    float rr = sqrt(xa * xa + ya * ya) / R;\n    if (rr > 1.0f + aa) \{\n      return 0.0f;\n    \}\n    float m = rr;\n    if (lens_blades >= 3.0f) \{\n      float a = atan2(-ya, xa) + lens_rot;\n      float ang = a - sg * floor(a / sg) - sg * 0.5f;\n      m = 0.65f * (rr * cos(ang) / cos_half) + 0.35f * rr;\n    \}\n    float q = m;\n    if (cx != 0.0f || cy != 0.0f) \{\n      float ax = dx / R - cx;\n      float ay = dy / R - cy;\n      float bx = dx / R + cx;\n      float by = dy / R + cy;\n      q = max(q, sqrt(max(ax * ax + ay * ay, bx * bx + by * by)));\n    \}\n    float win = 1.0f - smooth01((q - (1.0f - aa)) / (2.0f * aa));\n    return max(win * (1.0f + bokeh_falloff * (0.5f - m * m)), 0.0f) * inv;\n  \}\n\n  // one mote's light at pixel centre (px, py)\n  float3 mote_light(int i, float px, float py) \{\n    int row = i >> 7;\n    int col = i & (128 - 1);\n    float4 bb = motes(col, row);\n    if (px < bb.x || px > bb.z || py < bb.y || py > bb.w) \{\n      return float3(0.0f, 0.0f, 0.0f);\n    \}\n    float4 en = motes(col + 4 * 128, row);\n    float hold = held == 1 ? en.w : 1.0f;\n    if (hold <= 0.0f) \{\n      return float3(0.0f, 0.0f, 0.0f);\n    \}\n    float4 sk = motes(col + 128, row);\n    float4 rk = motes(col + 2 * 128, row);\n    float4 fc = motes(col + 3 * 128, row);\n    float R = rk.x;\n    int SK = int(rk.y + 0.5f);\n    int K = SK >> 5;\n    int S = SK & 31;\n    S = clampi(S, 1, 24);\n    K = clampi(K, 1, 24);\n    float bend = rk.z;\n    float total = 0.0f;\n    for (int s = 0; s < S; s++) \{\n      float ts = (float(s) + 0.5f) / float(S);\n      float sw = shutter_w(ts);\n      float bx = sk.x + (sk.z - sk.x) * ts;\n      float by = sk.y + (sk.w - sk.y) * ts;\n      for (int k = 0; k < K; k++) \{\n        float kf = K > 1 ? float(k) / float(K - 1) - 0.5f : 0.0f;\n        float qb = 0.25f - kf * kf;\n        float X = bx + fc.x * kf - fc.y * bend * qb;\n        float Y = by + fc.y * kf + fc.x * bend * qb;\n        total += sw * spot(px - X, py - Y, R, rk.w, fc.z, fc.w);\n      \}\n    \}\n    float f = total * hold;\n    return float3(en.x * f, en.y * f, en.z * f);\n  \}\n\n  void process(int2 xy) \{\n    int x = xy.x - surf.bounds.x1;\n    int y = xy.y - surf.bounds.y1;\n    float px = float(x) + 0.5f;\n    float py = float(y) + 0.5f;\n    // the tile (no integer division: Blink's CPU vectoriser can't always do it)\n    int T = clampi(int(floor((float(x) + 0.5f) / float(tw))), 0, 64 - 1) +\n            clampi(int(floor((float(y) + 0.5f) / float(th))), 0, 36 - 1) * 64;\n    float3 acc = float3(0.0f, 0.0f, 0.0f);\n    for (int r2 = 0; r2 < 8; r2++) \{\n      for (int c2 = 0; c2 < 4; c2++) \{\n        int m2 = int(rows(T, r2, c2));\n        for (int b2 = 0; b2 < 24; b2++) \{\n          if (m2 == 0) \{\n            break;\n          \}\n          if ((m2 & 1) != 0) \{\n            int r1 = r2 * 96 + c2 * 24 + b2;\n            for (int c1 = 0; c1 < 4; c1++) \{\n              int m1 = int(bins(T, r1, c1));\n              for (int b1 = 0; b1 < 24; b1++) \{\n                if (m1 == 0) \{\n                  break;\n                \}\n                if ((m1 & 1) != 0) \{\n                  acc += mote_light(r1 * 96 + c1 * 24 + b1, px, py);\n                \}\n                m1 = m1 >> 1;\n              \}\n            \}\n          \}\n          m2 = m2 >> 1;\n        \}\n      \}\n    \}\n    float alpha = 0.0f;\n    if (alpha_mode == 1) \{\n      alpha = clamp((0.2126f * acc.x + 0.7152f * acc.y + 0.0722f * acc.z) * matte_gain, 0.0f, 1.0f);\n    \}\n    dst() = float4(acc.x, acc.y, acc.z, alpha);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable false
 name mfdiag_kernel_draw
 label "21"
 xpos 1960
 ypos 140
}
NoOp {
 inputs 0
 name MoteField_diagnose
 label "Test next"
 addUserKnob {20 diagnose l Diagnose}
 addUserKnob {26 about l "" +STARTLINE T "Every MoteField kernel, and small probes of single Blink features, on the CPU. <b>Check builds</b> reads which failed to build, without rendering anything. <b>Test next</b> renders one node at a time: before each press, the line below says which node is next, so if Nuke crashes, that is the one. After a crash, set Next step to carry on past it. For a node that says ERROR, view it: Nuke shows the error text in the viewer."}
 addUserKnob {22 check_builds l "Check builds" T "import nuke\nnames = \['mfdiag_probe_basic', 'mfdiag_probe_float3_param', 'mfdiag_probe_float3_function', 'mfdiag_probe_bool_local', 'mfdiag_probe_loops', 'mfdiag_probe_random_component', 'mfdiag_kernel_modes', 'mfdiag_kernel_facts', 'mfdiag_kernel_surface', 'mfdiag_bounds_a_shell', 'mfdiag_bounds_b_read', 'mfdiag_bounds_c_coord', 'mfdiag_bounds_d_big_numbers', 'mfdiag_bounds_e_axis_loop', 'mfdiag_kernel_bounds', 'mfdiag_kernel_bounce', 'mfdiag_kernel_place', 'mfdiag_kernel_motes', 'mfdiag_kernel_bins', 'mfdiag_kernel_rows', 'mfdiag_kernel_draw', 'mfdiag_info_array_in_function', 'mfdiag_info_one_value_vector', 'mfdiag_info_while_loop', 'mfdiag_info_int_division'\]\nlines = \[\]\nfor i, name in enumerate(names):\n    n = nuke.toNode(name)\n    err = False\n    try:\n        err = n.hasError()\n    except Exception:\n        pass\n    lines.append('%d %s: %s' % (i + 1, name\[7:\], 'ERROR' if err else 'no error yet'))\nme = nuke.thisNode()\ni = max(int(me\['step'\].value()) - 1, 0)\nnxt = ('<b>Next to test: %d %s</b>' % (i + 1, names\[i\]\[7:\])) if i < len(names) else '<b>All tested.</b>'\nme\['result'\].setValue('<br>'.join(\['Builds (nothing rendered):'\] + lines) + '<br><br>' + me\['log'\].value() + nxt)\n" +STARTLINE}
 addUserKnob {22 test_next l "Test next" T "import nuke\nnames = \['mfdiag_probe_basic', 'mfdiag_probe_float3_param', 'mfdiag_probe_float3_function', 'mfdiag_probe_bool_local', 'mfdiag_probe_loops', 'mfdiag_probe_random_component', 'mfdiag_kernel_modes', 'mfdiag_kernel_facts', 'mfdiag_kernel_surface', 'mfdiag_bounds_a_shell', 'mfdiag_bounds_b_read', 'mfdiag_bounds_c_coord', 'mfdiag_bounds_d_big_numbers', 'mfdiag_bounds_e_axis_loop', 'mfdiag_kernel_bounds', 'mfdiag_kernel_bounce', 'mfdiag_kernel_place', 'mfdiag_kernel_motes', 'mfdiag_kernel_bins', 'mfdiag_kernel_rows', 'mfdiag_kernel_draw', 'mfdiag_info_array_in_function', 'mfdiag_info_one_value_vector', 'mfdiag_info_while_loop', 'mfdiag_info_int_division'\]\nme = nuke.thisNode()\ni = max(int(me\['step'\].value()) - 1, 0)\nif i >= len(names):\n    nuke.message('All %d tested.' % len(names))\nelse:\n    n = nuke.toNode(names\[i\])\n    try:\n        n.sample('rgba.red', 0.5, 0.5)\n    except Exception:\n        pass\n    err = False\n    try:\n        err = n.hasError()\n    except Exception:\n        pass\n    log = me\['log'\].value()\n    log += '%d %s: %s<br>' % (i + 1, names\[i\]\[7:\], 'ERROR' if err else 'ok')\n    me\['log'\].setValue(log)\n    me\['step'\].setValue(i + 2)\n    nxt = ('<b>Next to test: %d %s</b>' % (i + 2, names\[i + 1\]\[7:\])) if i + 1 < len(names) else '<b>All tested.</b>'\n    me\['result'\].setValue(log + nxt)\n"}
 addUserKnob {26 result l "" +STARTLINE T "<b>Next to test: 1 probe_basic</b>"}
 addUserKnob {3 step l "Next step" t "Which node Test next renders next (1 = the first). Set it to carry on after a crash."}
 addUserKnob {1 log +INVISIBLE}
 step 1
 xpos 0
 ypos -320
}
