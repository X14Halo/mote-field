BlinkScript {
 inputs 2
 ProgramGroup 1
 kernelSource "// MoteField: which rows of the bins hold any mote, per tile (the same 96-per-row bit layout, over the bin rows), so\n// drawing a pixel skips the empty ones.\nkernel MFRows : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> bins;\n  Image<eWrite> dst;\n\n  param:\n    float density;\n    int max_motes;\n    float3 box_size;\n    float su;\n  local:\n    int nrows;\n\n  void define() \{\n    defineParam(density, \"density\", 180.0f);\n    defineParam(max_motes, \"max_motes\", 65536);\n    defineParam(box_size, \"box_size\", float3(760.0f, 330.0f, 900.0f));\n    defineParam(su, \"su\", 0.01f);\n  \}\n\n\n  // ---- how many motes: density (Amount already applied) x box volume, capped\n  int mote_count() \{\n    float sx = max(box_size.x * su, 0.02f);\n    float sy = max(box_size.y * su, 0.02f);\n    float sz = max(box_size.z * su, 0.02f);\n    float n = floor(density * ((sx * sy) * sz) + 0.5f);\n    float cap = float(max_motes < 65536 ? max_motes : 65536);\n    return int(clamp(n, 0.0f, cap));\n  \}\n  void init() \{\n    nrows = (mote_count() + 95) / 96;\n  \}\n\n  void process(int2 xy) \{\n    int T = xy.x;\n    int r2 = xy.y;\n    float m0 = 0.0f;\n    float m1 = 0.0f;\n    float m2 = 0.0f;\n    float m3 = 0.0f;\n    for (int c = 0; c < 4; c++) \{\n      int bits = 0;\n      for (int b = 0; b < 24; b++) \{\n        int r1 = r2 * 96 + c * 24 + b;\n        if (r1 >= nrows) \{\n          break;\n        \}\n        float4 w = bins(T, r1);\n        if (w.x != 0.0f || w.y != 0.0f || w.z != 0.0f || w.w != 0.0f) \{\n          bits = bits | (1 << b);\n        \}\n      \}\n      if (c == 0) \{\n        m0 = float(bits);\n      \} else if (c == 1) \{\n        m1 = float(bits);\n      \} else if (c == 2) \{\n        m2 = float(bits);\n      \} else \{\n        m3 = float(bits);\n      \}\n    \}\n    dst() = float4(m0, m1, m2, m3);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable false
 name mfdiag_kernel_rows
 label "20"
 xpos 1820
 ypos 140
}
Constant {
 inputs 0
 channels rgba
 color {0 0 0 0}
 format "2304 8 0 0 2304 8 1 mfdiag_draw_in3_fmt"
 name mfdiag_draw_in3
 xpos 2020
 ypos 40
