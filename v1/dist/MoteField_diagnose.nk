along the view\n  float3 project_cam(float3 P, float3 pos, float3 rr, float3 uu, float3 bb, float th) \{\n    float3 d = P - pos;\n    float x = dot(d, rr);\n    float y = dot(d, uu);\n    float z = -dot(d, bb);\n    float zs = z > 1e-9f ? z : 1e-9f;\n    float tv = th * Hf / Wf;\n    return float3((x / zs / th * 0.5f + 0.5f) * Wf, (y / zs / tv * 0.5f + 0.5f) * Hf, z);\n  \}\n  float3 project_mid(float3 P) \{\n    return project_cam(P, cam_pos, cam_right, cam_up, cam_back, cam_th);\n  \}\n  // the unit direction of the ray through pixel position (px, py)\n  float3 ray_dir(float px, float py) \{\n    float tv = cam_th * Hf / Wf;\n    float3 d = cam_right * ((px / Wf * 2.0f - 1.0f) * cam_th) + cam_up * ((py / Hf * 2.0f - 1.0f) * tv) - cam_back;\n    return unit3(d);\n  \}\n  void init() \{\n    Wf = float(surf.bounds.width());\n    Hf = float(surf.bounds.height());\n  \}\n\n  // one axis of the world position seen at pixel position (px, py), or 1e30 if the pixel isn't a clean surface\n  float coord_of(float sw, float sz, float px, float py, int axis) \{\n    if (sw < 0.5f || sz <= 0.0f) \{\n      return 1e30f;\n    \}\n    float3 P = cam_pos + ray_dir(floor(px) + 0.5f, floor(py) + 0.5f) * sz;\n    return axis == 0 ? P.x : (axis == 1 ? P.y : P.z);\n  \}\n\n  // Blink reads images only in process() or in functions it calls directly, so the loops that read the surface\n  // image are all written out here, over a 160 x 90 grid. The q-th fraction of the samples along each axis is found\n  // by halving the range.\n  void process(int2 xy) \{\n    float mn = 1e30f;\n    float mx = -1e30f;\n    float n = 0.0f;\n    for (int j = 0; j < 90; j++) \{\n      for (int i = 0; i < 160; i++) \{\n        float px = (float(i) + 0.5f) * Wf / 160.0f;\n        float py = (float(j) + 0.5f) * Hf / 90.0f;\n        float4 s = surf(surf.bounds.x1 + int(px), surf.bounds.y1 + int(py));\n        float c = coord_of(s.w, s.z, px, py, 0);\n        if (c < 1e29f) \{\n          mn = min(mn, c);\n      