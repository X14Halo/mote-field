set Nmf_space_bounds [stack 0]
BlinkScript {
 inputs 2
 kernelSource "// MoteField: the extent of the set the camera sees (world, scene units), from clean pixels on a grid of samples:\n// pixel 0 = low corner, pixel 1 = high corner, each the 0.5 / 99.5 percentile along each axis, so a few stray\n// far-away pixels don't stretch it. 'Light only through openings' follows rays out of this box.\nkernel MFBounds : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> surf;\n  Image<eWrite> dst;\n\n  param:\n    float3 cam_pos;\n    float3 cam_right;\n    float3 cam_up;\n    float3 cam_back;\n    float cam_th;\n  local:\n    float Wf;\n    float Hf;\n\n  void define() \{\n    defineParam(cam_pos, \"cam_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(cam_right, \"cam_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(cam_up, \"cam_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(cam_back, \"cam_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(cam_th, \"cam_th\", 0.5f);\n  \}\n\n\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  // ---- the camera: world point -> pixel x, y (Nuke's, y up, pixel centres at .5) and depth along the view\n  float3 project_cam(float3 P, float3 pos, float3 rr, float3 uu, float3 bb, float th) \{\n    float3 d = P - pos;\n    float x = dot(d, rr);\n    float y = dot(d, uu);\n    float z = -dot(d, bb);\n    float zs = z > 1e-9f ? z : 1e-9f;\n    float tv = th * Hf / Wf;\n    return float3((x / zs / th * 0.5f + 0.5f) * Wf, (y / zs / tv * 0.5f + 0.5f) * Hf, z);\n  \}\n  float3 project_mid(float3 P) \{\n    return project_cam(P, cam_pos, cam_right, cam_up, cam_back, cam_th);\n  \}\n  // the unit direction of the ray through pixel position (px, py)\n  float3 ray_dir(float px, float py) \{\n    float tv = cam_th * Hf / Wf;\n    float3 d = cam_right * ((px / Wf * 2.0f - 1.0f) * cam_th) + cam_up * ((py / Hf * 2.0f - 1.0f) * tv) - cam_back;\n    return unit3(d);\n  \}\n  void init() \{\n    Wf = float(surf.bounds.width());\n    Hf = float(surf.bounds.height());\n  \}\n\n  float coord(float3 P, int axis) \{\n    return axis == 0 ? P.x : (axis == 1 ? P.y : P.z);\n  \}\n\n  void process(int2 xy) \{\n    int gx = 160;\n    int gy = 90;\n    float lo3\[3\];\n    float hi3\[3\];\n    for (int axis = 0; axis < 3; axis++) \{\n      float mn = 1e30f;\n      float mx = -1e30f;\n      float n = 0.0f;\n      for (int j = 0; j < gy; j++) \{\n        for (int i = 0; i < gx; i++) \{\n          float px = (float(i) + 0.5f) * Wf / float(gx);\n          float py = (float(j) + 0.5f) * Hf / float(gy);\n          float4 s = surf(surf.bounds.x1 + int(px), surf.bounds.y1 + int(py));\n          if (s.w < 0.5f || s.z <= 0.0f) \{\n            continue;\n          \}\n          float c = coord(cam_pos + ray_dir(floor(px) + 0.5f, floor(py) + 0.5f) * s.z, axis);\n          mn = min(mn, c);\n          mx = max(mx, c);\n          n += 1.0f;\n        \}\n      \}\n      if (n < 1.0f) \{\n        lo3\[axis\] = 0.0f;\n        hi3\[axis\] = 0.0f;\n        continue;\n      \}\n      float hist\[256\];\n      for (int b = 0; b < 256; b++) \{\n        hist\[b\] = 0.0f;\n      \}\n      float span = max(mx - mn, 1e-6f);\n      for (int j = 0; j < gy; j++) \{\n        for (int i = 0; i < gx; i++) \{\n          float px = (float(i) + 0.5f) * Wf / float(gx);\n          float py = (float(j) + 0.5f) * Hf / float(gy);\n          float4 s = surf(surf.bounds.x1 + int(px), surf.bounds.y1 + int(py));\n          if (s.w < 0.5f || s.z <= 0.0f) \{\n            continue;\n          \}\n          float c = coord(cam_pos + ray_dir(floor(px) + 0.5f, floor(py) + 0.5f) * s.z, axis);\n          int b = clampi(int((c - mn) / span * 256.0f), 0, 255);\n          hist\[b\] += 1.0f;\n        \}\n      \}\n      float acc = 0.0f;\n      float lo = mn;\n      float hi = mx;\n      bool found_lo = false;\n      for (int b = 0; b < 256; b++) \{\n        acc += hist\[b\];\n        if (!found_lo && acc >= 0.005f * n) \{\n          lo = mn + span * float(b) / 256.0f;\n          found_lo = true;\n        \}\n        if (acc >= 0.995f * n) \{\n          hi = mn + span * float(b + 1) / 256.0f;\n          break;\n        \}\n      \}\n      lo3\[axis\] = lo;\n      hi3\[axis\] = hi;\n    \}\n    if (xy.x == 0) \{\n      dst() = float4(lo3\[0\], lo3\[1\], lo3\[2\], 1.0f);\n    \} else \{\n      dst() = float4(hi3\[0\], hi3\[1\], hi3\[2\], 1.0f);\n    \}\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
