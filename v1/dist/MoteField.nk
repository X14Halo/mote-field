BlinkScript {
 inputs 1
 kernelSource "// MoteField: the swirling air. Random Fourier modes from the seed only: 40 large eddies (rows 0-39) and 20 small\n// ones (rows 40-59). Pixel 0 = wave vector K for a 1 m eddy (xyz) and phase; pixel 1 = amplitude (xyz, at right\n// angles to K) and angular speed for a 1 m eddy. Mirrors rng.mode_table in the Python reference.\nkernel MFModes : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eWrite> dst;\n\n  param:\n    int seed;\n  void define() \{\n    defineParam(seed, \"seed\", 1);\n  \}\n\n\n  // ---- the hash: PCG on 32-bit words, kept as two 16-bit halves (x = high, y = low) so no int ever overflows.\n  // The same bits come out on every CPU and GPU, and they match the Python reference (motefield/rng.py).\n  int2 u_add(int2 a, int2 b) \{\n    int lo = a.y + b.y;\n    return int2((a.x + b.x + (lo >> 16)) & 65535, lo & 65535);\n  \}\n  int mul_lo16(int a, int b) \{\n    return (a * (b & 255) + (((a * (b >> 8)) & 255) << 8)) & 65535;\n  \}\n  int2 u_mul(int2 a, int2 b) \{\n    int p0 = a.y * (b.y & 255);\n    int p1 = a.y * (b.y >> 8);\n    int t = p0 + ((p1 & 255) << 8);\n    int carry = (t >> 16) + (p1 >> 8);\n    return int2((carry + mul_lo16(a.x, b.y) + mul_lo16(a.y, b.x)) & 65535, t & 65535);\n  \}\n  int2 u_xor(int2 a, int2 b) \{\n    return int2(a.x ^ b.x, a.y ^ b.y);\n  \}\n  int2 u_shr(int2 a, int k) \{\n    if (k >= 16) \{\n      return int2(0, a.x >> (k - 16));\n    \}\n    return int2(a.x >> k, ((a.y >> k) | (a.x << (16 - k))) & 65535);\n  \}\n  int2 pcg(int2 v) \{\n    int2 s = u_add(u_mul(v, int2(11410, 30645)), int2(44118, 19205));\n    int2 w = u_mul(u_xor(u_shr(s, (s.x >> 12) + 4), s), int2(4238, 62169));\n    return u_xor(u_shr(w, 22), w);\n  \}\n  int2 word(int v) \{\n    return int2((v >> 16) & 65535, v & 65535);\n  \}\n  int2 hash1(int2 a) \{\n    return pcg(a);\n  \}\n  int2 hash_more(int2 h, int2 w) \{\n    return pcg(u_add(h, w));\n  \}\n  float u01(int2 h) \{\n    return float((h.x << 8) | (h.y >> 8)) * (1.0f / 16777216.0f);\n  \}\n  float gauss12(int2 hb, int i0) \{\n    int2 b = hash_more(hb, word(i0));\n    float s = 0.0f;\n    for (int i = 0; i < 12; i++) \{\n      s += u01(hash_more(b, word(i)));\n    \}\n    return s - 6.0f;\n  \}\n\n  void process(int2 pos) \{\n    int m = pos.y;\n    if (m >= 60) \{\n      dst() = float4(0.0f);\n      return;\n    \}\n    int which = m < 40 ? 0 : 1;\n    int mm = which == 0 ? m : m - 40;\n    float count = which == 0 ? 40.0f : 20.0f;\n    float amp = sqrt(6.0f / count);\n    float two_pi = 6.28318530717959f;\n    int2 hb = hash_more(hash_more(hash1(word(seed)), int2(19791, 17477)), word(which * 1024 + mm));\n    // direction: a point inside the unit ball, normalised\n    float vx = 0.0f;\n    float vy = 0.0f;\n    float vz = 1.0f;\n    float r2 = 1.0f;\n    for (int attempt = 0; attempt < 64; attempt++) \{\n      vx = u01(hash_more(hb, word(attempt * 3))) * 2.0f - 1.0f;\n      vy = u01(hash_more(hb, word(attempt * 3 + 1))) * 2.0f - 1.0f;\n      vz = u01(hash_more(hb, word(attempt * 3 + 2))) * 2.0f - 1.0f;\n      r2 = (vx * vx + vy * vy) + vz * vz;\n      if (r2 > 1e-6f && r2 <= 1.0f) \{\n        break;\n      \}\n    \}\n    float r = sqrt(r2);\n    float kx = vx / r;\n    float ky = vy / r;\n    float kz = vz / r;\n    float kmag = two_pi * exp(0.35f * gauss12(hb, 200));\n    // amplitude: a random vector with its part along k taken out\n    float ax = 0.0f;\n    float ay = 0.0f;\n    float az = 0.0f;\n    float al = 1.0f;\n    for (int attempt = 0; attempt < 64; attempt++) \{\n      ax = gauss12(hb, 300 + attempt * 3);\n      ay = gauss12(hb, 300 + attempt * 3 + 1);\n      az = gauss12(hb, 300 + attempt * 3 + 2);\n      float d = (ax * kx + ay * ky) + az * kz;\n      ax = ax - kx * d;\n      ay = ay - ky * d;\n      az = az - kz * d;\n      al = sqrt((ax * ax + ay * ay) + az * az);\n      if (al > 1e-3f) \{\n        break;\n      \}\n    \}\n    float phase = u01(hash_more(hb, word(400))) * two_pi;\n    float omega = (0.4f + 0.6f * u01(hash_more(hb, word(401)))) * kmag;\n    if (pos.x == 0) \{\n      dst() = float4(kx * kmag, ky * kmag, kz * kmag, phase);\n    \} else \{\n      dst() = float4(ax / al * amp, ay / al * amp, az / al * amp, omega);\n    \}\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name mf_modes
 onCreate "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _mf(_g).link_kernel(_g, 'mf_modes')\nexcept Exception:\n    pass\n"
 xpos 0
 ypos -400
}
