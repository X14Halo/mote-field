Constant {
 inputs 0
 channels rgba
 color {0 0 0 0}
 format "2304 683 0 0 2304 683 1 mf_space_bins_fmt"
 name mf_space_bins
 xpos -200
 ypos 20
}
set Nmf_space_bins [stack 0]
BlinkScript {
 inputs 3
 kernelSource "// MoteField: which motes touch which part of the picture. The picture is cut into 64 x 36 tiles (column = tile);\n// each row holds 96 motes as bits (24 per channel, exact in a float): bit b of channel c in row r = mote r*96 + c*24 + b.\nkernel MFBins : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> motes;\n  Image<eRead, eAccessRandom, eEdgeClamped> surf;\n  Image<eWrite> dst;\n\n  param:\n    float density;\n    int max_motes;\n    float3 box_size;\n    float su;\n  local:\n    int count;\n    int tw;\n    int th;\n\n  void define() \{\n    defineParam(density, \"density\", 180.0f);\n    defineParam(max_motes, \"max_motes\", 65536);\n    defineParam(box_size, \"box_size\", float3(760.0f, 330.0f, 900.0f));\n    defineParam(su, \"su\", 0.01f);\n  \}\n\n\n  // ---- how many motes: density (Amount already applied) x box volume, capped\n  int mote_count() \{\n    float sx = max(box_size.x * su, 0.02f);\n    float sy = max(box_size.y * su, 0.02f);\n    float sz = max(box_size.z * su, 0.02f);\n    float n = floor(density * ((sx * sy) * sz) + 0.5f);\n    float cap = float(max_motes < 65536 ? max_motes : 65536);\n    return int(clamp(n, 0.0f, cap));\n  \}\n  void init() \{\n    count = mote_count();\n    int W = surf.bounds.width();\n    int H = surf.bounds.height();\n    tw = (W + 64 - 1) / 64;\n    th = (H + 36 - 1) / 36;\n  \}\n\n  void process(int2 xy) \{\n    int T = xy.x;\n    int r = xy.y;\n    if (T >= 2304 || r * 96 >= count) \{\n      dst() = float4(0.0f);\n      return;\n    \}\n    int tx = T - (T / 64) * 64;\n    int ty = T / 64;\n    float x0 = float(tx * tw);\n    float y0 = float(ty * th);\n    float x1 = x0 + float(tw);\n    float y1 = y0 + float(th);\n    float m0 = 0.0f;\n    float m1 = 0.0f;\n    float m2 = 0.0f;\n    float m3 = 0.0f;\n    for (int c = 0; c < 4; c++) \{\n      int bits = 0;\n      for (int b = 0; b < 24; b++) \{\n        int i = r * 96 + c * 24 + b;\n        if (i >= count) \{\n          break;\n        \}\n        float4 bb = motes(i - (i / 128) * 128, i / 128);\n        if (bb.x < x1 && bb.z > x0 && bb.y < y1 && bb.w > y0) \{\n          bits = bits | (1 << b);\n        \}\n      \}\n      if (c == 0) \{\n        m0 = float(bits);\n      \} else if (c == 1) \{\n        m1 = float(bits);\n      \} else if (c == 2) \{\n        m2 = float(bits);\n      \} else \{\n        m3 = float(bits);\n      \}\n    \}\n    dst() = float4(m0, m1, m2, m3);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name mf_bins
 onCreate "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _mf(_g).link_kernel(_g, 'mf_bins')\nexcept Exception:\n    pass\n"
 xpos 0
 ypos 20
}
set Nmf_bins [stack 0]
push $Nmf_bins
Constant {
 inputs 0
 channels rgba
 color {0 0 0 0}
 format "2304 8 0 0 2304 8 1 mf_space_rows_fmt"
 name mf_space_rows
 xpos -200
 ypos 80
}
set Nmf_space_rows [stack 0]
BlinkScript {
 inputs 2
 kernelSource "// MoteField: which rows of the bins hold any mote, per tile (the same 96-per-row bit layout, over the bin rows), so\n// drawing a pixel skips the empty ones.\nkernel MFRows : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> bins;\n  Image<eWrite> dst;\n\n  param:\n    float density;\n    int max_motes;\n    float3 box_size;\n    float su;\n  local:\n    int nrows;\n\n  void define() \{\n    defineParam(density, \"density\", 180.0f);\n    defineParam(max_motes, \"max_motes\", 65536);\n    defineParam(box_size, \"box_size\", float3(760.0f, 330.0f, 900.0f));\n    defineParam(su, \"su\", 0.01f);\n  \}\n\n\n  // ---- how many motes: density (Amount already applied) x box volume, capped\n  int mote_count() \{\n    float sx = max(box_size.x * su, 0.02f);\n    float sy = max(box_size.y * su, 0.02f);\n    float sz = max(box_size.z * su, 0.02f);\n    float n = floor(density * ((sx * sy) * sz) + 0.5f);\n    float cap = float(max_motes < 65536 ? max_motes : 65536);\n    return int(clamp(n, 0.0f, cap));\n  \}\n  void init() \{\n    nrows = (mote_count() + 95) / 96;\n  \}\n\n  void process(int2 xy) \{\n    int T = xy.x;\n    int r2 = xy.y;\n    float m0 = 0.0f;\n    float m1 = 0.0f;\n    float m2 = 0.0f;\n    float m3 = 0.0f;\n    for (int c = 0; c < 4; c++) \{\n      int bits = 0;\n      for (int b = 0; b < 24; b++) \{\n        int r1 = r2 * 96 + c * 24 + b;\n        if (r1 >= nrows) \{\n          break;\n        \}\n        float4 w = bins(T, r1);\n        if (w.x != 0.0f || w.y != 0.0f || w.z != 0.0f || w.w != 0.0f) \{\n          bits = bits | (1 << b);\n        \}\n      \}\n      if (c == 0) \{\n        m0 = float(bits);\n      \} else if (c == 1) \{\n        m1 = float(bits);\n      \} else if (c == 2) \{\n        m2 = float(bits);\n      \} else \{\n        m3 = float(bits);\n      \}\n    \}\n    dst() = float4(m0, m1, m2, m3);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name mf_rows
 onCreate "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _mf(_g).link_kernel(_g, 'mf_rows')\nexcept Exception:\n    pass\n"
 xpos 0
 ypos 80
}
set Nmf_rows [stack 0]
push $Nmf_rows
push $Nmf_bins
push $Nmf_motes
push $Nmf_surface
BlinkScript {
 inputs 4
 kernelSource "// MoteField: the picture. Each pixel gathers the motes binned to its tile and adds up their light: small blur as a\n// Gaussian integrated over the pixel (so a mote's light never flickers with where it falls on the pixel grid), larger\n// blur as the lens aperture (blades, anamorphic squeeze, cat-eye, centre/rim brightness) normalised to keep the\n// mote's light, all along its motion-blur streak with the shutter's weighting (mirrors splat.draw in the Python\n// reference). Out: rgb, and alpha as set by the node (none, or a matte from the dust's brightness).\nkernel MFDraw : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessRandom, eEdgeClamped> surf;\n  Image<eRead, eAccessRandom, eEdgeClamped> motes;\n  Image<eRead, eAccessRandom, eEdgeClamped> bins;\n  Image<eRead, eAccessRandom, eEdgeClamped> rows;\n  Image<eWrite> dst;\n\n  param:\n    int blades;\n    int hdr_blades;\n    float anamorphic;\n    float hdr_anamorphic;\n    float bokeh_rot;\n    float bokeh_falloff;\n    int shutter_shape;\n    int alpha_mode;\n    float matte_gain;\n    int held;\n  local:\n    int tw;\n    int th;\n    float lens_blades;\n    float lens_sa;\n    float lens_rot;\n    float sg;\n    float cos_half;\n    float swn\[25\];\n\n  void define() \{\n    defineParam(blades, \"blades\", 0);\n    defineParam(hdr_blades, \"hdr_blades\", 0);\n    defineParam(anamorphic, \"anamorphic\", 0.0f);\n    defineParam(hdr_anamorphic, \"hdr_anamorphic\", 0.0f);\n    defineParam(bokeh_rot, \"bokeh_rot\", 0.0f);\n    defineParam(bokeh_falloff, \"bokeh_falloff\", 0.0f);\n    defineParam(shutter_shape, \"shutter_shape\", 0);\n    defineParam(alpha_mode, \"alpha_mode\", 0);\n    defineParam(matte_gain, \"matte_gain\", 1.0f);\n    defineParam(held, \"held\", 1);\n  \}\n\n\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  float shutter_w(float u) \{\n    return shutter_shape == 0 ? 1.0f / (1.0f + exp(-9.0f * (u - 0.55f))) : 1.0f;\n  \}\n\n  void init() \{\n    int W = surf.bounds.width();\n    int H = surf.bounds.height();\n    tw = (W + 64 - 1) / 64;\n    th = (H + 36 - 1) / 36;\n    lens_blades = float(blades > 0 ? blades : hdr_blades);\n    lens_sa = sqrt(max((hdr_anamorphic > 0.0f ? hdr_anamorphic : 1.0f) + anamorphic, 0.05f));\n    lens_rot = 0.25f + bokeh_rot * 0.0174532925f;\n    sg = lens_blades >= 3.0f ? 6.28318530717959f / lens_blades : 1.0f;\n    cos_half = cos(sg * 0.5f);\n    swn\[0\] = 1.0f;\n    for (int n = 1; n < 25; n++) \{\n      float s = 0.0f;\n      for (int k = 0; k < n; k++) \{\n        s += shutter_w((float(k) + 0.5f) / float(n));\n      \}\n      swn\[n\] = s;\n    \}\n  \}\n\n  // the blur of one sample at offset (dx, dy) from it, radius R px (sums to 1 over the picture)\n  float spot(float dx, float dy, float R, float inv, float cx, float cy) \{\n    if (R < 2.5f) \{\n      float sp = sqrt(0.25f * R * R + 0.12f + 1.0f / 6.0f - 1.0f / 12.0f);\n      float lim = 4.0f * sp + 1.0f;\n      if (fabs(dx) > lim || fabs(dy) > lim) \{\n        return 0.0f;\n      \}\n      float k = 0.707106781f / sp;\n      float gx = 0.5f * (erf_a((dx + 0.5f) * k) - erf_a((dx - 0.5f) * k));\n      float gy = 0.5f * (erf_a((dy + 0.5f) * k) - erf_a((dy - 0.5f) * k));\n      return gx * gy;\n    \}\n    float aa = clamp(1.5f / R, 0.04f, 0.5f);\n    float xa = dx * lens_sa;\n    float ya = dy / lens_sa;\n    float rr = sqrt(xa * xa + ya * ya) / R;\n    if (rr > 1.0f + aa) \{\n      return 0.0f;\n    \}\n    float m = rr;\n    if (lens_blades >= 3.0f) \{\n      float a = atan2(-ya, xa) + lens_rot;\n      float ang = a - sg * floor(a / sg) - sg * 0.5f;\n      m = 0.65f * (rr * cos(ang) / cos_half) + 0.35f * rr;\n    \}\n    float q = m;\n    if (cx != 0.0f || cy != 0.0f) \{\n      float ax = dx / R - cx;\n      float ay = dy / R - cy;\n      float bx = dx / R + cx;\n      float by = dy / R + cy;\n      q = max(q, sqrt(max(ax * ax + ay * ay, bx * bx + by * by)));\n    \}\n    float win = 1.0f - smooth01((q - (1.0f - aa)) / (2.0f * aa));\n    return max(win * (1.0f + bokeh_falloff * (0.5f - m * m)), 0.0f) * inv;\n  \}\n\n  // one mote's light at pixel centre (px, py)\n  float3 mote_light(int i, float px, float py) \{\n    int row = i / 128;\n    int col = i - row * 128;\n    float4 bb = motes(col, row);\n    if (px < bb.x || px > bb.z || py < bb.y || py > bb.w) \{\n      return float3(0.0f);\n    \}\n    float4 en = motes(col + 4 * 128, row);\n    float hold = held == 1 ? en.w : 1.0f;\n    if (hold <= 0.0f) \{\n      return float3(0.0f);\n    \}\n    float4 sk = motes(col + 128, row);\n    float4 rk = motes(col + 2 * 128, row);\n    float4 fc = motes(col + 3 * 128, row);\n    float R = rk.x;\n    int SK = int(rk.y + 0.5f);\n    int K = SK / 32;\n    int S = SK - K * 32;\n    S = clampi(S, 1, 24);\n    K = clampi(K, 1, 24);\n    float bend = rk.z;\n    float total = 0.0f;\n    for (int s = 0; s < S; s++) \{\n      float ts = (float(s) + 0.5f) / float(S);\n      float sw = shutter_w(ts);\n      float bx = sk.x + (sk.z - sk.x) * ts;\n      float by = sk.y + (sk.w - sk.y) * ts;\n      for (int k = 0; k < K; k++) \{\n        float kf = K > 1 ? float(k) / float(K - 1) - 0.5f : 0.0f;\n        float qb = 0.25f - kf * kf;\n        float X = bx + fc.x * kf - fc.y * bend * qb;\n        float Y = by + fc.y * kf + fc.x * bend * qb;\n        total += sw * spot(px - X, py - Y, R, rk.w, fc.z, fc.w);\n      \}\n    \}\n    float f = total * hold / (swn\[S\] * float(K));\n    return float3(en.x * f, en.y * f, en.z * f);\n  \}\n\n  void process(int2 xy) \{\n    int x = xy.x - surf.bounds.x1;\n    int y = xy.y - surf.bounds.y1;\n    float px = float(x) + 0.5f;\n    float py = float(y) + 0.5f;\n    int T = clampi(x / tw, 0, 64 - 1) + clampi(y / th, 0, 36 - 1) * 64;\n    float3 acc = float3(0.0f);\n    for (int r2 = 0; r2 < 8; r2++) \{\n      for (int c2 = 0; c2 < 4; c2++) \{\n        int m2 = int(rows(T, r2, c2));\n        int b2 = 0;\n        while (m2 != 0) \{\n          if ((m2 & 1) != 0) \{\n            int r1 = r2 * 96 + c2 * 24 + b2;\n            for (int c1 = 0; c1 < 4; c1++) \{\n              int m1 = int(bins(T, r1, c1));\n              int b1 = 0;\n              while (m1 != 0) \{\n                if ((m1 & 1) != 0) \{\n                  acc += mote_light(r1 * 96 + c1 * 24 + b1, px, py);\n                \}\n                m1 = m1 >> 1;\n                b1++;\n              \}\n            \}\n          \}\n          m2 = m2 >> 1;\n          b2++;\n        \}\n      \}\n    \}\n    float alpha = 0.0f;\n    if (alpha_mode == 1) \{\n      alpha = clamp((0.2126f * acc.x + 0.7152f * acc.y + 0.0722f * acc.z) * matte_gain, 0.0f, 1.0f);\n    \}\n    dst() = float4(acc.x, acc.y, acc.z, alpha);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name mf_draw
 onCreate "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _mf(_g).link_kernel(_g, 'mf_draw')\nexcept Exception:\n    pass\n"
 xpos 0
 ypos 140
}
set Nmf_draw [stack 0]
Crop {
 box {0 0 {{input.width}} {{input.height}}}
 crop true
 name mf_crop
 xpos 0
 ypos 200
}
set Nmf_crop [stack 0]
push $Nmf_crop
push $Nplate
Merge2 {
 inputs 2
 operation over
 name mf_over
 xpos 200
 ypos 260
}
set Nmf_over [stack 0]
push $Nmf_crop
push $Nplate
Merge2 {
 inputs 2
 operation plus
 name mf_plus
 xpos 400
 ypos 260
}
set Nmf_plus [stack 0]
push $Nmf_plus
push $Nmf_over
push $Nmf_crop
Switch {
 inputs 3
 which {{parent.output_mode}}
 name mf_output
 xpos 0
 ypos 320
}
Output {
 name Output1
 onCreate "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _mf(_g).created(_g)\nexcept Exception:\n    pass\n"
 xpos 0
 ypos 380
}
end_group
