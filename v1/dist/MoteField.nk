set Nmf_space_bounce [stack 0]
BlinkScript {
 inputs 5
 kernelSource "// MoteField: bounce light. The picture is cut into 16 x 9 cells; each cell's sunlit, cleanly seen surfaces become one\n// point light at their light-weighted centre (for a white key light of intensity 1; the motes multiply by the light's\n// colour). Surfaces take the surface colour layer when there is one, else a grey (Set colour).\n// Out: 3 pixels per cell (row = cell): position in metres and weight, normal, flux (rgb).\nkernel MFBounce : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> surf;\n  Image<eRead, eAccessRandom, eEdgeClamped> setbox;\n  Image<eRead, eAccessRandom, eEdgeClamped> nrm;\n  Image<eRead, eAccessRandom, eEdgeClamped> alb;\n  Image<eWrite> dst;\n\n  param:\n    float3 cam_pos;\n    float3 cam_right;\n    float3 cam_up;\n    float3 cam_back;\n    float cam_th;\n    float light_az;\n    float light_el;\n    int shadows;\n    int interior;\n    float shadow_thick;\n    float su;\n    float3 box_center;\n    float3 box_size;\n    float albedo;\n    int use_albedo;\n  local:\n    float Wf;\n    float Hf;\n    float3 Ldir;\n    float vis_t0;\n    float vis_grow;\n    float vis_bias;\n    float vis_thick;\n\n  void define() \{\n    defineParam(cam_pos, \"cam_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(cam_right, \"cam_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(cam_up, \"cam_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(cam_back, \"cam_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(cam_th, \"cam_th\", 0.5f);\n    defineParam(light_az, \"light_az\", 25.0f);\n    defineParam(light_el, \"light_el\", 33.0f);\n    defineParam(shadows, \"shadows\", 0);\n    defineParam(interior, \"interior\", 1);\n    defineParam(shadow_thick, \"shadow_thick\", 60.0f);\n    defineParam(su, \"su\", 0.01f);\n    defineParam(box_center, \"box_center\", float3(-60.0f, 175.0f, -130.0f));\n    defineParam(box_size, \"box_size\", float3(760.0f, 330.0f, 900.0f));\n    defineParam(albedo, \"albedo\", 0.35f);\n    defineParam(use_albedo, \"use_albedo\", 0);\n  \}\n\n\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  // ---- the camera: world point -> pixel x, y (Nuke's, y up, pixel centres at .5) and depth along the view\n  float3 project_cam(float3 P, float3 pos, float3 rr, float3 uu, float3 bb, float th) \{\n    float3 d = P - pos;\n    float x = dot(d, rr);\n    float y = dot(d, uu);\n    float z = -dot(d, bb);\n    float zs = z > 1e-9f ? z : 1e-9f;\n    float tv = th * Hf / Wf;\n    return float3((x / zs / th * 0.5f + 0.5f) * Wf, (y / zs / tv * 0.5f + 0.5f) * Hf, z);\n  \}\n  float3 project_mid(float3 P) \{\n    return project_cam(P, cam_pos, cam_right, cam_up, cam_back, cam_th);\n  \}\n  // the unit direction of the ray through pixel position (px, py)\n  float3 ray_dir(float px, float py) \{\n    float tv = cam_th * Hf / Wf;\n    float3 d = cam_right * ((px / Wf * 2.0f - 1.0f) * cam_th) + cam_up * ((py / Hf * 2.0f - 1.0f) * tv) - cam_back;\n    return unit3(d);\n  \}\n  // ---- the key light\n  float3 kelvin_rgb(float K) \{\n    float t = K / 100.0f;\n    float r = 255.0f;\n    float g = 0.0f;\n    float b = 255.0f;\n    if (t <= 66.0f) \{\n      g = 99.4708025861f * log(t) - 161.1195681661f;\n    \} else \{\n      r = 329.698727446f * pow(t - 60.0f, -0.1332047592f);\n      g = 288.1221695283f * pow(t - 60.0f, -0.0755148492f);\n    \}\n    if (t < 66.0f) \{\n      if (t <= 19.0f) \{\n        b = 0.0f;\n      \} else \{\n        b = 138.5177312231f * log(t - 10.0f) - 305.0447927307f;\n      \}\n    \}\n    float3 c = float3(pow(clamp(r, 0.0f, 255.0f) / 255.0f, 2.2f), pow(clamp(g, 0.0f, 255.0f) / 255.0f, 2.2f),\n                      pow(clamp(b, 0.0f, 255.0f) / 255.0f, 2.2f));\n    return c / (0.2126f * c.x + 0.7152f * c.y + 0.0722f * c.z);\n  \}\n  // unit vector toward a directional light (Y up); heading 0 = the light travels toward +X\n  float3 light_dir(float az, float el) \{\n    float a = az * 0.0174532925f;\n    float e = el * 0.0174532925f;\n    return float3(-cos(a) * cos(e), sin(e), -sin(a) * cos(e));\n  \}\n  // ---- is a point lit by the key light? (mirrors light.visibility in the Python reference)\n  // Occluders: march toward the light through what the camera sees (the surface image); a step that lands behind a\n  // seen surface, by less than the shadow thickness, is in its shadow. Off-screen geometry casts no shadow.\n  // 'Light only through openings': the pass only shows what the camera saw, so light gets in only where the ray,\n  // followed out of the set (lo..hi), leaves through what the camera saw as empty sky.\n  // Needs locals Wf, Hf, Ldir, vis_t0, vis_grow, vis_bias, vis_thick.\n  float vis_at(float3 Q, float3 lo, float3 hi) \{\n    if (shadows == 1) \{\n      return 1.0f;\n    \}\n    float lx = fabs(Ldir.x) < 1e-9f ? 1e-9f : Ldir.x;\n    float ly = fabs(Ldir.y) < 1e-9f ? 1e-9f : Ldir.y;\n    float lz = fabs(Ldir.z) < 1e-9f ? 1e-9f : Ldir.z;\n    float tx = lx > 0.0f ? (hi.x - Q.x) / lx : (lo.x - Q.x) / lx;\n    float ty = ly > 0.0f ? (hi.y - Q.y) / ly : (lo.y - Q.y) / ly;\n    float tz = lz > 0.0f ? (hi.z - Q.z) / lz : (lo.z - Q.z) / lz;\n    float t_exit = max(min(min(tx, ty), tz), 0.0f);\n    float t = vis_t0;\n    for (int j = 0; j < 48; j++) \{\n      if (t > t_exit + vis_t0) \{\n        break;\n      \}\n      float3 X = Q + Ldir * t;\n      float3 p = project_mid(X);\n      if (p.z <= 0.0f || p.x < 0.0f || p.y < 0.0f || p.x >= Wf || p.y >= Hf) \{\n        break;\n      \}\n      float4 s = surf(surf.bounds.x1 + int(p.x), surf.bounds.y1 + int(p.y));\n      if (s.y >= 0.02f && s.z > 0.0f) \{\n        float xd = len3(X - cam_pos);\n        if (xd > s.z * 1.01f + vis_bias && xd < s.z + max(vis_thick, 0.25f * t)) \{\n          return 0.0f;\n        \}\n      \}\n      t = t * vis_grow;\n    \}\n    if (interior != 1) \{\n      return 1.0f;\n    \}\n    float3 E = Q + Ldir * (t_exit + len3(hi - lo) * 0.01f);\n    float3 pe = project_mid(E);\n    if (pe.z <= 0.0f || pe.x < 0.0f || pe.y < 0.0f || pe.x >= Wf || pe.y >= Hf) \{\n      return 0.0f;\n    \}\n    float4 se = surf(surf.bounds.x1 + int(pe.x), surf.bounds.y1 + int(pe.y));\n    return se.y <= 0.02f ? 1.0f : 0.0f;\n  \}\n  void vis_setup() \{\n    Ldir = light_dir(light_az, light_el);\n    vis_t0 = 0.01f / su;\n    vis_grow = pow(6000.0f, 1.0f / 48.0f);\n    vis_bias = 0.02f / su;\n    vis_thick = shadow_thick * 0.01f / su;\n  \}\n  void init() \{\n    Wf = float(surf.bounds.width());\n    Hf = float(surf.bounds.height());\n    vis_setup();\n  \}\n\n  void process(int2 xy) \{\n    int c = xy.y;\n    if (c >= 144) \{\n      dst() = float4(0.0f);\n      return;\n    \}\n    int cx = c - (c / 16) * 16;\n    int cy = c / 16;\n    float cw = Wf / float(16);\n    float ch = Hf / float(9);\n    int ns = 24;\n    float stx = cw / float(ns);\n    float sty = ch / float(ns);\n    float pix = 2.0f * cam_th / Wf * sqrt(stx * sty);\n    float4 b0 = setbox(0, 0);\n    float4 b1 = setbox(1, 0);\n    float3 lo = float3(b0.x, b0.y, b0.z);\n    float3 hi = float3(b1.x, b1.y, b1.z);\n    float3 pacc = float3(0.0f);\n    float3 nacc = float3(0.0f);\n    float3 facc = float3(0.0f);\n    for (int j = 0; j < ns; j++) \{\n      for (int i = 0; i < ns; i++) \{\n        float fx = (float(cx) * cw + (float(i) + 0.5f) * stx);\n        float fy = (float(cy) * ch + (float(j) + 0.5f) * sty);\n        int sx = surf.bounds.x1 + int(fx);\n        int sy = surf.bounds.y1 + int(fy);\n        float4 s = surf(sx, sy);\n        if (s.w < 0.5f || s.z <= 0.0f) \{\n          continue;\n        \}\n        float3 dir = ray_dir(float(sx - surf.bounds.x1) + 0.5f, float(sy - surf.bounds.y1) + 0.5f);\n        float3 P = cam_pos + dir * s.z;\n        float4 nn = nrm(sx, sy);\n        float3 N = float3(nn.x, nn.y, nn.z);\n        if (dot(N, N) < 1e-12f) \{\n          N = cam_pos - P;\n        \}\n        N = unit3(N);\n        float nl = dot(N, Ldir);\n        if (nl <= 0.0f) \{\n          continue;\n        \}\n        float v = vis_at(P + N * (0.02f / su), lo, hi);\n        if (v <= 0.0f) \{\n          continue;\n        \}\n        float dist_m = s.z * su;\n        float cosv = fabs(dot(dir, N));\n        float area = (dist_m * pix) * (dist_m * pix) / max(cosv, 0.2f);\n        float3 col = float3(albedo);\n        if (use_albedo == 1) \{\n          float4 a = alb(sx, sy);\n          col = float3(clamp(a.x, 0.0f, 1.0f), clamp(a.y, 0.0f, 1.0f), clamp(a.z, 0.0f, 1.0f));\n        \}\n        float3 flux = col * (nl * v * area);\n        float fw = flux.x + flux.y + flux.z;\n        pacc += P * (su * fw);\n        nacc += N * fw;\n        facc += flux;\n      \}\n    \}\n    float wsum = facc.x + facc.y + facc.z;\n    if (xy.x == 0) \{\n      float3 pm = wsum > 0.0f ? pacc / wsum : float3(0.0f);\n      dst() = float4(pm.x, pm.y, pm.z, wsum);\n    \} else if (xy.x == 1) \{\n      float3 nm = unit3(nacc);\n      dst() = float4(nm.x, nm.y, nm.z, 0.0f);\n    \} else \{\n      dst() = float4(facc.x, facc.y, facc.z, 0.0f);\n    \}\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name mf_bounce
 onCreate "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _mf(_g).link_kernel(_g, 'mf_bounce')\nexcept Exception:\n    pass\n"
 xpos 0
 ypos -160
}
set Nmf_bounce [stack 0]
push $Nmf_bounds
push $Nmf_surface
push $Nmf_modes
Constant {
 inputs 0
 channels rgba
 color {0 0 0 0}
 format "256 512 0 0 256 512 1 mf_space_place_fmt"
 name mf_space_place
 xpos -200
 ypos -100
}
set Nmf_space_place [stack 0]
BlinkScript {
 inputs 4
 kernelSource "// MoteField: where every mote is on this frame, worked out straight from the time with no simulation (mirrors\n// motion.DustMotion in the Python reference). Two pixels per mote, 128 apart (mote i: row i / 128, column i % 128):\n//   pixel 0: position (world, scene units) and how much of it shows (box faces, the lens, camera fades; 0 = skip)\n//   pixel 1: velocity (scene units per second of air time) and how much key light reaches it (soft shadows)\nkernel MFPlace : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> modes;\n  Image<eRead, eAccessRandom, eEdgeClamped> surf;\n  Image<eRead, eAccessRandom, eEdgeClamped> setbox;\n  Image<eWrite> dst;\n\n  param:\n    float frame;\n    float first;\n    float fps;\n    float speed;\n    float su;\n    int seed;\n    float density;\n    int max_motes;\n    float3 box_center;\n    float3 box_size;\n    float box_rot;\n    float fade;\n    float3 fade_neg;\n    float3 fade_pos;\n    float flakes;\n    float fibers;\n    float fluff;\n    float size_min;\n    float size_max;\n    float size_bias;\n    float drift;\n    float drift_dir;\n    float eddies;\n    float eddy_size;\n    float micro;\n    float thermal;\n    float lift;\n    float settle;\n    float light_az;\n    float light_el;\n    int shadows;\n    int interior;\n    float shadow_soft;\n    float shadow_thick;\n    float steady;\n    float cam_fade_near;\n    float cam_fade_far;\n    float max_bokeh;\n    float3 cam_pos;\n    float3 cam_right;\n    float3 cam_up;\n    float3 cam_back;\n    float cam_th;\n  local:\n    float Wf;\n    float Hf;\n    float3 Ldir;\n    float vis_t0;\n    float vis_grow;\n    float vis_bias;\n    float vis_thick;\n    int count;\n    float3 bsize;\n    float3 bcenter;\n    float rc;\n    float rs;\n    float3 wind;\n    float t;\n    float spf;\n    float size_e;\n    float size_m;\n    float ae;\n    float am;\n    float3 tap_a;\n    float3 tap_b;\n\n  void define() \{\n    defineParam(frame, \"frame\", 1001.0f);\n    defineParam(first, \"first\", 1001.0f);\n    defineParam(fps, \"fps\", 24.0f);\n    defineParam(speed, \"speed\", 1.0f);\n    defineParam(su, \"su\", 0.01f);\n    defineParam(seed, \"seed\", 1);\n    defineParam(density, \"density\", 180.0f);\n    defineParam(max_motes, \"max_motes\", 65536);\n    defineParam(box_center, \"box_center\", float3(-60.0f, 175.0f, -130.0f));\n    defineParam(box_size, \"box_size\", float3(760.0f, 330.0f, 900.0f));\n    defineParam(box_rot, \"box_rot\", 0.0f);\n    defineParam(fade, \"fade\", 45.0f);\n    defineParam(fade_neg, \"fade_neg\", float3(1.0f, 1.0f, 1.0f));\n    defineParam(fade_pos, \"fade_pos\", float3(1.0f, 1.0f, 1.0f));\n    defineParam(flakes, \"flakes\", 18.0f);\n    defineParam(fibers, \"fibers\", 1.2f);\n    defineParam(fluff, \"fluff\", 0.4f);\n    defineParam(size_min, \"size_min\", 4.0f);\n    defineParam(size_max, \"size_max\", 60.0f);\n    defineParam(size_bias, \"size_bias\", 2.4f);\n    defineParam(drift, \"drift\", 1.2f);\n    defineParam(drift_dir, \"drift_dir\", 200.0f);\n    defineParam(eddies, \"eddies\", 3.0f);\n    defineParam(eddy_size, \"eddy_size\", 1.4f);\n    defineParam(micro, \"micro\", 0.8f);\n    defineParam(thermal, \"thermal\", 1.5f);\n    defineParam(lift, \"lift\", 0.0f);\n    defineParam(settle, \"settle\", 0.5f);\n    defineParam(light_az, \"light_az\", 25.0f);\n    defineParam(light_el, \"light_el\", 33.0f);\n    defineParam(shadows, \"shadows\", 0);\n    defineParam(interior, \"interior\", 1);\n    defineParam(shadow_soft, \"shadow_soft\", 3.0f);\n    defineParam(shadow_thick, \"shadow_thick\", 60.0f);\n    defineParam(steady, \"steady\", 0.0f);\n    defineParam(cam_fade_near, \"cam_fade_near\", 0.0f);\n    defineParam(cam_fade_far, \"cam_fade_far\", 0.0f);\n    defineParam(max_bokeh, \"max_bokeh\", 110.0f);\n    defineParam(cam_pos, \"cam_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(cam_right, \"cam_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(cam_up, \"cam_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(cam_back, \"cam_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(cam_th, \"cam_th\", 0.5f);\n  \}\n\n\n  // ---- the hash: PCG on 32-bit words, kept as two 16-bit halves (x = high, y = low) so no int ever overflows.\n  // The same bits come out on every CPU and GPU, and they match the Python reference (motefield/rng.py).\n  int2 u_add(int2 a, int2 b) \{\n    int lo = a.y + b.y;\n    return int2((a.x + b.x + (lo >> 16)) & 65535, lo & 65535);\n  \}\n  int mul_lo16(int a, int b) \{\n    return (a * (b & 255) + (((a * (b >> 8)) & 255) << 8)) & 65535;\n  \}\n  int2 u_mul(int2 a, int2 b) \{\n    int p0 = a.y * (b.y & 255);\n    int p1 = a.y * (b.y >> 8);\n    int t = p0 + ((p1 & 255) << 8);\n    int carry = (t >> 16) + (p1 >> 8);\n    return int2((carry + mul_lo16(a.x, b.y) + mul_lo16(a.y, b.x)) & 65535, t & 65535);\n  \}\n  int2 u_xor(int2 a, int2 b) \{\n    return int2(a.x ^ b.x, a.y ^ b.y);\n  \}\n  int2 u_shr(int2 a, int k) \{\n    if (k >= 16) \{\n      return int2(0, a.x >> (k - 16));\n    \}\n    return int2(a.x >> k, ((a.y >> k) | (a.x << (16 - k))) & 65535);\n  \}\n  int2 pcg(int2 v) \{\n    int2 s = u_add(u_mul(v, int2(11410, 30645)), int2(44118, 19205));\n    int2 w = u_mul(u_xor(u_shr(s, (s.x >> 12) + 4), s), int2(4238, 62169));\n    return u_xor(u_shr(w, 22), w);\n  \}\n  int2 word(int v) \{\n    return int2((v >> 16) & 65535, v & 65535);\n  \}\n  int2 hash1(int2 a) \{\n    return pcg(a);\n  \}\n  int2 hash_more(int2 h, int2 w) \{\n    return pcg(u_add(h, w));\n  \}\n  float u01(int2 h) \{\n    return float((h.x << 8) | (h.y >> 8)) * (1.0f / 16777216.0f);\n  \}\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  // ---- the camera: world point -> pixel x, y (Nuke's, y up, pixel centres at .5) and depth along the view\n  float3 project_cam(float3 P, float3 pos, float3 rr, float3 uu, float3 bb, float th) \{\n    float3 d = P - pos;\n    float x = dot(d, rr);\n    float y = dot(d, uu);\n    float z = -dot(d, bb);\n    float zs = z > 1e-9f ? z : 1e-9f;\n    float tv = th * Hf / Wf;\n    return float3((x / zs / th * 0.5f + 0.5f) * Wf, (y / zs / tv * 0.5f + 0.5f) * Hf, z);\n  \}\n  float3 project_mid(float3 P) \{\n    return project_cam(P, cam_pos, cam_right, cam_up, cam_back, cam_th);\n  \}\n  // the unit direction of the ray through pixel position (px, py)\n  float3 ray_dir(float px, float py) \{\n    float tv = cam_th * Hf / Wf;\n    float3 d = cam_right * ((px / Wf * 2.0f - 1.0f) * cam_th) + cam_up * ((py / Hf * 2.0f - 1.0f) * tv) - cam_back;\n    return unit3(d);\n  \}\n  // ---- how many motes: density (Amount already applied) x box volume, capped\n  int mote_count() \{\n    float sx = max(box_size.x * su, 0.02f);\n    float sy = max(box_size.y * su, 0.02f);\n    float sz = max(box_size.z * su, 0.02f);\n    float n = floor(density * ((sx * sy) * sz) + 0.5f);\n    float cap = float(max_motes < 65536 ? max_motes : 65536);\n    return int(clamp(n, 0.0f, cap));\n  \}\n  // ---- the key light\n  float3 kelvin_rgb(float K) \{\n    float t = K / 100.0f;\n    float r = 255.0f;\n    float g = 0.0f;\n    float b = 255.0f;\n    if (t <= 66.0f) \{\n      g = 99.4708025861f * log(t) - 161.1195681661f;\n    \} else \{\n      r = 329.698727446f * pow(t - 60.0f, -0.1332047592f);\n      g = 288.1221695283f * pow(t - 60.0f, -0.0755148492f);\n    \}\n    if (t < 66.0f) \{\n      if (t <= 19.0f) \{\n        b = 0.0f;\n      \} else \{\n        b = 138.5177312231f * log(t - 10.0f) - 305.0447927307f;\n      \}\n    \}\n    float3 c = float3(pow(clamp(r, 0.0f, 255.0f) / 255.0f, 2.2f), pow(clamp(g, 0.0f, 255.0f) / 255.0f, 2.2f),\n                      pow(clamp(b, 0.0f, 255.0f) / 255.0f, 2.2f));\n    return c / (0.2126f * c.x + 0.7152f * c.y + 0.0722f * c.z);\n  \}\n  // unit vector toward a directional light (Y up); heading 0 = the light travels toward +X\n  float3 light_dir(float az, float el) \{\n    float a = az * 0.0174532925f;\n    float e = el * 0.0174532925f;\n    return float3(-cos(a) * cos(e), sin(e), -sin(a) * cos(e));\n  \}\n  // ---- is a point lit by the key light? (mirrors light.visibility in the Python reference)\n  // Occluders: march toward the light through what the camera sees (the surface image); a step that lands behind a\n  // seen surface, by less than the shadow thickness, is in its shadow. Off-screen geometry casts no shadow.\n  // 'Light only through openings': the pass only shows what the camera saw, so light gets in only where the ray,\n  // followed out of the set (lo..hi), leaves through what the camera saw as empty sky.\n  // Needs locals Wf, Hf, Ldir, vis_t0, vis_grow, vis_bias, vis_thick.\n  float vis_at(float3 Q, float3 lo, float3 hi) \{\n    if (shadows == 1) \{\n      return 1.0f;\n    \}\n    float lx = fabs(Ldir.x) < 1e-9f ? 1e-9f : Ldir.x;\n    float ly = fabs(Ldir.y) < 1e-9f ? 1e-9f : Ldir.y;\n    float lz = fabs(Ldir.z) < 1e-9f ? 1e-9f : Ldir.z;\n    float tx = lx > 0.0f ? (hi.x - Q.x) / lx : (lo.x - Q.x) / lx;\n    float ty = ly > 0.0f ? (hi.y - Q.y) / ly : (lo.y - Q.y) / ly;\n    float tz = lz > 0.0f ? (hi.z - Q.z) / lz : (lo.z - Q.z) / lz;\n    float t_exit = max(min(min(tx, ty), tz), 0.0f);\n    float t = vis_t0;\n    for (int j = 0; j < 48; j++) \{\n      if (t > t_exit + vis_t0) \{\n        break;\n      \}\n      float3 X = Q + Ldir * t;\n      float3 p = project_mid(X);\n      if (p.z <= 0.0f || p.x < 0.0f || p.y < 0.0f || p.x >= Wf || p.y >= Hf) \{\n        break;\n      \}\n      float4 s = surf(surf.bounds.x1 + int(p.x), surf.bounds.y1 + int(p.y));\n      if (s.y >= 0.02f && s.z > 0.0f) \{\n        float xd = len3(X - cam_pos);\n        if (xd > s.z * 1.01f + vis_bias && xd < s.z + max(vis_thick, 0.25f * t)) \{\n          return 0.0f;\n        \}\n      \}\n      t = t * vis_grow;\n    \}\n    if (interior != 1) \{\n      return 1.0f;\n    \}\n    float3 E = Q + Ldir * (t_exit + len3(hi - lo) * 0.01f);\n    float3 pe = project_mid(E);\n    if (pe.z <= 0.0f || pe.x < 0.0f || pe.y < 0.0f || pe.x >= Wf || pe.y >= Hf) \{\n      return 0.0f;\n    \}\n    float4 se = surf(surf.bounds.x1 + int(pe.x), surf.bounds.y1 + int(pe.y));\n    return se.y <= 0.02f ? 1.0f : 0.0f;\n  \}\n  void vis_setup() \{\n    Ldir = light_dir(light_az, light_el);\n    vis_t0 = 0.01f / su;\n    vis_grow = pow(6000.0f, 1.0f / 48.0f);\n    vis_bias = 0.02f / su;\n    vis_thick = shadow_thick * 0.01f / su;\n  \}\n  // ---- the dust box: local (metres, box axes, centred) <-> world metres\n  float3 to_world(float3 l) \{\n    return float3(rc * l.x + rs * l.z, l.y, -rs * l.x + rc * l.z) + bcenter;\n  \}\n  float3 to_local_dir(float3 d) \{\n    return float3(rc * d.x - rs * d.z, d.y, rs * d.x + rc * d.z);\n  \}\n  float3 wrap_box(float3 l) \{\n    return float3(wrap1(l.x, bsize.x), wrap1(l.y, bsize.y), wrap1(l.z, bsize.z));\n  \}\n  void init() \{\n    Wf = float(surf.bounds.width());\n    Hf = float(surf.bounds.height());\n    count = mote_count();\n    bsize = float3(max(box_size.x * su, 0.02f), max(box_size.y * su, 0.02f), max(box_size.z * su, 0.02f));\n    bcenter = box_center * su;\n    rc = cos(box_rot * 0.0174532925f);\n    rs = sin(box_rot * 0.0174532925f);\n    float dir_a = drift_dir * 0.0174532925f;\n    wind = float3(cos(dir_a) * drift, lift, sin(dir_a) * drift) * 0.01f;\n    t = (frame - first) / fps * speed;\n    spf = speed / fps;\n    vis_setup();\n    size_e = max(eddy_size, 0.05f);\n    size_m = size_e * 0.22f;\n    ae = eddies * 0.01f;\n    am = micro * 0.01f;\n    float3 upv = fabs(Ldir.y) < 0.95f ? float3(0.0f, 1.0f, 0.0f) : float3(1.0f, 0.0f, 0.0f);\n    tap_a = unit3(cross(Ldir, upv));\n    tap_b = cross(Ldir, tap_a);\n  \}\n\n  // the key light reaching P (world, scene units), averaged over a small disc across the light (light.soft_visibility)\n  float soft_vis(float3 P, float radius, float3 lo, float3 hi) \{\n    float v = vis_at(P, lo, hi);\n    if (radius <= 0.0f) \{\n      return v;\n    \}\n    for (int k = 0; k < 5; k++) \{\n      float a = 6.28318530717959f * float(k) / 5.0f + 0.3f;\n      v += vis_at(P + (tap_a * cos(a) + tap_b * sin(a)) * radius, lo, hi);\n    \}\n    return v / 6.0f;\n  \}\n\n  void process(int2 xy) \{\n    int g = xy.x / 128;\n    int i = xy.y * 128 + (xy.x - g * 128);\n    if (i >= count || g >= 2) \{\n      dst() = float4(0.0f);\n      return;\n    \}\n    // ---- the mote's starting state (rng.dust_start): position in the box and its random attributes\n    int2 hb = hash_more(hash_more(hash1(word(seed)), int2(17493, 21332)), word(i));\n    float u0 = u01(pcg(u_add(hb, word(0))));\n    float u1 = u01(pcg(u_add(hb, word(1))));\n    float u2 = u01(pcg(u_add(hb, word(2))));\n    float h0 = u01(pcg(u_add(hb, word(3))));\n    float h1 = u01(pcg(u_add(hb, word(4))));\n    float h2 = u01(pcg(u_add(hb, word(5))));\n    float h3 = u01(pcg(u_add(hb, word(6))));\n    float h4 = u01(pcg(u_add(hb, word(7))));\n    float h5 = u01(pcg(u_add(hb, word(8))));\n    float h6 = u01(pcg(u_add(hb, word(9))));\n    float h7 = u01(pcg(u_add(hb, word(10))));\n    float h8 = u01(pcg(u_add(hb, word(11))));\n    float h9 = u01(pcg(u_add(hb, word(12))));\n    float3 x0 = float3((u0 - 0.5f) * bsize.x, (u1 - 0.5f) * bsize.y, (u2 - 0.5f) * bsize.z);\n    float f_fib = fibers / 100.0f;\n    float f_flf = fluff / 100.0f;\n    float f_flk = flakes / 100.0f;\n    int kind = 0;\n    if (h0 < f_fib) \{\n      kind = 2;\n    \} else if (h0 < f_fib + f_flf) \{\n      kind = 3;\n    \} else if (h0 < (f_fib + f_flf) + f_flk) \{\n      kind = 1;\n    \}\n    float ratio = size_max / max(size_min, 1e-3f);\n    float dgrit = size_min * pow(ratio, pow(h1, size_bias));\n    float qd = dgrit / 50.0f;\n    float st_settle = kind == 0 ? 0.15f + min(qd * qd, 4.0f) : (kind == 1 ? 0.5f : (kind == 2 ? 0.22f : 0.12f));\n    float settle_m = settle * 0.01f * st_settle;\n    float4 b0 = setbox(0, 0);\n    float4 b1 = setbox(1, 0);\n    float3 lo = float3(b0.x, b0.y, b0.z);\n    float3 hi = float3(b1.x, b1.y, b1.z);\n\n    // ---- drift and settling, the eddies and micro-turbulence (exact integrals along the settling path)\n    float3 w0 = to_world(x0);\n    float3 drift_v = float3(wind.x, wind.y - settle_m, wind.z);\n    float3 disp = drift_v * t;\n    float3 vel = drift_v;\n    for (int m = 0; m < 60; m++) \{\n      bool is_micro = m >= 40;\n      float amp = is_micro ? am : ae;\n      if (amp <= 0.0f) \{\n        continue;\n      \}\n      float msize = is_micro ? size_m : size_e;\n      float sweep = is_micro ? am + ae : ae;\n      float4 ma = modes(0, m);\n      float4 mb = modes(1, m);\n      float3 K = float3(ma.x, ma.y, ma.z) / msize;\n      float3 A = float3(mb.x, mb.y, mb.z);\n      float phase0 = dot(w0, K) + ma.w;\n      float omega = mb.w / msize * 0.5f * sweep;\n      float beta = omega - settle_m * K.y;\n      float gain = amp * 0.6f;\n      if (is_micro && kind >= 2) \{\n        gain = gain * 1.6f;\n      \}\n      float hx = beta * t * 0.5f;\n      float sincv = fabs(hx) < 1e-4f ? 1.0f - hx * hx / 6.0f : sin(hx) / hx;\n      disp += A * (t * sin(phase0 + hx) * sincv * gain);\n      vel += A * (sin(phase0 + beta * t) * gain);\n    \}\n    // ---- rising warm air: the light along its drift path, integrated from t = 0 every 0.25 s\n    if (thermal != 0.0f) \{\n      float dt = 0.25f;\n      float tt = clamp(t, -64.0f, 64.0f);\n      int kmax = int(floor(fabs(tt) / dt));\n      float sgn = tt < 0.0f ? -1.0f : 1.0f;\n      float cum = 0.0f;\n      float vprev = vis_at(to_world(wrap_box(x0)) / su, lo, hi);\n      float vnext = vprev;\n      for (int k = 0; k <= kmax; k++) \{\n        float tk = sgn * float(k + 1) * dt;\n        vnext = vis_at(to_world(wrap_box(x0 + to_local_dir(drift_v * tk))) / su, lo, hi);\n        if (k < kmax) \{\n          cum += (vprev + vnext) * 0.5f * dt;\n          vprev = vnext;\n        \}\n      \}\n      float f = (fabs(tt) - float(kmax) * dt) / dt;\n      float rise = sgn * (cum + (vprev + vnext) * 0.5f * dt * f);\n      float now = vprev + (vnext - vprev) * f;\n      disp.y += rise * thermal * 0.01f;\n      vel.y += now * thermal * 0.01f;\n    \}\n    float3 loc = wrap_box(x0 + to_local_dir(disp));\n    float3 P = to_world(loc) / su;\n\n    // ---- how much of it shows: the box faces (Edge softness), right at the lens, the camera fades\n    float3 halfb = bsize * 0.5f;\n    float w = 1.0f;\n    float base = max(fade, 0.0f) * su;\n    for (int ax = 0; ax < 3; ax++) \{\n      float lx = ax == 0 ? loc.x : (ax == 1 ? loc.y : loc.z);\n      float hbx = ax == 0 ? halfb.x : (ax == 1 ? halfb.y : halfb.z);\n      float mneg = ax == 0 ? fade_neg.x : (ax == 1 ? fade_neg.y : fade_neg.z);\n      float mpos = ax == 0 ? fade_pos.x : (ax == 1 ? fade_pos.y : fade_pos.z);\n      float fn = base * max(mneg, 0.0f);\n      float fp = base * max(mpos, 0.0f);\n      if (fn > 1e-9f) \{\n        w *= smooth01((lx + hbx) / fn);\n      \}\n      if (fp > 1e-9f) \{\n        w *= smooth01((hbx - lx) / fp);\n      \}\n    \}\n    float3 dcam = P - cam_pos;\n    float dist = len3(dcam);\n    float zc = -dot(dcam, cam_back);\n    w *= smooth01((zc * su - 0.06f) / 0.24f);\n    if (cam_fade_far > cam_fade_near) \{\n      w *= smooth01((dist - cam_fade_near) / (cam_fade_far - cam_fade_near));\n    \} else if (cam_fade_near > 0.0f && dist < cam_fade_near) \{\n      w = 0.0f;\n    \}\n    float3 pm = project_mid(P);\n    float margin = max_bokeh + 40.0f;\n    if (w <= 1e-4f || zc * su <= 0.05f || pm.x < -margin || pm.x > Wf + margin || pm.y < -margin || pm.y > Hf + margin) \{\n      w = 0.0f;\n    \}\n    if (g == 0) \{\n      dst() = float4(P.x, P.y, P.z, w);\n    \} else \{\n      float3 V = vel / su;\n      float v = w > 0.0f ? soft_vis(P, (shadow_soft + 12.0f * steady) * 0.01f / su, lo, hi) : 0.0f;\n      dst() = float4(V.x, V.y, V.z, v);\n    \}\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name mf_place
 onCreate "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _mf(_g).link_kernel(_g, 'mf_place')\nexcept Exception:\n    pass\n"
 xpos 0
 ypos -100
}
set Nmf_place [stack 0]
push $Nmf_bounce
push $Nmf_surface
push $Nmf_place
Constant {
 inputs 0
 channels rgba
 color {0 0 0 0}
 format "640 512 0 0 640 512 1 mf_space_motes_fmt"
 name mf_space_motes
 xpos -200
 ypos -40
}
set Nmf_space_motes [stack 0]
BlinkScript {
 inputs 4
 kernelSource "// MoteField: what every mote looks like through the lens on this frame (mirrors render._appearance, _draw and\n// _holdout in the Python reference). Five pixels per mote, 128 apart (mote i: row i / 128, column i % 128):\n//   pixel 0: the screen box it touches (x0, y0, x1, y1); empty if it is hidden or off screen\n//   pixel 1: its streak as the shutter opens (x, y) and closes (x, y)\n//   pixel 2: blur radius (px), samples along the streak + 32 x samples along a fibre, fibre bend, 1 / bokeh area\n//   pixel 3: fibre length on screen (dx, dy), cat-eye offset (x, y) as a fraction of the radius\n//   pixel 4: its light (rgb, before holdouts) and how much of it the set does not hide (0..1)\nkernel MFMotes : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> place;\n  Image<eRead, eAccessRandom, eEdgeClamped> surf;\n  Image<eRead, eAccessRandom, eEdgeClamped> cells;\n  Image<eWrite> dst;\n\n  param:\n    float frame;\n    float first;\n    float fps;\n    float speed;\n    float su;\n    int seed;\n    float density;\n    int max_motes;\n    float3 box_center;\n    float3 box_size;\n    float box_rot;\n    float drift;\n    float drift_dir;\n    float lift;\n    float settle;\n    float flakes;\n    float fibers;\n    float fluff;\n    float size_min;\n    float size_max;\n    float size_bias;\n    float flake_scale;\n    float fiber_scale;\n    float fluff_scale;\n    float light_az;\n    float light_el;\n    float light_k;\n    float3 light_rgb;\n    float light_int;\n    float bounce;\n    float brightness;\n    float forward;\n    float shadow_fill;\n    float glint;\n    float tumble;\n    float3 tint;\n    float steady;\n    float cam_fade_near;\n    float cam_fade_far;\n    int holdout;\n    float fg_near;\n    float fg_far;\n    int dof;\n    int mb;\n    float focal;\n    float film;\n    float fstop;\n    float focus;\n    float front_mult;\n    float back_mult;\n    float max_bokeh;\n    int blades;\n    float cateye;\n    float anamorphic;\n    float field_curv;\n    float fstop_full;\n    float bokeh_rot;\n    float bokeh_falloff;\n    float hdr_focal;\n    float hdr_film;\n    float hdr_fstop;\n    float hdr_focus;\n    int hdr_blades;\n    float hdr_cateye;\n    float hdr_anamorphic;\n    float hdr_field_curv;\n    float hdr_fstop_full;\n    float shutter;\n    int shutter_mode;\n    int shutter_shape;\n    float3 cam_pos;\n    float3 cam_right;\n    float3 cam_up;\n    float3 cam_back;\n    float cam_th;\n    float3 o_pos;\n    float3 o_right;\n    float3 o_up;\n    float3 o_back;\n    float o_th;\n    float3 c_pos;\n    float3 c_right;\n    float3 c_up;\n    float3 c_back;\n    float c_th;\n  local:\n    float Wf;\n    float Hf;\n    float3 Ldir;\n    int count;\n    float3 bsize;\n    float3 bcenter;\n    float rc;\n    float rs;\n    float3 wind;\n    float t;\n    float spf;\n    float t_open;\n    float t_close;\n    float3 sun;\n    float lens_focal;\n    float lens_fstop;\n    float lens_film;\n    float focus_m;\n    float lens_blades;\n    float lens_cat;\n    float lens_sa;\n    float lens_fc;\n    float lens_rot;\n    float focal_px;\n\n  void define() \{\n    defineParam(frame, \"frame\", 1001.0f);\n    defineParam(first, \"first\", 1001.0f);\n    defineParam(fps, \"fps\", 24.0f);\n    defineParam(speed, \"speed\", 1.0f);\n    defineParam(su, \"su\", 0.01f);\n    defineParam(seed, \"seed\", 1);\n    defineParam(density, \"density\", 180.0f);\n    defineParam(max_motes, \"max_motes\", 65536);\n    defineParam(box_center, \"box_center\", float3(-60.0f, 175.0f, -130.0f));\n    defineParam(box_size, \"box_size\", float3(760.0f, 330.0f, 900.0f));\n    defineParam(box_rot, \"box_rot\", 0.0f);\n    defineParam(drift, \"drift\", 1.2f);\n    defineParam(drift_dir, \"drift_dir\", 200.0f);\n    defineParam(lift, \"lift\", 0.0f);\n    defineParam(settle, \"settle\", 0.5f);\n    defineParam(flakes, \"flakes\", 18.0f);\n    defineParam(fibers, \"fibers\", 1.2f);\n    defineParam(fluff, \"fluff\", 0.4f);\n    defineParam(size_min, \"size_min\", 4.0f);\n    defineParam(size_max, \"size_max\", 60.0f);\n    defineParam(size_bias, \"size_bias\", 2.4f);\n    defineParam(flake_scale, \"flake_scale\", 1.0f);\n    defineParam(fiber_scale, \"fiber_scale\", 1.0f);\n    defineParam(fluff_scale, \"fluff_scale\", 0.6f);\n    defineParam(light_az, \"light_az\", 25.0f);\n    defineParam(light_el, \"light_el\", 33.0f);\n    defineParam(light_k, \"light_k\", 5000.0f);\n    defineParam(light_rgb, \"light_rgb\", float3(1.0f, 1.0f, 1.0f));\n    defineParam(light_int, \"light_int\", 6.0f);\n    defineParam(bounce, \"bounce\", 1.0f);\n    defineParam(brightness, \"brightness\", 1.0f);\n    defineParam(forward, \"forward\", 0.65f);\n    defineParam(shadow_fill, \"shadow_fill\", 0.35f);\n    defineParam(glint, \"glint\", 0.4f);\n    defineParam(tumble, \"tumble\", 1.0f);\n    defineParam(tint, \"tint\", float3(1.0f, 1.0f, 1.0f));\n    defineParam(steady, \"steady\", 0.0f);\n    defineParam(cam_fade_near, \"cam_fade_near\", 0.0f);\n    defineParam(cam_fade_far, \"cam_fade_far\", 0.0f);\n    defineParam(holdout, \"holdout\", 1);\n    defineParam(fg_near, \"fg_near\", 0.0f);\n    defineParam(fg_far, \"fg_far\", 0.0f);\n    defineParam(dof, \"dof\", 1);\n    defineParam(mb, \"mb\", 1);\n    defineParam(focal, \"focal\", 0.0f);\n    defineParam(film, \"film\", 0.0f);\n    defineParam(fstop, \"fstop\", 0.0f);\n    defineParam(focus, \"focus\", 0.0f);\n    defineParam(front_mult, \"front_mult\", 1.0f);\n    defineParam(back_mult, \"back_mult\", 1.0f);\n    defineParam(max_bokeh, \"max_bokeh\", 110.0f);\n    defineParam(blades, \"blades\", 0);\n    defineParam(cateye, \"cateye\", 0.0f);\n    defineParam(anamorphic, \"anamorphic\", 0.0f);\n    defineParam(field_curv, \"field_curv\", 0.0f);\n    defineParam(fstop_full, \"fstop_full\", 0.0f);\n    defineParam(bokeh_rot, \"bokeh_rot\", 0.0f);\n    defineParam(bokeh_falloff, \"bokeh_falloff\", 0.0f);\n    defineParam(hdr_focal, \"hdr_focal\", 0.0f);\n    defineParam(hdr_film, \"hdr_film\", 0.0f);\n    defineParam(hdr_fstop, \"hdr_fstop\", 0.0f);\n    defineParam(hdr_focus, \"hdr_focus\", 0.0f);\n    defineParam(hdr_blades, \"hdr_blades\", 0);\n    defineParam(hdr_cateye, \"hdr_cateye\", 0.0f);\n    defineParam(hdr_anamorphic, \"hdr_anamorphic\", 0.0f);\n    defineParam(hdr_field_curv, \"hdr_field_curv\", 0.0f);\n    defineParam(hdr_fstop_full, \"hdr_fstop_full\", 0.0f);\n    defineParam(shutter, \"shutter\", 180.0f);\n    defineParam(shutter_mode, \"shutter_mode\", 0);\n    defineParam(shutter_shape, \"shutter_shape\", 0);\n    defineParam(cam_pos, \"cam_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(cam_right, \"cam_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(cam_up, \"cam_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(cam_back, \"cam_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(cam_th, \"cam_th\", 0.5f);\n    defineParam(o_pos, \"o_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(o_right, \"o_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(o_up, \"o_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(o_back, \"o_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(o_th, \"o_th\", 0.5f);\n    defineParam(c_pos, \"c_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(c_right, \"c_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(c_up, \"c_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(c_back, \"c_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(c_th, \"c_th\", 0.5f);\n  \}\n\n\n  // ---- the hash: PCG on 32-bit words, kept as two 16-bit halves (x = high, y = low) so no int ever overflows.\n  // The same bits come out on every CPU and GPU, and they match the Python reference (motefield/rng.py).\n  int2 u_add(int2 a, int2 b) \{\n    int lo = a.y + b.y;\n    return int2((a.x + b.x + (lo >> 16)) & 65535, lo & 65535);\n  \}\n  int mul_lo16(int a, int b) \{\n    return (a * (b & 255) + (((a * (b >> 8)) & 255) << 8)) & 65535;\n  \}\n  int2 u_mul(int2 a, int2 b) \{\n    int p0 = a.y * (b.y & 255);\n    int p1 = a.y * (b.y >> 8);\n    int t = p0 + ((p1 & 255) << 8);\n    int carry = (t >> 16) + (p1 >> 8);\n    return int2((carry + mul_lo16(a.x, b.y) + mul_lo16(a.y, b.x)) & 65535, t & 65535);\n  \}\n  int2 u_xor(int2 a, int2 b) \{\n    return int2(a.x ^ b.x, a.y ^ b.y);\n  \}\n  int2 u_shr(int2 a, int k) \{\n    if (k >= 16) \{\n      return int2(0, a.x >> (k - 16));\n    \}\n    return int2(a.x >> k, ((a.y >> k) | (a.x << (16 - k))) & 65535);\n  \}\n  int2 pcg(int2 v) \{\n    int2 s = u_add(u_mul(v, int2(11410, 30645)), int2(44118, 19205));\n    int2 w = u_mul(u_xor(u_shr(s, (s.x >> 12) + 4), s), int2(4238, 62169));\n    return u_xor(u_shr(w, 22), w);\n  \}\n  int2 word(int v) \{\n    return int2((v >> 16) & 65535, v & 65535);\n  \}\n  int2 hash1(int2 a) \{\n    return pcg(a);\n  \}\n  int2 hash_more(int2 h, int2 w) \{\n    return pcg(u_add(h, w));\n  \}\n  float u01(int2 h) \{\n    return float((h.x << 8) | (h.y >> 8)) * (1.0f / 16777216.0f);\n  \}\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  // ---- the dust box: local (metres, box axes, centred) <-> world metres\n  float3 to_world(float3 l) \{\n    return float3(rc * l.x + rs * l.z, l.y, -rs * l.x + rc * l.z) + bcenter;\n  \}\n  float3 to_local_dir(float3 d) \{\n    return float3(rc * d.x - rs * d.z, d.y, rs * d.x + rc * d.z);\n  \}\n  float3 wrap_box(float3 l) \{\n    return float3(wrap1(l.x, bsize.x), wrap1(l.y, bsize.y), wrap1(l.z, bsize.z));\n  \}\n  // ---- the camera: world point -> pixel x, y (Nuke's, y up, pixel centres at .5) and depth along the view\n  float3 project_cam(float3 P, float3 pos, float3 rr, float3 uu, float3 bb, float th) \{\n    float3 d = P - pos;\n    float x = dot(d, rr);\n    float y = dot(d, uu);\n    float z = -dot(d, bb);\n    float zs = z > 1e-9f ? z : 1e-9f;\n    float tv = th * Hf / Wf;\n    return float3((x / zs / th * 0.5f + 0.5f) * Wf, (y / zs / tv * 0.5f + 0.5f) * Hf, z);\n  \}\n  float3 project_mid(float3 P) \{\n    return project_cam(P, cam_pos, cam_right, cam_up, cam_back, cam_th);\n  \}\n  // the unit direction of the ray through pixel position (px, py)\n  float3 ray_dir(float px, float py) \{\n    float tv = cam_th * Hf / Wf;\n    float3 d = cam_right * ((px / Wf * 2.0f - 1.0f) * cam_th) + cam_up * ((py / Hf * 2.0f - 1.0f) * tv) - cam_back;\n    return unit3(d);\n  \}\n  // ---- how many motes: density (Amount already applied) x box volume, capped\n  int mote_count() \{\n    float sx = max(box_size.x * su, 0.02f);\n    float sy = max(box_size.y * su, 0.02f);\n    float sz = max(box_size.z * su, 0.02f);\n    float n = floor(density * ((sx * sy) * sz) + 0.5f);\n    float cap = float(max_motes < 65536 ? max_motes : 65536);\n    return int(clamp(n, 0.0f, cap));\n  \}\n  // ---- the key light\n  float3 kelvin_rgb(float K) \{\n    float t = K / 100.0f;\n    float r = 255.0f;\n    float g = 0.0f;\n    float b = 255.0f;\n    if (t <= 66.0f) \{\n      g = 99.4708025861f * log(t) - 161.1195681661f;\n    \} else \{\n      r = 329.698727446f * pow(t - 60.0f, -0.1332047592f);\n      g = 288.1221695283f * pow(t - 60.0f, -0.0755148492f);\n    \}\n    if (t < 66.0f) \{\n      if (t <= 19.0f) \{\n        b = 0.0f;\n      \} else \{\n        b = 138.5177312231f * log(t - 10.0f) - 305.0447927307f;\n      \}\n    \}\n    float3 c = float3(pow(clamp(r, 0.0f, 255.0f) / 255.0f, 2.2f), pow(clamp(g, 0.0f, 255.0f) / 255.0f, 2.2f),\n                      pow(clamp(b, 0.0f, 255.0f) / 255.0f, 2.2f));\n    return c / (0.2126f * c.x + 0.7152f * c.y + 0.0722f * c.z);\n  \}\n  // unit vector toward a directional light (Y up); heading 0 = the light travels toward +X\n  float3 light_dir(float az, float el) \{\n    float a = az * 0.0174532925f;\n    float e = el * 0.0174532925f;\n    return float3(-cos(a) * cos(e), sin(e), -sin(a) * cos(e));\n  \}\n  void init() \{\n    Wf = float(surf.bounds.width());\n    Hf = float(surf.bounds.height());\n    count = mote_count();\n    bsize = float3(max(box_size.x * su, 0.02f), max(box_size.y * su, 0.02f), max(box_size.z * su, 0.02f));\n    bcenter = box_center * su;\n    rc = cos(box_rot * 0.0174532925f);\n    rs = sin(box_rot * 0.0174532925f);\n    float dir_a = drift_dir * 0.0174532925f;\n    wind = float3(cos(dir_a) * drift, lift, sin(dir_a) * drift) * 0.01f;\n    t = (frame - first) / fps * speed;\n    spf = speed / fps;\n    Ldir = light_dir(light_az, light_el);\n    float s = mb == 1 ? shutter / 360.0f : 0.0f;\n    t_open = shutter_mode == 0 ? -s : (shutter_mode == 1 ? -0.5f * s : 0.0f);\n    t_close = shutter_mode == 0 ? 0.0f : (shutter_mode == 1 ? 0.5f * s : s);\n    sun = kelvin_rgb(light_k) * light_rgb * light_int;\n    // the lens: the camera's, with the settings on top (0 = from the camera)\n    lens_focal = focal > 0.0f ? focal : (hdr_focal > 0.0f ? hdr_focal : 35.0f);\n    lens_fstop = fstop > 0.0f ? fstop : (hdr_fstop > 0.0f ? hdr_fstop : 4.0f);\n    lens_film = film > 0.0f ? film : (hdr_film > 0.0f ? hdr_film : 2.0f * lens_focal * cam_th);\n    focus_m = (focus > 0.0f ? focus : (hdr_focus > 0.0f ? hdr_focus : 500.0f)) * su;\n    lens_blades = float(blades > 0 ? blades : hdr_blades);\n    float full = fstop_full > 0.0f ? fstop_full : (hdr_fstop_full > 0.0f ? hdr_fstop_full : lens_fstop);\n    lens_cat = max(hdr_cateye + cateye, 0.0f) * min(1.0f, full / max(lens_fstop, 1e-3f));\n    lens_sa = sqrt(max((hdr_anamorphic > 0.0f ? hdr_anamorphic : 1.0f) + anamorphic, 0.05f));\n    lens_fc = hdr_field_curv + field_curv;\n    lens_rot = 0.25f + bokeh_rot * 0.0174532925f;\n    focal_px = Wf / (2.0f * cam_th);\n  \}\n\n  float shutter_w(float u) \{\n    return shutter_shape == 0 ? 1.0f / (1.0f + exp(-9.0f * (u - 0.55f))) : 1.0f;\n  \}\n\n  float3 tumble_axis(float h4, float h5, float h6, float rate, float tt) \{\n    float a = 6.28318530717959f * (h4 + rate * tt);\n    float b = 6.28318530717959f * h5 + 4.1f * rate * tt * (0.5f + h6);\n    return float3(sin(a) * cos(b), cos(a), sin(a) * sin(b));\n  \}\n\n  // the bokeh's area (its kernel sums to 1 / this): integrated around the edge, in pixels\n  float bokeh_area(float R, float cx, float cy) \{\n    float aa = clamp(1.5f / R, 0.04f, 0.5f);\n    float sg = lens_blades >= 3.0f ? 6.28318530717959f / lens_blades : 1.0f;\n    float cc = cx * cx + cy * cy;\n    float sum = 0.0f;\n    for (int k = 0; k < 96; k++) \{\n      float th = (float(k) + 0.5f) * 6.28318530717959f / 96.0f;\n      float ux = cos(th);\n      float uy = sin(th);\n      float sx = ux * lens_sa;\n      float sy = uy / lens_sa;\n      float slen = sqrt(sx * sx + sy * sy);\n      float g = 1.0f;\n      if (lens_blades >= 3.0f) \{\n        float a = atan2(-sy, sx) + lens_rot;\n        float ang = a - sg * floor(a / sg) - sg * 0.5f;\n        g = 0.65f * cos(ang) / cos(sg * 0.5f) + 0.35f;\n      \}\n      float slope = slen * g / R;\n      float rho = 1.0f / slope;\n      if (cc > 0.0f) \{\n        float uc = fabs(ux * cx + uy * cy);\n        float rc2 = R * (-uc + sqrt(max(uc * uc + 1.0f - cc, 0.0f)));\n        rho = min(rho, max(rc2, 0.0f));\n      \}\n      float r2 = rho * rho;\n      sum += r2 * (0.5f + 0.1f * aa * aa) + bokeh_falloff * (0.25f * r2 - slope * slope * r2 * r2 * 0.25f);\n    \}\n    return max(sum * 6.28318530717959f / 96.0f, 1e-6f);\n  \}\n\n  void empty_out(int g) \{\n    if (g == 0) \{\n      dst() = float4(1e9f, 1e9f, -1e9f, -1e9f);\n    \} else \{\n      dst() = float4(0.0f);\n    \}\n  \}\n\n  void process(int2 xy) \{\n    int g = xy.x / 128;\n    int i = xy.y * 128 + (xy.x - g * 128);\n    if (i >= count || g >= 5) \{\n      empty_out(g);\n      return;\n    \}\n    // ---- the mote's starting state (rng.dust_start): position in the box and its random attributes\n    int2 hb = hash_more(hash_more(hash1(word(seed)), int2(17493, 21332)), word(i));\n    float u0 = u01(pcg(u_add(hb, word(0))));\n    float u1 = u01(pcg(u_add(hb, word(1))));\n    float u2 = u01(pcg(u_add(hb, word(2))));\n    float h0 = u01(pcg(u_add(hb, word(3))));\n    float h1 = u01(pcg(u_add(hb, word(4))));\n    float h2 = u01(pcg(u_add(hb, word(5))));\n    float h3 = u01(pcg(u_add(hb, word(6))));\n    float h4 = u01(pcg(u_add(hb, word(7))));\n    float h5 = u01(pcg(u_add(hb, word(8))));\n    float h6 = u01(pcg(u_add(hb, word(9))));\n    float h7 = u01(pcg(u_add(hb, word(10))));\n    float h8 = u01(pcg(u_add(hb, word(11))));\n    float h9 = u01(pcg(u_add(hb, word(12))));\n    float3 x0 = float3((u0 - 0.5f) * bsize.x, (u1 - 0.5f) * bsize.y, (u2 - 0.5f) * bsize.z);\n    float f_fib = fibers / 100.0f;\n    float f_flf = fluff / 100.0f;\n    float f_flk = flakes / 100.0f;\n    int kind = 0;\n    if (h0 < f_fib) \{\n      kind = 2;\n    \} else if (h0 < f_fib + f_flf) \{\n      kind = 3;\n    \} else if (h0 < (f_fib + f_flf) + f_flk) \{\n      kind = 1;\n    \}\n    float ratio = size_max / max(size_min, 1e-3f);\n    float dgrit = size_min * pow(ratio, pow(h1, size_bias));\n    float qd = dgrit / 50.0f;\n    float st_settle = kind == 0 ? 0.15f + min(qd * qd, 4.0f) : (kind == 1 ? 0.5f : (kind == 2 ? 0.22f : 0.12f));\n    float settle_m = settle * 0.01f * st_settle;\n    float4 pp = place(xy.x - g * 128, xy.y);\n    float4 pv = place(xy.x - g * 128 + 128, xy.y);\n    float w = pp.w;\n    if (w <= 0.0f) \{\n      empty_out(g);\n      return;\n    \}\n    float3 P = float3(pp.x, pp.y, pp.z);\n    float3 V = float3(pv.x, pv.y, pv.z);\n    float v = pv.w;\n    float3 dcam = P - cam_pos;\n    float dist = len3(dcam);\n    float zc = -dot(dcam, cam_back);\n    float3 pm = project_mid(P);\n\n    // ---- how it looks (render._appearance)\n    float dist_m = dist * su;\n    float3 Vd = (cam_pos - P) / dist;\n    float z_m = zc * su;\n    float ppm = focal_px / max(z_m, 1e-3f);\n    float rate = tumble * (kind == 1 ? 0.12f + 0.78f * h3 : (kind == 0 ? 0.1f + 0.6f * h3 : 0.03f + 0.27f * h3));\n    float3 axis = tumble_axis(h4, h5, h6, rate, t);\n    float sigma = 0.0f;\n    float rsz = 0.0f;\n    float gph = forward;\n    float3 tcol = float3(1.0f);\n    float fib_len = 0.0f;\n    if (kind == 0) \{\n      sigma = (dgrit / 40.0f) * (dgrit / 40.0f) * (1.0f + 0.12f * (1.0f - steady) * sin(6.28318530717959f * (rate * t * 1.3f + h7)));\n      rsz = 0.5f * dgrit * 1e-6f * ppm;\n    \} else if (kind == 1) \{\n      float df = 30.0f * pow(8.0f, pow(h1, 2.2f)) * flake_scale;\n      float nl = fabs(dot(axis, Ldir));\n      float nv = fabs(dot(axis, Vd));\n      nl = nl + (0.5f - nl) * steady;\n      nv = nv + (0.5f - nv) * steady;\n      sigma = (df * df / 1600.0f) * (0.4f * nl * (0.25f + 0.75f * nv) + 0.03f);\n      rsz = 0.5f * df * 1e-6f * ppm;\n      gph = forward * 0.85f;\n      tcol = h7 > 0.5f ? float3(1.04f, 1.0f, 0.94f) : float3(0.95f, 0.95f, 0.97f);\n    \} else if (kind == 2) \{\n      float ln = 300.0f * pow(8.0f, pow(h1, 1.8f)) * fiber_scale;\n      float thk = 8.0f + 12.0f * h8;\n      float tl = dot(axis, Ldir);\n      sigma = (ln * thk / 1600.0f) * sqrt(max(1.0f - tl * tl, 0.03f)) * 0.5f;\n      rsz = thk * 1e-6f * ppm;\n      gph = forward * 0.5f;\n      fib_len = ln;\n      if (h9 < 0.4f) \{\n        tcol = float3(0.95f, 0.95f, 0.93f);\n      \} else if (h9 < 0.58f) \{\n        tcol = float3(0.5f, 0.58f, 0.82f);\n      \} else if (h9 < 0.7f) \{\n        tcol = float3(0.85f, 0.45f, 0.42f);\n      \} else if (h9 < 0.84f) \{\n        tcol = float3(0.36f, 0.34f, 0.32f);\n      \} else \{\n        tcol = float3(0.82f, 0.74f, 0.55f);\n      \}\n    \} else \{\n      float dl = 200.0f * pow(6.0f, h1 * h1) * fluff_scale;\n      sigma = (dl * dl / 1600.0f) * 0.07f;\n      rsz = 0.5f * dl * 1e-6f * ppm;\n      gph = forward * 0.45f;\n      tcol = float3(0.9f, 0.9f, 0.93f);\n    \}\n    // the key light: forward scattering (Henyey-Greenstein) and, for flakes, glints\n    float cth = -dot(Ldir, Vd);\n    float hg = (1.0f - gph * gph) / pow(max(1.0f + gph * gph - 2.0f * gph * cth, 1e-4f), 1.5f);\n    float3 key = sun * (v * hg);\n    if (kind == 1 && v > 0.0f && glint * (1.0f - steady) > 0.0f) \{\n      float3 Hh = unit3(Ldir + Vd);\n      float gsum = 0.0f;\n      for (int k = 0; k < 4; k++) \{\n        gsum += shutter_w(float(k) / 3.0f);\n      \}\n      float gl = 0.0f;\n      for (int k = 0; k < 4; k++) \{\n        float tt = t + (t_open + (t_close - t_open) * float(k) / 3.0f) * spf;\n        float gw = shutter_w(float(k) / 3.0f) * 4.0f / gsum;\n        gl += gw * pow(fabs(dot(tumble_axis(h4, h5, h6, rate, tt), Hh)), 90.0f);\n      \}\n      key += sun * (v * gl * 0.25f * 8.0f * glint * (1.0f - steady) * (0.4f + 0.6f * h2));\n    \}\n    // bounce light off the sunlit set (cells worked out for a white light), plus an overall fill from all of it\n    float3 Pm = P * su;\n    float3 tot = float3(0.0f);\n    float3 Ei = float3(0.0f);\n    for (int c = 0; c < 144; c++) \{\n      float4 cp = cells(0, c);\n      if (cp.w <= 0.0f) \{\n        continue;\n      \}\n      float4 cn = cells(1, c);\n      float4 cf = cells(2, c);\n      float3 fl = float3(cf.x, cf.y, cf.z);\n      tot += fl;\n      float3 dv = float3(cp.x, cp.y, cp.z) - Pm;\n      float r2 = dot(dv, dv) + 0.12f;\n      float3 lv = dv / sqrt(r2);\n      Ei += fl * (max(-dot(lv, float3(cn.x, cn.y, cn.z)), 0.0f) / (pi1() * r2));\n    \}\n    Ei += tot * (0.4f / (278.0f * 0.6f));\n    float3 fill = sun * Ei * (bounce * shadow_fill * 1.5f);\n    float3 scale = tint * tcol * (brightness * 0.8f * sigma / (max(dist_m, 0.05f) * max(dist_m, 0.05f)) * (focal_px / 1100.0f) * (focal_px / 1100.0f) * w);\n    float3 E = (key + fill) * scale;\n\n    // ---- through the lens: blur, streak, fibre spread (render._draw)\n    float R = 0.0f;\n    if (dof == 1) \{\n      float hw = Wf * 0.5f;\n      float hh = Hf * 0.5f;\n      float rn2 = ((pm.x - hw) * (pm.x - hw) + (pm.y - hh) * (pm.y - hh)) / (hw * hw + hh * hh);\n      float s1 = focus_m * 1000.0f * max(1.0f + lens_fc * rn2, 0.05f);\n      float s2 = max(z_m, 0.02f) * 1000.0f;\n      float fl = lens_focal;\n      float coc = (fl / lens_fstop) * fl * (s2 - s1) / (s2 * max(s1 - fl, 1.0f)) / lens_film * Wf;\n      R = fabs(coc * (coc < 0.0f ? front_mult : back_mult)) * 0.5f;\n    \}\n    R = clamp(R, 0.25f + 0.5f * steady, max_bokeh);\n    float3 po = project_cam(P + V * (t_open * spf), o_pos, o_right, o_up, o_back, o_th);\n    float3 pc = project_cam(P + V * (t_close * spf), c_pos, c_right, c_up, c_back, c_th);\n    float streak = sqrt((pc.x - po.x) * (pc.x - po.x) + (pc.y - po.y) * (pc.y - po.y));\n    float rsk = kind == 3 ? 0.6f : (kind == 2 ? 0.0f : 0.5f);\n    float Reff = sqrt(R * R + rsk * rsz * rsz);\n    float S = clamp(ceil(streak / max(Reff * 0.6f, 0.6f)), 1.0f, 24.0f);\n    float Kf = 1.0f;\n    float fdx = 0.0f;\n    float fdy = 0.0f;\n    float bend = 0.0f;\n    if (kind == 2) \{\n      float hl = fib_len * 0.5e-6f / su;\n      float3 f0 = project_mid(P - axis * hl);\n      float3 f1 = project_mid(P + axis * hl);\n      fdx = f1.x - f0.x;\n      fdy = f1.y - f0.y;\n      Kf = clamp(ceil(sqrt(fdx * fdx + fdy * fdy) / max(R * 0.7f, 0.7f)), 1.0f, 24.0f);\n      bend = -(h2 - 0.5f) * 0.6f;\n    \}\n    // cat-eye: toward the frame edges the bokeh turns into lemons, pointing away from the centre\n    float hd = sqrt(Wf * Wf + Hf * Hf) * 0.5f;\n    float cx = (pm.x - Wf * 0.5f) / hd * lens_cat * 0.5f;\n    float cy = (pm.y - Hf * 0.5f) / hd * lens_cat * 0.5f;\n    float cl = sqrt(cx * cx + cy * cy);\n    if (cl > 0.95f) \{\n      cx = cx * 0.95f / cl;\n      cy = cy * 0.95f / cl;\n    \}\n\n    // ---- holdout: how much the set hides it, averaged over its blur with Steady (render._holdout)\n    float hold = 1.0f;\n    if (holdout == 1) \{\n      float rr = steady * Reff * 0.7071f;\n      int ntaps = steady > 0.0f ? 5 : 1;\n      float hsum = 0.0f;\n      for (int k = 0; k < ntaps; k++) \{\n        float ox = k == 0 ? 0.0f : (k == 1 || k == 3 ? 1.0f : -1.0f);\n        float oy = k == 0 ? 0.0f : (k <= 2 ? 1.0f : -1.0f);\n        int sx = surf.bounds.x1 + clampi(int(floor(pm.x + ox * rr)), 0, int(Wf) - 1);\n        int sy = surf.bounds.y1 + clampi(int(floor(pm.y + oy * rr)), 0, int(Hf) - 1);\n        float4 s = surf(sx, sy);\n        float occl = s.x > 0.0f ? smooth01(((dist - s.x) / max(s.x, 1e-6f) + 0.01f) / 0.04f) : 0.0f;\n        float fgw = 1.0f;\n        if (fg_far > fg_near) \{\n          fgw = smooth01((s.x - fg_near) / (fg_far - fg_near));\n        \} else if (fg_near > 0.0f) \{\n          fgw = s.x >= fg_near ? 1.0f : 0.0f;\n        \}\n        hsum += 1.0f - occl * fgw * s.y;\n      \}\n      hold = hsum / float(ntaps);\n    \}\n\n    // ---- what the drawing needs\n    if (g == 0) \{\n      float sa = lens_sa > 1.0f ? lens_sa : 1.0f / lens_sa;\n      float ext = Reff < 2.5f ? 4.0f * sqrt(0.25f * Reff * Reff + 0.12f + 1.0f / 6.0f) + 1.0f : Reff * sa * (1.0f + clamp(1.5f / Reff, 0.04f, 0.5f)) + 1.5f;\n      ext += sqrt(fdx * fdx + fdy * fdy) * (0.5f + 0.25f * fabs(bend));\n      float bx0 = min(po.x, pc.x) - ext;\n      float by0 = min(po.y, pc.y) - ext;\n      float bx1 = max(po.x, pc.x) + ext;\n      float by1 = max(po.y, pc.y) + ext;\n      float lum = E.x + E.y + E.z;\n      if (bx1 < 0.0f || by1 < 0.0f || bx0 > Wf || by0 > Hf || !(lum > 0.0f)) \{\n        dst() = float4(1e9f, 1e9f, -1e9f, -1e9f);\n      \} else \{\n        dst() = float4(bx0, by0, bx1, by1);\n      \}\n    \} else if (g == 1) \{\n      dst() = float4(po.x, po.y, pc.x, pc.y);\n    \} else if (g == 2) \{\n      float inv = Reff >= 2.5f ? 1.0f / bokeh_area(Reff, cx, cy) : 0.0f;\n      dst() = float4(Reff, S + 32.0f * Kf, bend, inv);\n    \} else if (g == 3) \{\n      dst() = float4(fdx, fdy, cx, cy);\n    \} else \{\n      dst() = float4(E.x, E.y, E.z, hold);\n    \}\n  \}\n\};\n"
