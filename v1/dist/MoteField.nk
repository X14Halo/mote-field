set cut_paste_input [stack 0]
version 15.0 v1
push 0
push 0
push $cut_paste_input
Group {
 inputs 3
 name MoteField1
 tile_color 0x6b5a3aff
 label "\[value output_mode]"
 note_font "Verdana Bold"
 help "MoteField 1.0.0a1: drifting dust motes for comp, lit and placed from the shot's utility pass (position, depth, normals; the camera from the EXR header), with the lens's defocus and motion blur and holdouts against the set. Plus or over it on the plate. Inputs: utility (the utility pass Read), plate (optional, to judge the look), colour (optional: a pass with a surface colour layer, for bounce light)."
 onCreate "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_n = nuke.thisNode()\ntry:\n    _mf(_n).created(_n)\nexcept Exception:\n    pass\n"
 knobChanged "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_n = nuke.thisNode()\n_k = nuke.thisKnob()\nif _k.name() in ('inputChange', 'showPanel', 'density', 'master_amount', 'box_size', 'units', 'max_motes'):\n    _mf(_n).knob_changed(_n, _k)\n"
 addUserKnob {20 motefield l MoteField}
 addUserKnob {26 mf_status l "" +STARTLINE T "connect the utility pass to the <b>utility</b> input"}
 addUserKnob {22 read_camera l "Read camera" T "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_mf(nuke.thisNode()).button(nuke.thisNode(), 'read_camera')\n" +STARTLINE}
 addUserKnob {22 fit_box l "Fit box" T "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_mf(nuke.thisNode()).button(nuke.thisNode(), 'fit_box')\n"}
 addUserKnob {22 check_shot l "Check shot" T "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_mf(nuke.thisNode()).button(nuke.thisNode(), 'check_shot')\n"}
 addUserKnob {26 div_mote_1 l "<b>Masters</b>"}
 addUserKnob {7 master_amount l Amount t "More or fewer motes and embers. Multiplies Density and Embers per second. (x)" R 0 3}
 master_amount 1
 addUserKnob {7 master_brightness l Brightness t "Brighter or dimmer dust and embers. Multiplies Dust brightness and Ember brightness. Can be keyed to fade. (x)" R 0 3}
 master_brightness 1
 addUserKnob {7 master_air l Air t "Calmer or livelier air. Multiplies drift, eddies, micro-turbulence, rising warm air, tumbling and ember turbulence together. (x)" R 0 3}
 master_air 1
 addUserKnob {7 steady l Steady t "Calms motes that pop or flicker: steadier flakes, no glints, softer shadow edges, a touch of blur on tiny motes, and holdouts averaged over each mote so it slides behind an edge instead of blinking off." R 0 1}
 steady 0
 addUserKnob {26 div_mote_2 l "<b>Key light</b>"}
 addUserKnob {7 light_az l "Light heading" t "Direction the light travels, around the vertical (0 = toward +X, 90 = toward +Z). Easiest to set with Aim light in the viewer. (°)" R -180 180}
 light_az 25
 addUserKnob {7 light_el l "Light elevation" t "Height of the light above the horizon. (°)" R 0 90}
 light_el 33
 addUserKnob {7 light_int l "Light intensity" t "Brightness of the key light." R 0 20}
 light_int 6
 addUserKnob {7 light_k l "Colour temperature" t "Warmth of the key light. (K)" R 2500 10000}
 light_k 5000
 addUserKnob {18 light_rgb l "Light colour" t "Multiplies the colour from the temperature."}
 light_rgb {1 1 1}
 addUserKnob {26 div_mote_3 l "<b>Dust</b>"}
 addUserKnob {7 flakes l Flakes t "Share of motes that are skin and paper flakes, which tumble and glint. (%)" R 0 60}
 flakes 18
 addUserKnob {7 fibers l "Lint fibres" t "Share of motes that are lint fibres, long and slow. (%)" R 0 12}
 fibers 1.2
 addUserKnob {7 fluff l Fluff t "Share of motes that are fluff balls, big, soft and floaty. (%)" R 0 6}
 fluff 0.4
 addUserKnob {7 fade l "Edge softness" t "How far in from each face of the box the dust fades out, so the box never shows. (scene)" R 0 200}
 fade 45
 addUserKnob {26 div_mote_4 l "<b>Output</b>"}
 addUserKnob {4 output_mode l Output t "What the node puts out: the dust alone (to plus or over in your comp), or over / plus the plate on the plate input, to judge it." M {dust "dust over plate" "dust plus plate"}}
 output_mode dust
 addUserKnob {4 alpha_out l Alpha t "none: the dust only adds light, for a plus merge (the comp's alpha is left alone). matte: alpha follows the dust's brightness, for an over merge, so bright motes and embers cover what is behind them." M {none matte}}
 alpha_out none
 addUserKnob {6 holdout l "Depth holdouts" t "Dust behind the set is hidden by it." +STARTLINE}
 holdout true
 addUserKnob {6 dof l Defocus t "Depth of field, matched to the shot camera." +STARTLINE}
 dof true
 addUserKnob {6 mb l "Motion blur" t "Motion blur with the shot shutter." +STARTLINE}
 mb true
 addUserKnob {6 use_gpu l "Use GPU" t "Render on the GPU when there is one (much faster). The dust is the same either way." +STARTLINE}
 use_gpu true
 addUserKnob {26 mf_report l "" +STARTLINE T ""}
 addUserKnob {20 dust_air l "Dust & air"}
 addUserKnob {26 div_dust_1 l "<b>Dust volume</b>"}
 addUserKnob {13 box_center l "Box centre" t "Centre of the box the dust lives in. Easiest to set with Fit box. (scene)"}
 box_center {-60 175 -130}
 addUserKnob {13 box_size l "Box size" t "Width, height and depth of the dust box. (scene)"}
 box_size {760 330 900}
 addUserKnob {7 box_rot l "Box rotate Y" t "Turns the box about the vertical. (°)" R -180 180}
 box_rot 0
 addUserKnob {13 fade_neg l "Edge softness  -X -Y -Z" t "Multiplies the edge softness at the -X, -Y and -Z faces (0 = a hard edge, e.g. on the floor)."}
 fade_neg {1 1 1}
 addUserKnob {13 fade_pos l "Edge softness  +X +Y +Z" t "Multiplies the edge softness at the +X, +Y and +Z faces."}
 fade_pos {1 1 1}
 addUserKnob {26 div_dust_2 l "<b>Dust</b>"}
 addUserKnob {7 density l Density t "Motes per cubic metre (before Amount). (/m³)" R 1 1000}
 density 180
 addUserKnob {3 seed l Seed t "A different arrangement of the same dust."}
 seed 1
 addUserKnob {7 size_min l "Finest grit" t "Diameter of the smallest grit. (µm)" R 1 30}
 size_min 4
 addUserKnob {7 size_max l "Coarsest grit" t "Diameter of the largest grit. (µm)" R 20 300}
 size_max 60
 addUserKnob {7 size_bias l "Fine-grit bias" t "Higher = more of the grit is fine." R 0.5 4}
 size_bias 2.4
 addUserKnob {7 flake_scale l "Flake size" t "Scales the size of flakes. (x)" R 0.3 3}
 flake_scale 1
 addUserKnob {7 fiber_scale l "Fibre length" t "Scales the length of lint fibres. (x)" R 0.3 3}
 fiber_scale 1
 addUserKnob {7 fluff_scale l "Fluff size" t "Scales the size of fluff. (x)" R 0.15 2}
 fluff_scale 0.6
 addUserKnob {3 max_motes l "Max motes" t "A ceiling on the number of motes, whatever the density."}
 max_motes 150000
 addUserKnob {26 div_dust_3 l "<b>Dust look</b>"}
 addUserKnob {7 brightness l "Dust brightness" t "Brightness of the dust (before the Brightness dial). (x)" R 0 4}
 brightness 1
 addUserKnob {7 forward l "Forward scatter" t "How much brighter motes look when you look toward the light, as real dust does." R 0 0.9}
 forward 0.65
 addUserKnob {7 shadow_fill l "Shadow-side fill" t "Light on motes from the room, outside the beam." R 0 2}
 shadow_fill 0.35
 addUserKnob {7 glint l "Flake glints" t "Sparkle of flakes catching the light as they tumble." R 0 1}
 glint 0.4
 addUserKnob {7 tumble l "Tumble rate" t "How fast flakes and fibres turn over. (x)" R 0 3}
 tumble 1
 addUserKnob {18 tint l Tint t "Colours the dust."}
 tint {1 1 1}
 addUserKnob {7 cam_fade_near l "Hidden nearer than" t "Motes nearer the camera than this are hidden (with Fully visible from; both 0 = off). (scene)" R 0 2000}
 cam_fade_near 0
 addUserKnob {7 cam_fade_far l "Fully visible from" t "Motes are at full strength from this distance on. (scene)" R 0 2000}
 cam_fade_far 0
 addUserKnob {26 div_dust_4 l "<b>Air</b>"}
 addUserKnob {7 drift l Drift t "A steady breeze through the room. (cm/s)" R 0 20}
 drift 1.2
 addUserKnob {7 drift_dir l "Drift heading" t "Which way the breeze blows (0 = toward +X, 90 = toward +Z). (°)" R 0 360}
 drift_dir 200
 addUserKnob {7 eddies l Eddies t "Large slow swirls in the air. (cm/s)" R 0 15}
 eddies 3
 addUserKnob {7 eddy_size l "Eddy size" t "Size of the large swirls. (m)" R 0.2 4}
 eddy_size 1.4
 addUserKnob {7 micro l Micro-turbulence t "Small fast jitter in the air. (cm/s)" R 0 5}
 micro 0.8
 addUserKnob {7 thermal l "Rising warm air" t "Air rising where the sun warms it. (cm/s)" R 0 6}
 thermal 1.5
 addUserKnob {7 lift l "Vertical drift" t "A steady upward (or, negative, downward) drift. (cm/s)" R -20 20}
 lift 0
 addUserKnob {7 settle l Settling t "How fast heavier motes sink. (cm/s)" R 0 4}
 settle 0.5
 addUserKnob {7 speed l Speed t "Plays the whole simulation faster or slower. (x)" R 0 3}
 speed 1
 addUserKnob {20 light_lens l "Light & lens"}
 addUserKnob {26 div_ligh_1 l "<b>Light</b>"}
 addUserKnob {7 bounce l "Bounce light" t "Light bounced off the sunlit parts of the set onto motes outside the beam. (x)" R 0 5}
 bounce 1
 addUserKnob {4 shadows l "Shadows from" t "Where shadows on the dust come from: what the utility pass shows of the set, or none (all dust in the light)." M {"utility pass" none}}
 shadows "utility pass"
 addUserKnob {6 interior l "Light only through openings" t "Interiors: light gets in only where the camera saw sky, such as a window." +STARTLINE}
 interior true
 addUserKnob {7 shadow_soft l "Shadow edge softness" t "Width of the soft edge of shadows on the dust. (cm)" R 0 20}
 shadow_soft 3
 addUserKnob {7 shadow_thick l "Shadow thickness" t "How far behind a surface the camera sees it still casts shadow. The pass only shows surfaces from the front, so the node takes them to be about this thick: raise it for heavy walls, lower it if dust behind thin things goes dark. (cm)" R 5 300}
 shadow_thick 60
 addUserKnob {7 albedo l "Set colour" t "How much light the set bounces back onto the dust when the pass has no surface colour layer (0 = black, 1 = white)." R 0 1}
 albedo 0.35
 addUserKnob {26 div_ligh_2 l "<b>Holdouts</b>"}
 addUserKnob {7 fg_near l "No holdout nearer than" t "Surfaces nearer than this never hide dust (with Full holdout beyond; both 0 = off), so a foreground character can be held out in comp with its own matte. (scene)" R 0 2000}
 fg_near 0
 addUserKnob {7 fg_far l "Full holdout beyond" t "Surfaces beyond this hide dust fully. (scene)" R 0 2000}
 fg_far 0
 addUserKnob {26 div_ligh_3 l "<b>Lens (0 = from the camera in the pass)</b>"}
 addUserKnob {7 focal l "Focal length" t "0 = from the camera in the utility pass. (mm)" R 0 200}
 focal 0
 addUserKnob {7 film l "Film back width" t "0 = from the camera in the utility pass. (mm)" R 0 60}
 film 0
 addUserKnob {7 fstop l f-stop t "0 = from the camera in the utility pass." R 0 22}
 fstop 0
 addUserKnob {7 focus l "Focus distance" t "0 = from the camera in the utility pass. (scene)" R 0 5000}
 focus 0
 addUserKnob {7 front_mult l "Front defocus" t "Scales the blur in front of the focus. (x)" R 0 5}
 front_mult 1
 addUserKnob {7 back_mult l "Back defocus" t "Scales the blur behind the focus. (x)" R 0 5}
 back_mult 1
 addUserKnob {26 div_ligh_4 l "<b>Bokeh</b>"}
 addUserKnob {7 max_bokeh l "Largest bokeh" t "Caps the blur of motes right in front of the lens. (px)" R 10 300}
 max_bokeh 110
 addUserKnob {3 blades l "Blade count" t "0 = from the camera; below 3 = round."}
 blades 0
 addUserKnob {7 cateye l Cat-eye t "Lemon-shaped bokeh toward the frame edges (added to the camera's)." R 0 1}
 cateye 0
 addUserKnob {7 anamorphic l "Anamorphic aspect" t "Oval bokeh (added to the camera's)." R -0.5 1.5}
 anamorphic 0
 addUserKnob {7 field_curv l "Field curvature" t "Focus that curves toward the frame edges (added to the camera's)." R -0.5 0.5}
 field_curv 0
 addUserKnob {7 fstop_full l "f-stop full aperture" t "The lens wide open, for cat-eye (0 = from the camera)." R 0 8}
 fstop_full 0
 addUserKnob {7 bokeh_rot l "Bokeh rotation" t "Turns the bokeh shape. (°)" R -180 180}
 bokeh_rot 0
 addUserKnob {7 bokeh_falloff l "Bokeh centre / rim" t "Positive = brighter centre, negative = brighter rim." R -1 1}
 bokeh_falloff 0
 addUserKnob {26 div_ligh_5 l "<b>Shutter</b>"}
 addUserKnob {7 shutter l "Shutter angle" t "How long the shutter is open, in degrees of a frame. (°)" R 0 360}
 shutter 180
 addUserKnob {4 shutter_mode l "Shutter timing" t "When the shutter is open relative to the frame." M {backward centred forward}}
 shutter_mode backward
 addUserKnob {4 shutter_shape l "Shutter shape" t "backwardsShape: opens gradually toward the frame, like the studio cameras. box: fully open throughout." M {backwardsShape box}}
 shutter_shape backwardsShape
 addUserKnob {7 matte_gain l "Matte strength" t "With Alpha set to matte: how quickly alpha rises with brightness. (x)" R 0.1 10}
 matte_gain 1
 addUserKnob {20 shot l Shot}
 addUserKnob {26 div_shot_1 l "<b>Frames and units</b>"}
 addUserKnob {3 first l "First frame" t "First frame of the shot."}
 first 1001
 addUserKnob {3 last l "Last frame" t "Last frame of the shot."}
 last 1048
 addUserKnob {7 fps l "Frame rate" t "Frames per second. (fps)" R 12 60}
 fps 24
 addUserKnob {4 units l "Scene units" t "The units the utility pass positions are in." M {centimetres metres millimetres inches feet}}
 units centimetres
 addUserKnob {26 div_shot_2 l "<b>Layers of the utility pass</b>"}
 addUserKnob {41 layer_pos l Position T mf_pos.in}
 addUserKnob {41 layer_cov l Coverage T mf_pos.in2}
 addUserKnob {41 layer_depth l Depth T mf_depth.in}
 addUserKnob {41 layer_zraw l "Unfiltered depth" T mf_depth.in2}
 addUserKnob {41 layer_nrm l Normals T mf_nrm.in}
 addUserKnob {41 layer_alb l "Surface colour" T mf_alb.in}
 addUserKnob {22 find_layers l "Find layers" T "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_mf(nuke.thisNode()).button(nuke.thisNode(), 'find_layers')\n" +STARTLINE}
 addUserKnob {4 p_premult l "Positions premultiplied" t "Whether the position layer was premultiplied by coverage. auto = worked out from the pass (by reprojecting edge pixels)." M {auto no yes}}
 p_premult auto
 addUserKnob {4 z_kind l "Depth is distance along the view axis" t "auto = worked out by comparing with the positions; no = distance along each pixel's ray." M {auto no yes}}
 z_kind auto
 addUserKnob {4 z_premult l "Depth premultiplied" t "Whether the depth layers were premultiplied by coverage. auto = worked out from the pass." M {auto no yes}}
 z_premult auto
 addUserKnob {26 div_shot_3 l "<b>Camera (read from the pass header)</b>"}
 addUserKnob {13 cam_pos l Position}
 addUserKnob {13 cam_right l Right}
 addUserKnob {13 cam_up l Up}
 addUserKnob {13 cam_back l Back}
 cam_pos {0 150 400}
 cam_right {1 0 0}
 cam_up {0 1 0}
 cam_back {0 0 1}
 addUserKnob {7 cam_th l "tan(half view angle)" R 0 2}
 cam_th 0.5
 addUserKnob {7 hdr_focal l "Focal length (mm)" R 0 100}
 addUserKnob {7 hdr_film l "Film back width (mm)" R 0 100}
 addUserKnob {7 hdr_fstop l f-stop R 0 100}
 addUserKnob {7 hdr_focus l "Focus distance" R 0 100}
 addUserKnob {7 hdr_cateye l Cat-eye R 0 100}
 addUserKnob {7 hdr_anamorphic l "Anamorphic aspect" R 0 100}
 addUserKnob {7 hdr_field_curv l "Field curvature" R 0 100}
 addUserKnob {7 hdr_fstop_full l "Full-aperture f-stop" R 0 100}
 addUserKnob {3 hdr_blades l "Blade count"}
 addUserKnob {22 repair l "Repair node" T "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_mf(nuke.thisNode()).button(nuke.thisNode(), 'repair')\n" +STARTLINE}
 addUserKnob {26 mf_about l "" +STARTLINE T "MoteField 1.0.0a1: dust motes in comp from the utility pass. Nothing to install; it writes no files."}
 addUserKnob {1 mf_cam_src +INVISIBLE}
 mf_cam_src ""
 addUserKnob {6 mf_layers_set +INVISIBLE}
 mf_layers_set false
 addUserKnob {6 mf_shutter_read +INVISIBLE}
 mf_shutter_read false
 addUserKnob {3 mf_use_albedo +INVISIBLE}
 mf_use_albedo 0
 addUserKnob {1 mf_version +INVISIBLE}
 mf_version ""
 addUserKnob {7 mf_t_open +INVISIBLE}
 mf_t_open {{mb?(shutter_mode==0?-shutter/360:shutter_mode==1?-shutter/720:0):0}}
 addUserKnob {7 mf_t_close +INVISIBLE}
 mf_t_close {{mb?(shutter_mode==0?0:shutter_mode==1?shutter/720:shutter/360):0}}
 addUserKnob {1 mf_py +INVISIBLE}
 mf_py "\"\"\"MoteField node helpers: the Python that lives inside the node (in its hidden mf_py knob), so there is nothing to\ninstall. The node runs it from memory; it never writes a file.\n\nWhat it does:\n  * setup        wires the internal nodes and links every kernel setting to the node's knobs (runs when the node is\n                 created or opened, so a script saved by any Nuke version comes back right);\n  * layers       finds the position, normals, depth, coverage and surface colour layers by name;\n  * camera       reads the camera (and lens and shutter) from the pass's EXR header, frame by frame;\n  * fit box      fits the dust box to the set the camera sees;\n  * check        reports what the node found out about the pass.\n\nLINKS and WIRES are filled in by node/build_node.py.\n\"\"\"\nimport json\nimport math\nimport re\n\nimport nuke\n\nVERSION = '1.0.0a1'\nLINKS = \{'mf_modes': \{'seed': 'parent.seed'\}, 'mf_facts': \{'cam_pos': \['parent.cam_pos.x', 'parent.cam_pos.y', 'parent.cam_pos.z'\], 'cam_right': \['parent.cam_right.x', 'parent.cam_right.y', 'parent.cam_right.z'\], 'cam_up': \['parent.cam_up.x', 'parent.cam_up.y', 'parent.cam_up.z'\], 'cam_back': \['parent.cam_back.x', 'parent.cam_back.y', 'parent.cam_back.z'\], 'cam_th': 'parent.cam_th'\}, 'mf_surface': \{'cam_pos': \['parent.cam_pos.x', 'parent.cam_pos.y', 'parent.cam_pos.z'\], 'cam_right': \['parent.cam_right.x', 'parent.cam_right.y', 'parent.cam_right.z'\], 'cam_up': \['parent.cam_up.x', 'parent.cam_up.y', 'parent.cam_up.z'\], 'cam_back': \['parent.cam_back.x', 'parent.cam_back.y', 'parent.cam_back.z'\], 'cam_th': 'parent.cam_th', 'p_premult': 'parent.p_premult-1', 'z_kind': 'parent.z_kind-1', 'z_premult': 'parent.z_premult-1'\}, 'mf_bounds': \{'cam_pos': \['parent.cam_pos.x', 'parent.cam_pos.y', 'parent.cam_pos.z'\], 'cam_right': \['parent.cam_right.x', 'parent.cam_right.y', 'parent.cam_right.z'\], 'cam_up': \['parent.cam_up.x', 'parent.cam_up.y', 'parent.cam_up.z'\], 'cam_back': \['parent.cam_back.x', 'parent.cam_back.y', 'parent.cam_back.z'\], 'cam_th': 'parent.cam_th'\}, 'mf_bounce': \{'cam_pos': \['parent.cam_pos.x', 'parent.cam_pos.y', 'parent.cam_pos.z'\], 'cam_right': \['parent.cam_right.x', 'parent.cam_right.y', 'parent.cam_right.z'\], 'cam_up': \['parent.cam_up.x', 'parent.cam_up.y', 'parent.cam_up.z'\], 'cam_back': \['parent.cam_back.x', 'parent.cam_back.y', 'parent.cam_back.z'\], 'cam_th': 'parent.cam_th', 'light_az': 'parent.light_az', 'light_el': 'parent.light_el', 'shadows': 'parent.shadows', 'interior': 'parent.interior', 'shadow_thick': 'parent.shadow_thick', 'su': 'parent.units==0?0.01:parent.units==1?1:parent.units==2?0.001:parent.units==3?0.0254:0.3048', 'box_center': \['parent.box_center.x', 'parent.box_center.y', 'parent.box_center.z'\], 'box_size': \['parent.box_size.x', 'parent.box_size.y', 'parent.box_size.z'\], 'albedo': 'parent.albedo', 'use_albedo': 'parent.mf_use_albedo'\}, 'mf_place': \{'frame': 'frame', 'first': 'parent.first', 'fps': 'parent.fps', 'speed': 'parent.speed', 'su': 'parent.units==0?0.01:parent.units==1?1:parent.units==2?0.001:parent.units==3?0.0254:0.3048', 'seed': 'parent.seed', 'density': 'parent.density*parent.master_amount', 'max_motes': 'parent.max_motes', 'box_center': \['parent.box_center.x', 'parent.box_center.y', 'parent.box_center.z'\], 'box_size': \['parent.box_size.x', 'parent.box_size.y', 'parent.box_size.z'\], 'box_rot': 'parent.box_rot', 'fade': 'parent.fade', 'fade_neg': \['parent.fade_neg.x', 'parent.fade_neg.y', 'parent.fade_neg.z'\], 'fade_pos': \['parent.fade_pos.x', 'parent.fade_pos.y', 'parent.fade_pos.z'\], 'flakes': 'parent.flakes', 'fibers': 'parent.fibers', 'fluff': 'parent.fluff', 'size_min': 'parent.size_min', 'size_max': 'parent.size_max', 'size_bias': 'parent.size_bias', 'drift': 'parent.drift*parent.master_air', 'drift_dir': 'parent.drift_dir', 'eddies': 'parent.eddies*parent.master_air', 'eddy_size': 'parent.eddy_size', 'micro': 'parent.micro*parent.master_air', 'thermal': 'parent.thermal*parent.master_air', 'lift': 'parent.lift*parent.master_air', 'settle': 'parent.settle', 'light_az': 'parent.light_az', 'light_el': 'parent.light_el', 'shadows': 'parent.shadows', 'interior': 'parent.interior', 'shadow_soft': 'parent.shadow_soft', 'shadow_thick': 'parent.shadow_thick', 'steady': 'parent.steady', 'cam_fade_near': 'parent.cam_fade_near', 'cam_fade_far': 'parent.cam_fade_far', 'max_bokeh': 'parent.max_bokeh', 'cam_pos': \['parent.cam_pos.x', 'parent.cam_pos.y', 'parent.cam_pos.z'\], 'cam_right': \['parent.cam_right.x', 'parent.cam_right.y', 'parent.cam_right.z'\], 'cam_up': \['parent.cam_up.x', 'parent.cam_up.y', 'parent.cam_up.z'\], 'cam_back': \['parent.cam_back.x', 'parent.cam_back.y', 'parent.cam_back.z'\], 'cam_th': 'parent.cam_th'\}, 'mf_motes': \{'frame': 'frame', 'first': 'parent.first', 'fps': 'parent.fps', 'speed': 'parent.speed', 'su': 'parent.units==0?0.01:parent.units==1?1:parent.units==2?0.001:parent.units==3?0.0254:0.3048', 'seed': 'parent.seed', 'density': 'parent.density*parent.master_amount', 'max_motes': 'parent.max_motes', 'box_center': \['parent.box_center.x', 'parent.box_center.y', 'parent.box_center.z'\], 'box_size': \['parent.box_size.x', 'parent.box_size.y', 'parent.box_size.z'\], 'box_rot': 'parent.box_rot', 'drift': 'parent.drift*parent.master_air', 'drift_dir': 'parent.drift_dir', 'lift': 'parent.lift*parent.master_air', 'settle': 'parent.settle', 'flakes': 'parent.flakes', 'fibers': 'parent.fibers', 'fluff': 'parent.fluff', 'size_min': 'parent.size_min', 'size_max': 'parent.size_max', 'size_bias': 'parent.size_bias', 'flake_scale': 'parent.flake_scale', 'fiber_scale': 'parent.fiber_scale', 'fluff_scale': 'parent.fluff_scale', 'light_az': 'parent.light_az', 'light_el': 'parent.light_el', 'light_k': 'parent.light_k', 'light_rgb': \['parent.light_rgb.r', 'parent.light_rgb.g', 'parent.light_rgb.b'\], 'light_int': 'parent.light_int', 'bounce': 'parent.bounce', 'brightness': 'parent.brightness*parent.master_brightness', 'forward': 'parent.forward', 'shadow_fill': 'parent.shadow_fill', 'glint': 'parent.glint', 'tumble': 'parent.tumble*parent.master_air', 'tint': \['parent.tint.r', 'parent.tint.g', 'parent.tint.b'\], 'steady': 'parent.steady', 'cam_fade_near': 'parent.cam_fade_near', 'cam_fade_far': 'parent.cam_fade_far', 'holdout': 'parent.holdout', 'fg_near': 'parent.fg_near', 'fg_far': 'parent.fg_far', 'dof': 'parent.dof', 'mb': 'parent.mb', 'focal': 'parent.focal', 'film': 'parent.film', 'fstop': 'parent.fstop', 'focus': 'parent.focus', 'front_mult': 'parent.front_mult', 'back_mult': 'parent.back_mult', 'max_bokeh': 'parent.max_bokeh', 'blades': 'parent.blades', 'cateye': 'parent.cateye', 'anamorphic': 'parent.anamorphic', 'field_curv': 'parent.field_curv', 'fstop_full': 'parent.fstop_full', 'bokeh_rot': 'parent.bokeh_rot', 'bokeh_falloff': 'parent.bokeh_falloff', 'hdr_focal': 'parent.hdr_focal', 'hdr_film': 'parent.hdr_film', 'hdr_fstop': 'parent.hdr_fstop', 'hdr_focus': 'parent.hdr_focus', 'hdr_blades': 'parent.hdr_blades', 'hdr_cateye': 'parent.hdr_cateye', 'hdr_anamorphic': 'parent.hdr_anamorphic', 'hdr_field_curv': 'parent.hdr_field_curv', 'hdr_fstop_full': 'parent.hdr_fstop_full', 'shutter': 'parent.shutter', 'shutter_mode': 'parent.shutter_mode', 'shutter_shape': 'parent.shutter_shape', 'cam_pos': \['parent.cam_pos.x', 'parent.cam_pos.y', 'parent.cam_pos.z'\], 'cam_right': \['parent.cam_right.x', 'parent.cam_right.y', 'parent.cam_right.z'\], 'cam_up': \['parent.cam_up.x', 'parent.cam_up.y', 'parent.cam_up.z'\], 'cam_back': \['parent.cam_back.x', 'parent.cam_back.y', 'parent.cam_back.z'\], 'cam_th': 'parent.cam_th', 'o_pos': \['parent.cam_pos.x(frame+parent.mf_t_open)', 'parent.cam_pos.y(frame+parent.mf_t_open)', 'parent.cam_pos.z(frame+parent.mf_t_open)'\], 'o_right': \['parent.cam_right.x(frame+parent.mf_t_open)', 'parent.cam_right.y(frame+parent.mf_t_open)', 'parent.cam_right.z(frame+parent.mf_t_open)'\], 'o_up': \['parent.cam_up.x(frame+parent.mf_t_open)', 'parent.cam_up.y(frame+parent.mf_t_open)', 'parent.cam_up.z(frame+parent.mf_t_open)'\], 'o_back': \['parent.cam_back.x(frame+parent.mf_t_open)', 'parent.cam_back.y(frame+parent.mf_t_open)', 'parent.cam_back.z(frame+parent.mf_t_open)'\], 'o_th': 'parent.cam_th(frame+parent.mf_t_open)', 'c_pos': \['parent.cam_pos.x(frame+parent.mf_t_close)', 'parent.cam_pos.y(frame+parent.mf_t_close)', 'parent.cam_pos.z(frame+parent.mf_t_close)'\], 'c_right': \['parent.cam_right.x(frame+parent.mf_t_close)', 'parent.cam_right.y(frame+parent.mf_t_close)', 'parent.cam_right.z(frame+parent.mf_t_close)'\], 'c_up': \['parent.cam_up.x(frame+parent.mf_t_close)', 'parent.cam_up.y(frame+parent.mf_t_close)', 'parent.cam_up.z(frame+parent.mf_t_close)'\], 'c_back': \['parent.cam_back.x(frame+parent.mf_t_close)', 'parent.cam_back.y(frame+parent.mf_t_close)', 'parent.cam_back.z(frame+parent.mf_t_close)'\], 'c_th': 'parent.cam_th(frame+parent.mf_t_close)'\}, 'mf_bins': \{'density': 'parent.density*parent.master_amount', 'max_motes': 'parent.max_motes', 'box_size': \['parent.box_size.x', 'parent.box_size.y', 'parent.box_size.z'\], 'su': 'parent.units==0?0.01:parent.units==1?1:parent.units==2?0.001:parent.units==3?0.0254:0.3048'\}, 'mf_rows': \{'density': 'parent.density*parent.master_amount', 'max_motes': 'parent.max_motes', 'box_size': \['parent.box_size.x', 'parent.box_size.y', 'parent.box_size.z'\], 'su': 'parent.units==0?0.01:parent.units==1?1:parent.units==2?0.001:parent.units==3?0.0254:0.3048'\}, 'mf_draw': \{'blades': 'parent.blades', 'hdr_blades': 'parent.hdr_blades', 'anamorphic': 'parent.anamorphic', 'hdr_anamorphic': 'parent.hdr_anamorphic', 'bokeh_rot': 'parent.bokeh_rot', 'bokeh_falloff': 'parent.bokeh_falloff', 'shutter_shape': 'parent.shutter_shape', 'alpha_mode': 'parent.alpha_out', 'matte_gain': 'parent.matte_gain'\}\}  # kernel node -> \{param: expression or \[expressions per component\]\}\nKERNELS = \{'mf_modes': 'MFModes', 'mf_facts': 'MFFacts', 'mf_surface': 'MFSurface', 'mf_bounds': 'MFBounds', 'mf_bounce': 'MFBounce', 'mf_place': 'MFPlace', 'mf_motes': 'MFMotes', 'mf_bins': 'MFBins', 'mf_rows': 'MFRows', 'mf_draw': 'MFDraw'\}  # kernel node -> kernel name (the prefix of its param knobs)\nWIRES = \{'mf_modes': \['mf_space_modes'\], 'mf_facts': \['mf_space_facts', 'mf_pos', 'mf_depth'\], 'mf_surface': \['mf_pos', 'mf_depth', 'mf_facts'\], 'mf_bounds': \['mf_space_bounds', 'mf_surface'\], 'mf_bounce': \['mf_space_bounce', 'mf_surface', 'mf_bounds', 'mf_nrm', 'mf_alb'\], 'mf_place': \['mf_space_place', 'mf_modes', 'mf_surface', 'mf_bounds'\], 'mf_motes': \['mf_space_motes', 'mf_place', 'mf_surface', 'mf_bounce'\], 'mf_bins': \['mf_space_bins', 'mf_motes', 'mf_surface'\], 'mf_rows': \['mf_space_rows', 'mf_bins'\], 'mf_draw': \['mf_surface', 'mf_motes', 'mf_bins', 'mf_rows'\], 'mf_pos': \['utility'\], 'mf_depth': \['utility'\], 'mf_nrm': \['utility'\], 'mf_alb': \[None\], 'mf_crop': \['mf_draw'\], 'mf_over': \['plate', 'mf_crop'\], 'mf_plus': \['plate', 'mf_crop'\], 'mf_output': \['mf_crop', 'mf_over', 'mf_plus'\]\}  # internal node -> \[input node names\] (None = leave unconnected)\nDEFAULT_BOX = ((-60.0, 175.0, -130.0), (760.0, 330.0, 900.0))\nUNITS = (0.01, 1.0, 0.001, 0.0254, 0.3048)          # metres per scene unit, in the order of the Scene units menu\n\n# layer names each kind of data is found under (lower case, letters and digits only)\nROLES = \{\n    'P': ('pos', 'p', 'pworld', 'position', 'worldposition', 'worldpos', 'pw', 'wp', 'ppass', 'world',\n          'positionworld', 'worldp'),\n    'N': ('normal', 'n', 'nworld', 'normals', 'worldnormal', 'nw', 'normalworld', 'nn', 'worldnormals'),\n    'Z': ('depth', 'z', 'zdepth', 'distance', 'depthfiltered'),\n    'Zraw': ('depthnofilter', 'depthunfiltered', 'nofilterdepth', 'depthraw', 'zraw', 'depthclosest',\n             'closestdepth', 'zunfiltered', 'znofilter', 'depthnearest'),\n    'A': ('alpha', 'implicitalpha', 'coverage', 'alphacoverage'),\n    'C': ('surfacecolor', 'surfacecolour', 'albedo', 'diffusealbedo', 'basecolor', 'diffusecolor', 'surfacealbedo'),\n\}\n\n\ntry:                        # Nuke 12 and older run Python 2, where text can also be unicode\n    _STR = (str, unicode)   # noqa: F821\nexcept NameError:\n    _STR = (str,)\n\n\ndef _norm(s):\n    if not isinstance(s, _STR):\n        s = str(s)\n    return ''.join(ch for ch in s.lower() if ch.isalnum())\n\n\ndef _inner(grp, name):\n    return grp.node(name)\n\n\n# ---------------------------------------------------------------------------------------------------------------------\n#  Setup: wiring and links\n# ---------------------------------------------------------------------------------------------------------------------\ndef wire(grp):\n    \"\"\"Connects every internal node to its inputs by name (the script's own wiring, made certain).\"\"\"\n    for name, inputs in WIRES.items():\n        n = _inner(grp, name)\n        if n is None:\n            continue\n        for i, src in enumerate(inputs):\n            if src is None:\n                continue\n            s = _inner(grp, src)\n            if s is not None and n.input(i) is not s:\n                n.setInput(i, s)\n\n\ndef _param_knob(node, kernel, param):\n    \"\"\"The knob a BlinkScript node made for a kernel param (KernelName_param), or None.\"\"\"\n    k = node.knob(kernel + '_' + param)\n    if k is not None:\n        return k\n    want = (kernel + '_' + param).lower()\n    knobs = node.knobs()\n    for name, k in knobs.items():\n        if name.lower() == want:\n            return k\n    # another naming (a different prefix): the shortest knob name ending in _param that no other param explains\n    ends = sorted((n for n in knobs if n.lower().endswith('_' + param.lower())), key=len)\n    return knobs\[ends\[0\]\] if ends else None\n\n\ndef link_kernel(grp, name):\n    \"\"\"Links one kernel node's params to the node's knobs by expression. Returns the params it could not find.\"\"\"\n    node = _inner(grp, name)\n    if node is None:\n        return \[\]\n    kernel = KERNELS\[name\]\n    missing = \[\]\n    for param, expr in LINKS.get(name, \{\}).items():\n        k = _param_knob(node, kernel, param)\n        if k is None:\n            missing.append(param)\n            continue\n        try:\n            if isinstance(expr, (list, tuple)):\n                for i, e in enumerate(expr):\n                    k.setExpression(e, i)\n            else:\n                k.setExpression(expr)\n        except Exception:\n            missing.append(param)\n    gpu = node.knob('useGPUIfAvailable')\n    if gpu is not None:\n        try:\n            gpu.setExpression('parent.use_gpu')\n        except Exception:\n            pass\n    return missing\n\n\ndef setup(grp):\n    \"\"\"Wires and links everything; returns \{kernel node: \[params not found\]\} for the ones that went wrong.\"\"\"\n    wire(grp)\n    bad = \{\}\n    for name in KERNELS:\n        m = link_kernel(grp, name)\n        if m:\n            bad\[name\] = m\n    k = grp.knob('mf_version')\n    if k is not None and k.value() != VERSION:\n        k.setValue(VERSION)\n    return bad\n\n\n# ---------------------------------------------------------------------------------------------------------------------\n#  Layers\n# ---------------------------------------------------------------------------------------------------------------------\ndef layers_of(node):\n    \"\"\"\{layer: \[channel names\]\} of a node's output, in order.\"\"\"\n    out = \{\}\n    if node is None:\n        return out\n    try:\n        chans = node.channels()\n    except Exception:\n        return out\n    for c in chans:\n        layer, _, chan = c.partition('.')\n        out.setdefault(layer, \[\]).append(chan)\n    return out\n\n\ndef pick_layer(layers, role):\n    \"\"\"The layer for a role, by name (exact names first, then names that end with one).\"\"\"\n    names = ROLES\[role\]\n    by = dict((_norm(l), l) for l in layers)\n    for n in names:\n        if n in by:\n            return by\[n\]\n    for n in names:\n        if len(n) < 3:\n            continue\n        for k, l in by.items():\n            if k.endswith(n):\n                return l\n    return None\n\n\ndef detect_layers(grp, force=False):\n    \"\"\"Points the internal shuffles at the pass's layers. Returns \{role: layer or None\}.\"\"\"\n    util = grp.input(0)\n    col = grp.input(2)\n    lu, lc = layers_of(util), layers_of(col)\n    found = \{\}\n    for role in ('P', 'N', 'Z', 'Zraw', 'A'):\n        found\[role\] = pick_layer(lu, role)\n    if found\['Z'\] is not None and found\['Z'\] == found\['Zraw'\]:\n        found\['Z'\] = None\n    found\['C'\] = pick_layer(lc, 'C') or pick_layer(lu, 'C')\n    if not force and grp.knob('mf_layers_set') is not None and grp\['mf_layers_set'\].value():\n        return found\n    pos, dep, nrm, alb = (_inner(grp, n) for n in ('mf_pos', 'mf_depth', 'mf_nrm', 'mf_alb'))\n    if pos is not None:\n        pos\['in'\].setValue(found\['P'\] or 'none')\n        if found\['A'\] and found\['A'\] != 'rgba':\n            pos\['in2'\].setValue(found\['A'\])\n            pos\['alpha'\].setValue('red2')\n        else:\n            pos\['in2'\].setValue('rgba')\n            pos\['alpha'\].setValue('alpha2')\n    if dep is not None:\n        dep\['in'\].setValue(found\['Z'\] or 'none')\n        dep\['in2'\].setValue(found\['Zraw'\] or 'none')\n    if nrm is not None:\n        nrm\['in'\].setValue(found\['N'\] or 'none')\n    if alb is not None:\n        src = col if (col is not None and pick_layer(lc, 'C')) else util\n        if src is not None:\n            alb.setInput(0, _inner(grp, 'colour' if src is col else 'utility'))\n        alb\['in'\].setValue(found\['C'\] or 'none')\n    grp\['mf_use_albedo'\].setValue(1 if found\['C'\] else 0)\n    if util is not None and grp.knob('mf_layers_set') is not None:\n        grp\['mf_layers_set'\].setValue(True)\n    return found\n\n\n# ---------------------------------------------------------------------------------------------------------------------\n#  The camera from the EXR header (mirrors motefield/camera.py, without numpy)\n# ---------------------------------------------------------------------------------------------------------------------\n_NUM = re.compile(r'-?(?:\\d+\\.?\\d*|\\.\\d+)(?:\[eE\]\[-+\]?\\d+)?')\n\n\ndef _nums(v):\n    if isinstance(v, bool):\n        return \[float(v)\]\n    if isinstance(v, (list, tuple)):\n        out = \[\]\n        for x in v:\n            out += _nums(x)\n        return out\n    if isinstance(v, (int, float)) or type(v).__name__ == 'long':\n        return \[float(v)\]\n    if isinstance(v, _STR):\n        return \[float(x) for x in _NUM.findall(v)\]\n    try:\n        return \[float(x) for x in v\]\n    except Exception:\n        return \[\]\n\n\ndef _flatten_json(prefix, v, out):\n    if isinstance(v, dict):\n        for k, x in v.items():\n            _flatten_json(prefix + '/' + k, x, out)\n    else:\n        out\[prefix\] = v\n\n\ndef header_items(md):\n    \"\"\"(key, value, group) for every metadata entry, then the fields of JSON-valued strings (group = the JSON\n    object's path).\"\"\"\n    plain, nested = \[\], \[\]\n    for k, v in md.items():\n        plain.append((k, v, None))\n        if isinstance(v, _STR) and v\[:1\] == '\{' and len(v) < 2000000:\n            try:\n                d = json.loads(v)\n            except ValueError:\n                continue\n            flat = \{\}\n            _flatten_json(k, d, flat)\n            nested += \[(fk, fv, fk.rsplit('/', 1)\[0\]) for fk, fv in flat.items()\]\n    return plain + nested\n\n\n_LENS = (('fstop_full', ('fstopfullaperture', 'fullaperture', 'fstopfull', 'maxaperture', 'wideopenfstop')),\n         ('cateye', ('cateyebokeh', 'cateye')),\n         ('field_curv', ('fieldcurvature',)),\n         ('anamorphic', ('anamorphicaspect', 'anamorphicsqueeze', 'squeeze', 'anamorphic')),\n         ('blades', ('bladecount', 'numblades', 'blades', 'irisblades')))\n\n\ndef _rank_groups(items, cam):\n    score = \{\}\n    for k, v, g in items:\n        if g is None:\n            continue\n        kn = _norm(k.rsplit('/', 1)\[-1\])\n        vals = _nums(v)\n        s = score.setdefault(g, 0)\n        for field, ends, w in (('fstop', ('fstop',), 1), ('focus', ('focusdistance',), 1),\n                               ('toworld', ('camtoworld', 'cameratoworld'), 2)):\n            if field in cam and any(kn == e for e in ends) and vals:\n                want = cam\[field\] if isinstance(cam\[field\], list) else \[cam\[field\]\]\n                if len(vals) >= len(want) and all(abs(a - b) <= 1e-3 * max(1.0, abs(b)) for a, b in zip(vals, want)):\n                    s += w\n        score\[g\] = s\n    return score\n\n\ndef _match(k, v, nested, cam, src, lens, take):\n    kn = _norm(k.rsplit('/', 1)\[-1\])\n    full = _norm(k)\n    lens_field = None\n    for f, ends in _LENS:\n        if any(kn.endswith(e) for e in ends):\n            lens_field = f\n            break\n    if lens_field:\n        vals = _nums(v)\n        if vals and lens_field not in lens:\n            lens\[lens_field\] = vals\[0\]\n            src\['lens.' + lens_field\] = k\n        return\n    if kn.endswith('camtoworld') or kn.endswith('cameratoworld'):\n        take('toworld', k, v, 16)\n    elif kn.endswith('worldtocamera') or kn.endswith('worldtocam'):\n        take('w2c', k, v, 16)\n    elif nested:\n        if kn in ('shutteropen', 'shutterclose'):\n            take(kn, k, v)\n        return\n    elif 'horizontalfov' in kn or kn in ('fovx', 'hfov'):\n        take('hfov', k, v)\n    elif kn.endswith('focallength'):\n        take('focal', k, v)\n    elif kn.endswith('fstop') or kn.endswith('fnumber'):\n        take('fstop', k, v)\n    elif kn.endswith('focusdistance'):\n        take('focus', k, v)\n    elif any(kn.endswith(e) for e in ('horizontalaperture', 'filmbackwidth', 'aperturewidth', 'filmwidth',\n                                      'hfilmaperture')):\n        take('aperture', k, v)\n    elif kn.endswith('shutterangle'):\n        take('shutter_angle', k, v)\n    elif kn.endswith('shuttershape') and isinstance(v, _STR):\n        cam.setdefault('shutter_shape', v)\n        src.setdefault('shutter_shape', k)\n    elif full.endswith('cameradirection') and isinstance(v, _STR):\n        cam.setdefault('shutter_dir', v)\n        src.setdefault('shutter_dir', k)\n\n\ndef _inv4(m):\n    \"\"\"Inverse of a 4x4 matrix (list of 16, row-major) by Gauss-Jordan elimination.\"\"\"\n    a = \[list(m\[r * 4:r * 4 + 4\]) + \[1.0 if r == c else 0.0 for c in range(4)\] for r in range(4)\]\n    for c in range(4):\n        p = max(range(c, 4), key=lambda r: abs(a\[r\]\[c\]))\n        if abs(a\[p\]\[c\]) < 1e-15:\n            raise ValueError('singular camera matrix')\n        a\[c\], a\[p\] = a\[p\], a\[c\]\n        d = a\[c\]\[c\]\n        a\[c\] = \[x / d for x in a\[c\]\]\n        for r in range(4):\n            if r != c and a\[r\]\[c\] != 0.0:\n                f = a\[r\]\[c\]\n                a\[r\] = \[x - f * y for x, y in zip(a\[r\], a\[c\])\]\n    return \[a\[r\]\[4 + c\] for r in range(4) for c in range(4)\]\n\n\ndef _dot(a, b):\n    return a\[0\] * b\[0\] + a\[1\] * b\[1\] + a\[2\] * b\[2\]\n\n\ndef _unit(a):\n    n = math.sqrt(_dot(a, a)) + 1e-12\n    return \[a\[0\] / n, a\[1\] / n, a\[2\] / n\]\n\n\ndef _cross(a, b):\n    return \[a\[1\] * b\[2\] - a\[2\] * b\[1\], a\[2\] * b\[0\] - a\[0\] * b\[2\], a\[0\] * b\[1\] - a\[1\] * b\[0\]\]\n\n\ndef camera_from_metadata(md):\n    \"\"\"\{'pos', 'right', 'up', 'back', 'th', 'focal', 'film', 'fstop', 'focus', 'lens', 'shutter', 'source'\} from one\n    frame's metadata, or None when it holds no camera.\"\"\"\n    items = header_items(md)\n    cam, src, lens = \{\}, \{\}, \{\}\n\n    def take(field, k, v, n=1):\n        vals = _nums(v)\n        if len(vals) >= n and field not in cam:\n            cam\[field\] = vals\[:n\] if n > 1 else vals\[0\]\n            src\[field\] = k\n\n    for k, v, g in items:\n        if g is None:\n            _match(k, v, False, cam, src, lens, take)\n    score = _rank_groups(items, cam)\n    for k, v, g in sorted(\[it for it in items if it\[2\] is not None\], key=lambda it: -score.get(it\[2\], 0)):\n        _match(k, v, True, cam, src, lens, take)\n    if 'toworld' not in cam and 'w2c' in cam:\n        try:\n            cam\['toworld'\] = _inv4(cam\['w2c'\])\n        except ValueError:\n            return None\n    if 'toworld' not in cam:\n        return None\n    M = \[float(x) for x in cam\['toworld'\]\]\n    rows = \[M\[0:4\], M\[4:8\], M\[8:12\], M\[12:16\]\]\n    if sum(abs(rows\[i\]\[3\]) for i in range(3)) > sum(abs(x) for x in rows\[3\]\[:3\]):   # column-vector convention\n        rows = \[\[rows\[c\]\[r\] for c in range(4)\] for r in range(4)\]\n    back = _unit(rows\[2\]\[:3\])\n    r = rows\[0\]\[:3\]\n    d = _dot(r, back)\n    right = _unit(\[r\[0\] - back\[0\] * d, r\[1\] - back\[1\] * d, r\[2\] - back\[2\] * d\])\n    up = _cross(back, right)\n    focal, ap = cam.get('focal'), cam.get('aperture')\n    if ap is not None and ap < 5:\n        ap *= 25.4\n    if cam.get('hfov'):\n        hfov = math.radians(cam\['hfov'\])\n    elif focal and ap:\n        hfov = 2 * math.atan(ap / (2 * focal))\n    else:\n        return None\n    film = ap if ap else (2 * focal * math.tan(hfov / 2) if focal else None)\n    if 'blades' in lens:\n        lens\['blades'\] = int(round(lens\['blades'\]))\n    shutter = \{\}\n    if 'shutteropen' in cam and 'shutterclose' in cam:\n        o, c = cam\['shutteropen'\], cam\['shutterclose'\]\n        shutter\['angle'\] = abs(c - o) * 360.0\n        shutter\['mode'\] = 'backward' if c <= 0 else 'forward' if o >= 0 else 'centred'\n    if 'shutter_angle' in cam:\n        shutter\['angle'\] = cam\['shutter_angle'\]\n    dn = _norm(cam.get('shutter_dir', ''))\n    if dn in ('backward', 'forward', 'centered', 'centred', 'center', 'centre'):\n        shutter\['mode'\] = 'centred' if dn.startswith('cent') else dn\n    if cam.get('shutter_shape'):\n        shape = _norm(cam\['shutter_shape'\])\n        shutter\['shape'\] = 'backwardsShape' if 'backwardsshape' in shape else \\\n            'box' if shape in ('box', 'square', 'flat') else cam\['shutter_shape'\]\n    return dict(pos=rows\[3\]\[:3\], right=right, up=up, back=back, th=math.tan(hfov / 2), focal=focal, film=film,\n                fstop=cam.get('fstop'), focus=cam.get('focus'), lens=lens, shutter=shutter, source=src)\n\n\ndef _metadata(node, frame):\n    try:\n        return node.metadata(None, frame) or \{\}\n    except TypeError:\n        return node.metadata() or \{\}\n    except Exception:\n        return \{\}\n\n\ndef _same(a, b):\n    return all(abs(x - y) <= 1e-6 * max(1.0, abs(y)) for x, y in zip(a, b))\n\n\nVEC_KNOBS = (('cam_pos', 'pos'), ('cam_right', 'right'), ('cam_up', 'up'), ('cam_back', 'back'))\nHDR_KNOBS = (('hdr_focal', 'focal'), ('hdr_film', 'film'), ('hdr_fstop', 'fstop'), ('hdr_focus', 'focus'))\nLENS_KNOBS = (('hdr_blades', 'blades'), ('hdr_cateye', 'cateye'), ('hdr_anamorphic', 'anamorphic'),\n              ('hdr_field_curv', 'field_curv'), ('hdr_fstop_full', 'fstop_full'))\n\n\ndef _flat(c):\n    return list(c\['pos'\]) + list(c\['right'\]) + list(c\['up'\]) + list(c\['back'\]) + \[c\['th'\]\] + \\\n        \[c\[k\] or 0.0 for k in ('focal', 'film', 'fstop', 'focus')\]\n\n\ndef _set_knob(k, values, frames):\n    \"\"\"Sets a knob to one value (static) or to linear keys per frame. values: list per frame of a number or list.\"\"\"\n    vals0 = values\[0\] if isinstance(values\[0\], (list, tuple)) else \[values\[0\]\]\n    n = len(vals0)\n    static = all(_same(v if isinstance(v, (list, tuple)) else \[v\], vals0) for v in values)\n    for i in range(n):\n        try:\n            k.clearAnimated(i)\n        except Exception:\n            pass\n    if static:\n        k.setValue(vals0 if n > 1 else vals0\[0\])\n        return\n    for i in range(n):\n        k.setAnimated(i)\n        for f, v in zip(frames, values):\n            k.setValueAt((v\[i\] if isinstance(v, (list, tuple)) else v), f, i)\n        try:\n            a = k.animation(i)\n            a.changeInterpolation(a.keys(), nuke.LINEAR)\n        except Exception:\n            pass\n\n\ndef read_camera(grp, frames=None):\n    \"\"\"Reads the camera from the utility input's header on every frame (or the given ones) into the camera knobs.\n    Returns (camera on the first frame or None, 'static' / 'moving', how many frames had one).\"\"\"\n    util = grp.input(0)\n    if util is None:\n        return None, '', 0\n    if frames is None:\n        first, last = int(grp\['first'\].value()), int(grp\['last'\].value())\n        if last < first:\n            first, last = last, first\n        probe = sorted(set(\[first, (first + last) // 2, last\]))\n        cams = \[camera_from_metadata(_metadata(util, f)) for f in probe\]\n        cams = \[c for c in cams if c\]\n        moving = len(cams) > 1 and not all(_same(_flat(c), _flat(cams\[0\])) for c in cams)\n        frames = list(range(first, last + 1)) if moving else probe\[:1\]\n    got, cams = \[\], \[\]\n    for f in frames:\n        c = camera_from_metadata(_metadata(util, f))\n        if c:\n            got.append(f)\n            cams.append(c)\n    if not cams:\n        return None, '', 0\n    for kname, field in VEC_KNOBS:\n        _set_knob(grp\[kname\], \[c\[field\] for c in cams\], got)\n    _set_knob(grp\['cam_th'\], \[c\['th'\] for c in cams\], got)\n    for kname, field in HDR_KNOBS:\n        _set_knob(grp\[kname\], \[c\[field\] or 0.0 for c in cams\], got)\n    lens = cams\[0\]\['lens'\]\n    for kname, field in LENS_KNOBS:\n        grp\[kname\].setValue(lens.get(field, 0) or 0)\n    sh = cams\[0\]\['shutter'\]\n    if sh and not grp\['mf_shutter_read'\].value():\n        if 'angle' in sh:\n            grp\['shutter'\].setValue(sh\['angle'\])\n        modes = ('backward', 'centred', 'forward')\n        if sh.get('mode') in modes:\n            grp\['shutter_mode'\].setValue(modes.index(sh\['mode'\]))\n        if sh.get('shape') in ('backwardsShape', 'box'):\n            grp\['shutter_shape'\].setValue(('backwardsShape', 'box').index(sh\['shape'\]))\n        grp\['mf_shutter_read'\].setValue(True)\n    src = cams\[0\]\['source'\]\n    grp\['mf_cam_src'\].setValue(json.dumps(dict(\n        frames=\[got\[0\], got\[-1\]\], n=len(got), pos=\[round(x, 4) for x in cams\[0\]\['pos'\]\], keys=sorted(set(src.values())),\n        range=\[int(grp\['first'\].value()), int(grp\['last'\].value())\])))\n    return cams\[0\], ('moving' if len(cams) > 1 else 'static'), len(cams)\n\n\n# ---------------------------------------------------------------------------------------------------------------------\n#  Reading the node's own images (fit box, check)\n# ---------------------------------------------------------------------------------------------------------------------\ndef _sample(node, x, y, chans='rgba'):\n    names = ('red', 'green', 'blue', 'alpha')\n    return \[node.sample(chans + '.' + c, x + 0.5, y + 0.5) for c in names\]\n\n\ndef _cam_now(grp):\n    return dict(pos=list(grp\['cam_pos'\].value()), right=list(grp\['cam_right'\].value()), up=list(grp\['cam_up'\].value()),\n                back=list(grp\['cam_back'\].value()), th=grp\['cam_th'\].value())\n\n\ndef _ray(cam, W, H, px, py):\n    tv = cam\['th'\] * H / float(W)\n    a = (px / W * 2 - 1) * cam\['th'\]\n    b = (py / H * 2 - 1) * tv\n    d = \[cam\['right'\]\[i\] * a + cam\['up'\]\[i\] * b - cam\['back'\]\[i\] for i in range(3)\]\n    return _unit(d)\n\n\ndef _percentile(vals, q):\n    s = sorted(vals)\n    if not s:\n        return 0.0\n    k = (len(s) - 1) * q / 100.0\n    i = int(math.floor(k))\n    j = min(i + 1, len(s) - 1)\n    return s\[i\] + (s\[j\] - s\[i\]) * (k - i)\n\n\ndef surface_points(grp, nx=96, ny=54):\n    \"\"\"World points (scene units) of clean pixels on a grid, from the node's surface image.\"\"\"\n    surf = _inner(grp, 'mf_surface')\n    W, H = surf.width(), surf.height()\n    cam = _cam_now(grp)\n    pts = \[\]\n    for j in range(ny):\n        for i in range(nx):\n            px = int((i + 0.5) * W / nx)\n            py = int((j + 0.5) * H / ny)\n            ray = surf.sample('rgba.blue', px + 0.5, py + 0.5)\n            clean = surf.sample('rgba.alpha', px + 0.5, py + 0.5)\n            if clean < 0.5 or ray <= 0:\n                continue\n            d = _ray(cam, W, H, px + 0.5, py + 0.5)\n            pts.append(\[cam\['pos'\]\[k\] + d\[k\] * ray for k in range(3)\])\n    return pts, cam\n\n\ndef fit_box(grp, far_pct=85.0):\n    \"\"\"Fits the dust box to the set (mirrors motefield/place.py): from just in front of the camera out to most of the\n    set, over the floor the camera sees, up to a metre above the camera.\"\"\"\n    pts, cam = surface_points(grp)\n    if len(pts) < 50:\n        raise ValueError('Not enough of the set is visible on this frame to fit a box.')\n    su = UNITS\[int(grp\['units'\].value())\]\n    dist = \[math.sqrt(sum((p\[k\] - cam\['pos'\]\[k\]) ** 2 for k in range(3))) for p in pts\]\n    lim = _percentile(dist, far_pct)\n    near = \[p for p, d in zip(pts, dist) if d <= lim\]\n    lo = \[_percentile(\[p\[k\] for p in near\], 1.0) for k in range(3)\]\n    hi = \[_percentile(\[p\[k\] for p in near\], 99.0) for k in range(3)\]\n    pad = 0.5 / su\n    lo = \[min(lo\[k\], cam\['pos'\]\[k\] - pad) for k in range(3)\]\n    hi = \[max(hi\[k\], cam\['pos'\]\[k\] + pad) for k in range(3)\]\n    hi\[1\] = min(hi\[1\], cam\['pos'\]\[1\] + 1.0 / su)\n    centre = \[(lo\[k\] + hi\[k\]) / 2 for k in range(3)\]\n    size = \[max(hi\[k\] - lo\[k\], 0.2 / su) for k in range(3)\]\n    grp\['box_center'\].setValue(centre)\n    grp\['box_size'\].setValue(size)\n    grp\['box_rot'\].setValue(0.0)\n    return centre, size\n\n\ndef mote_count(grp):\n    su = UNITS\[int(grp\['units'\].value())\]\n    size = \[max(s * su, 0.02) for s in grp\['box_size'\].value()\]\n    n = math.floor(grp\['density'\].value() * grp\['master_amount'\].value() * size\[0\] * size\[1\] * size\[2\] + 0.5)\n    return int(max(0, min(n, int(grp\['max_motes'\].value()), MAX_MOTES))), int(n)\n\n\nMAX_MOTES = 65536\n\n\ndef facts(grp):\n    \"\"\"What the facts kernel found out about the pass.\"\"\"\n    n = _inner(grp, 'mf_facts')\n    f0, f1, f2 = (_sample(n, x, 0) for x in range(3))\n    return dict(p_premult=f0\[0\] > 0.5, has_alpha=f0\[1\] > 0.5, has_p=f0\[2\] > 0.5, has_z=int(f0\[3\]) % 2 == 1,\n                has_zraw=f0\[3\] >= 2, z_view=f1\[0\] > 0.5, z_premult=f1\[1\] > 0.5, zraw_view=f1\[2\] > 0.5,\n                zraw_premult=f1\[3\] > 0.5, edge_samples=int(f2\[0\]), full_samples=int(f2\[1\]), samples=int(f2\[2\]))\n\n\ndef check(grp):\n    \"\"\"A report on the shot: \[(level, title, detail)\], level 'ok', 'note', 'warn' or 'problem'.\"\"\"\n    out = \[\]\n    if grp.input(0) is None:\n        return \[('problem', 'No utility pass', 'Connect the Read of the utility pass to the utility input.')\]\n    found = detect_layers(grp, force=False)\n    names = dict(P='position', N='normals', Z='depth', Zraw='unfiltered depth', A='coverage', C='surface colour')\n    have = ', '.join('%s (%s)' % (names\[r\], found\[r\]) for r in ('P', 'N', 'Z', 'Zraw', 'A', 'C') if found.get(r))\n    out.append(('ok' if found.get('P') or found.get('Z') or found.get('Zraw') else 'problem', 'Layers',\n                have or 'No position or depth layer found. Pick them on the Shot tab.'))\n    try:\n        src = json.loads(grp\['mf_cam_src'\].value() or '\{\}')\n    except ValueError:\n        src = \{\}\n    if src.get('n'):\n        out.append(('ok', 'Camera', 'From the pass header on %d frame(s) (%s).' % (src\['n'\], ', '.join(src.get('keys', \[\])\[:6\]))))\n    else:\n        out.append(('problem', 'Camera', 'No camera found in the pass header. Press Read camera, or check the pass '\n                    'has the camera matrices in its header.'))\n    try:\n        fa = facts(grp)\n        how = \[\]\n        how.append('positions %s by coverage' % ('premultiplied' if fa\['p_premult'\] else 'not premultiplied'))\n        if fa\['has_z'\]:\n            how.append('depth along the %s%s' % ('view axis' if fa\['z_view'\] else 'ray',\n                                                  ', premultiplied' if fa\['z_premult'\] else ''))\n        if fa\['has_zraw'\]:\n            how.append('unfiltered depth along the %s' % ('view axis' if fa\['zraw_view'\] else 'ray'))\n        how.append('holdouts from %s' % ('the unfiltered depth' if fa\['has_zraw'\] else 'the depth' if fa\['has_z'\]\n                                         else 'the positions'))\n        out.append(('ok' if fa\['has_alpha'\] else 'note', 'The pass',\n                    '; '.join(how) + ('' if fa\['has_alpha'\] else '; no coverage (alpha): taken as 1 wherever there is data')))\n    except Exception as exc:\n        out.append(('warn', 'The pass', 'Could not read it yet (%s).' % exc))\n    try:\n        pts, cam = surface_points(grp, 48, 27)\n        if pts:\n            su = UNITS\[int(grp\['units'\].value())\]\n            dist = sorted(math.sqrt(sum((p\[k\] - cam\['pos'\]\[k\]) ** 2 for k in range(3))) for p in pts)\n            med = dist\[len(dist) // 2\] * su\n            if med > 300 or med < 0.05:\n                out.append(('warn', 'Scene units', 'The set is a median %.3g m from the camera in %s: check Scene '\n                            'units.' % (med, grp\['units'\].value())))\n            else:\n                out.append(('ok', 'Scene units', 'The set is a median %.3g m from the camera.' % med))\n    except Exception:\n        pass\n    n, want = mote_count(grp)\n    if want > n:\n        out.append(('warn', 'Motes', '%d motes (density x box wants %d; capped by Max motes or the node\\'s limit '\n                    'of %d).' % (n, want, MAX_MOTES)))\n    else:\n        out.append(('ok', 'Motes', '%d motes.' % n))\n    return out\n\n\ndef report_html(items):\n    col = dict(ok='#7c7', note='#9bd', warn='#eb6', problem='#e77')\n    return '<br>'.join('<span style=\"color:%s\">%s</span> <b>%s</b>: %s' % (col\[l\], l.upper(), t, d.replace('<', '&lt;'))\n                       for l, t, d in items)\n\n\ndef status(grp):\n    try:\n        src = json.loads(grp\['mf_cam_src'\].value() or '\{\}')\n    except ValueError:\n        src = \{\}\n    n, want = mote_count(grp)\n    bits = \[\]\n    if grp.input(0) is None:\n        bits.append('connect the utility pass to the <b>utility</b> input')\n    else:\n        bits.append('camera from the pass' if src.get('n') else '<span style=\"color:#e77\">no camera yet: press Read camera</span>')\n    bits.append('%d motes' % n + (' (capped)' if want > n else ''))\n    grp\['mf_status'\].setValue(' &middot; '.join(bits))\n\n\n# ---------------------------------------------------------------------------------------------------------------------\n#  Events\n# ---------------------------------------------------------------------------------------------------------------------\ndef connected(grp):\n    \"\"\"The utility input was connected: layers, frame range, camera, and a box if it still has the default.\"\"\"\n    util = grp.input(0)\n    if util is None:\n        return\n    detect_layers(grp, force=True)\n    try:\n        f0, f1 = int(util.firstFrame()), int(util.lastFrame())\n        if (int(grp\['first'\].value()), int(grp\['last'\].value())) == (1001, 1048) and f1 >= f0:\n            grp\['first'\].setValue(f0)\n            grp\['last'\].setValue(f1)\n    except Exception:\n        pass\n    cam, how, n = read_camera(grp)\n    if cam is not None and _same(list(grp\['box_size'\].value()), DEFAULT_BOX\[1\]) and \\\n            _same(list(grp\['box_center'\].value()), DEFAULT_BOX\[0\]):\n        try:\n            fit_box(grp)\n        except Exception:\n            pass\n    status(grp)\n\n\ndef button(grp, which):\n    if which == 'read_camera':\n        cam, how, n = read_camera(grp)\n        if cam is None:\n            nuke.message('MoteField: no camera found in the header of the utility pass.')\n        status(grp)\n    elif which == 'fit_box':\n        try:\n            fit_box(grp)\n        except Exception as exc:\n            nuke.message('MoteField: %s' % exc)\n        status(grp)\n    elif which == 'check_shot':\n        items = check(grp)\n        grp\['mf_report'\].setValue(report_html(items))\n    elif which == 'find_layers':\n        detect_layers(grp, force=True)\n        status(grp)\n    elif which == 'repair':\n        bad = setup(grp)\n        nuke.message('MoteField: ' + ('everything is linked.' if not bad else 'could not link: %s' % bad))\n\n\ndef camera_changed(grp):\n    \"\"\"True when the pass's header no longer says what the camera knobs were read from (a new version of the pass,\n    or a new frame range).\"\"\"\n    util = grp.input(0)\n    if util is None:\n        return False\n    try:\n        src = json.loads(grp\['mf_cam_src'\].value() or '\{\}')\n    except ValueError:\n        src = \{\}\n    if not src.get('n'):\n        return False\n    if src.get('range') and src\['range'\] != \[int(grp\['first'\].value()), int(grp\['last'\].value())\]:\n        return True\n    c = camera_from_metadata(_metadata(util, src\['frames'\]\[0\]))\n    return c is not None and not _same(\[round(x, 4) for x in c\['pos'\]\], src\['pos'\])\n\n\ndef created(grp):\n    \"\"\"The node was made (pasted, or its script opened): wire and link it; if it arrived already connected to a pass\n    it has not read yet, read it.\"\"\"\n    setup(grp)\n    if grp.input(0) is not None and not grp\['mf_cam_src'\].value():\n        connected(grp)\n    else:\n        status(grp)\n\n\ndef knob_changed(grp, knob):\n    name = knob.name() if knob is not None else ''\n    if name == 'inputChange':\n        if grp.input(0) is not None and not grp\['mf_cam_src'\].value():\n            connected(grp)\n        else:\n            status(grp)\n    elif name == 'showPanel':\n        if grp\['mf_version'\].value() != VERSION:\n            setup(grp)\n        if camera_changed(grp):\n            read_camera(grp)\n        status(grp)\n    elif name in ('density', 'master_amount', 'box_size', 'units', 'max_motes'):\n        status(grp)\n"
}
