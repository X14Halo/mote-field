BlinkScript {
 inputs 3
 kernelSource "// MoteField: facts about the utility pass, from a grid of samples (4 x 1 pixels out):\n//   pixel 0: position premultiplied by coverage (1/0), alpha present, position present, depth present + 2 x unfiltered depth present\n//   pixel 1: depth along the view axis (1) or the ray (0), depth premultiplied, the same two for the unfiltered depth\n//   pixel 2: edge samples, fully covered samples, samples, 0\n// Mirrors shot.build_surface in the Python reference: premultiplication is found by reprojecting edge pixels.\nkernel MFFacts : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessPoint, eEdgeClamped> space;\n  Image<eRead, eAccessRandom, eEdgeClamped> pos;\n  Image<eRead, eAccessRandom, eEdgeClamped> depth;\n  Image<eWrite> dst;\n\n  param:\n    float3 cam_pos;\n    float3 cam_right;\n    float3 cam_up;\n    float3 cam_back;\n    float cam_th;\n  local:\n    float Wf;\n    float Hf;\n\n  void define() \{\n    defineParam(cam_pos, \"cam_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(cam_right, \"cam_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(cam_up, \"cam_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(cam_back, \"cam_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(cam_th, \"cam_th\", 0.5f);\n  \}\n\n\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  // ---- the camera: world point -> pixel x, y (Nuke's, y up, pixel centres at .5) and depth along the view\n  float3 project_cam(float3 P, float3 pos, float3 rr, float3 uu, float3 bb, float th) \{\n    float3 d = P - pos;\n    float x = dot(d, rr);\n    float y = dot(d, uu);\n    float z = -dot(d, bb);\n    float zs = z > 1e-9f ? z : 1e-9f;\n    float tv = th * Hf / Wf;\n    return float3((x / zs / th * 0.5f + 0.5f) * Wf, (y / zs / tv * 0.5f + 0.5f) * Hf, z);\n  \}\n  float3 project_mid(float3 P) \{\n    return project_cam(P, cam_pos, cam_right, cam_up, cam_back, cam_th);\n  \}\n  // the unit direction of the ray through pixel position (px, py)\n  float3 ray_dir(float px, float py) \{\n    float tv = cam_th * Hf / Wf;\n    float3 d = cam_right * ((px / Wf * 2.0f - 1.0f) * cam_th) + cam_up * ((py / Hf * 2.0f - 1.0f) * tv) - cam_back;\n    return unit3(d);\n  \}\n  void init() \{\n    Wf = float(pos.bounds.width());\n    Hf = float(pos.bounds.height());\n  \}\n\n  float reproj(float3 P, float px, float py) \{\n    float3 p = project_mid(P);\n    if (p.z <= 0.0f) \{\n      return 1e9f;\n    \}\n    float dx = p.x - px;\n    float dy = p.y - py;\n    return sqrt(dx * dx + dy * dy);\n  \}\n\n  void process(int2 xy) \{\n    int x0 = pos.bounds.x1;\n    int y0 = pos.bounds.y1;\n    int gx = 160;\n    int gy = 90;\n    float has_a = 0.0f;\n    float has_p = 0.0f;\n    float has_z = 0.0f;\n    float has_zr = 0.0f;\n    float n_edge = 0.0f;\n    float n_full = 0.0f;\n    float votes = 0.0f;\n    for (int j = 0; j < gy; j++) \{\n      for (int i = 0; i < gx; i++) \{\n        int sx = x0 + int((float(i) + 0.5f) * Wf / float(gx));\n        int sy = y0 + int((float(j) + 0.5f) * Hf / float(gy));\n        float4 p = pos(sx, sy);\n        float4 z = depth(sx, sy);\n        float3 P = float3(p.x, p.y, p.z);\n        if (p.w > 0.0f) \{\n          has_a = 1.0f;\n        \}\n        if (fabs(p.x) + fabs(p.y) + fabs(p.z) > 0.0f) \{\n          has_p = 1.0f;\n        \}\n        if (z.x > 0.0f) \{\n          has_z = 1.0f;\n        \}\n        if (z.y > 0.0f) \{\n          has_zr = 1.0f;\n        \}\n        if (p.w >= 0.98f) \{\n          n_full += 1.0f;\n        \}\n        if (p.w > 0.02f && p.w < 0.98f) \{\n          n_edge += 1.0f;\n          float px = float(sx) + 0.5f;\n          float py = float(sy) + 0.5f;\n          float e_raw = reproj(P, px, py);\n          float e_div = reproj(P / max(p.w, 1e-6f), px, py);\n          if (e_div < e_raw) \{\n            votes += 1.0f;\n          \}\n        \}\n      \}\n    \}\n    float premult = (n_edge >= 20.0f && votes > 0.5f * n_edge) ? 1.0f : 0.0f;\n    if (xy.x == 0) \{\n      dst() = float4(premult, has_a, has_p, has_z + 2.0f * has_zr);\n      return;\n    \}\n    if (xy.x == 2) \{\n      dst() = float4(n_edge, n_full, float(gx * gy), 0.0f);\n      return;\n    \}\n    if (xy.x != 1 || has_p == 0.0f) \{\n      dst() = float4(0.0f);\n      return;\n    \}\n    // depth: along the ray or the view axis, and premultiplied or not (checked against the positions)\n    float zk_n = 0.0f;\n    float zk_v = 0.0f;\n    float zp_n = 0.0f;\n    float zp_v = 0.0f;\n    float rk_n = 0.0f;\n    float rk_v = 0.0f;\n    float rp_n = 0.0f;\n    float rp_v = 0.0f;\n    for (int j = 0; j < gy; j++) \{\n      for (int i = 0; i < gx; i++) \{\n        int sx = x0 + int((float(i) + 0.5f) * Wf / float(gx));\n        int sy = y0 + int((float(j) + 0.5f) * Hf / float(gy));\n        float4 p = pos(sx, sy);\n        float4 z = depth(sx, sy);\n        float cov = has_a > 0.0f ? clamp(p.w, 0.0f, 1.0f) : 1.0f;\n        float3 P = float3(p.x, p.y, p.z);\n        if (premult > 0.0f) \{\n          P = P / max(cov, 1e-6f);\n        \}\n        if (fabs(p.x) + fabs(p.y) + fabs(p.z) <= 0.0f) \{\n          continue;\n        \}\n        float ray = len3(P - cam_pos);\n        if (ray <= 0.0f) \{\n          continue;\n        \}\n        float cosang = fabs(dot(ray_dir(float(sx) + 0.5f, float(sy) + 0.5f), cam_back));\n        if (cov >= 0.98f) \{\n          if (z.x > 0.0f) \{\n            zk_n += 1.0f;\n            if (fabs(z.x / (ray * cosang) - 1.0f) < fabs(z.x / ray - 1.0f)) \{\n              zk_v += 1.0f;\n            \}\n          \}\n          if (z.y > 0.0f) \{\n            rk_n += 1.0f;\n            if (fabs(z.y / (ray * cosang) - 1.0f) < fabs(z.y / ray - 1.0f)) \{\n              rk_v += 1.0f;\n            \}\n          \}\n        \}\n      \}\n    \}\n    float zview = (zk_n >= 20.0f && zk_v > 0.5f * zk_n) ? 1.0f : 0.0f;\n    float rview = (rk_n >= 20.0f && rk_v > 0.5f * rk_n) ? 1.0f : 0.0f;\n    for (int j = 0; j < gy; j++) \{\n      for (int i = 0; i < gx; i++) \{\n        int sx = x0 + int((float(i) + 0.5f) * Wf / float(gx));\n        int sy = y0 + int((float(j) + 0.5f) * Hf / float(gy));\n        float4 p = pos(sx, sy);\n        float4 z = depth(sx, sy);\n        if (!(has_a > 0.0f && p.w > 0.02f && p.w < 0.98f)) \{\n          continue;\n        \}\n        float cov = p.w;\n        float3 P = float3(p.x, p.y, p.z);\n        if (premult > 0.0f) \{\n          P = P / cov;\n        \}\n        float ray = len3(P - cam_pos);\n        if (ray <= 0.0f) \{\n          continue;\n        \}\n        float cosang = max(fabs(dot(ray_dir(float(sx) + 0.5f, float(sy) + 0.5f), cam_back)), 1e-6f);\n        if (z.x > 0.0f) \{\n          float d = zview > 0.0f ? z.x / cosang : z.x;\n          zp_n += 1.0f;\n          if (fabs(d / cov / ray - 1.0f) < fabs(d / ray - 1.0f)) \{\n            zp_v += 1.0f;\n          \}\n        \}\n        if (z.y > 0.0f) \{\n          float d = rview > 0.0f ? z.y / cosang : z.y;\n          rp_n += 1.0f;\n          if (fabs(d / cov / ray - 1.0f) < fabs(d / ray - 1.0f)) \{\n            rp_v += 1.0f;\n          \}\n        \}\n      \}\n    \}\n    float zpre = (zp_n >= 20.0f && zp_v > 0.5f * zp_n) ? 1.0f : 0.0f;\n    float rpre = (rp_n >= 20.0f && rp_v > 0.5f * rp_n) ? 1.0f : 0.0f;\n    dst() = float4(zview, zpre, rview, rpre);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
