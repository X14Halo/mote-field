BlinkScript {
 inputs 3
 kernelSource "// MoteField: what each pixel sees, made safe to use (mirrors shot.build_surface in the Python reference):\n//   r = distance from the camera to the surface for holdouts (unfiltered depth if there is one; 0 = nothing there)\n//   g = coverage 0..1\n//   b = distance to the surface from the position pass (or the depth), for shadows and bounce light\n//   a = 1 where one surface fills the pixel (safe to use as a 3D point), else 0\nkernel MFSurface : ImageComputationKernel<ePixelWise>\n\{\n  Image<eRead, eAccessRandom, eEdgeClamped> pos;\n  Image<eRead, eAccessRandom, eEdgeClamped> depth;\n  Image<eRead, eAccessRandom, eEdgeClamped> facts;\n  Image<eWrite> dst;\n\n  param:\n    float3 cam_pos;\n    float3 cam_right;\n    float3 cam_up;\n    float3 cam_back;\n    float cam_th;\n    int p_premult;\n    int z_kind;\n    int z_premult;\n  local:\n    float Wf;\n    float Hf;\n\n  void define() \{\n    defineParam(cam_pos, \"cam_pos\", float3(0.0f, 150.0f, 400.0f));\n    defineParam(cam_right, \"cam_right\", float3(1.0f, 0.0f, 0.0f));\n    defineParam(cam_up, \"cam_up\", float3(0.0f, 1.0f, 0.0f));\n    defineParam(cam_back, \"cam_back\", float3(0.0f, 0.0f, 1.0f));\n    defineParam(cam_th, \"cam_th\", 0.5f);\n    defineParam(p_premult, \"p_premult\", -1);\n    defineParam(z_kind, \"z_kind\", -1);\n    defineParam(z_premult, \"z_premult\", -1);\n  \}\n\n\n  // ---- small maths\n  float smooth01(float x) \{\n    float c = clamp(x, 0.0f, 1.0f);\n    return c * c * (3.0f - 2.0f * c);\n  \}\n  float len3(float3 v) \{\n    return sqrt(dot(v, v));\n  \}\n  float3 unit3(float3 v) \{\n    return v / max(len3(v), 1e-12f);\n  \}\n  float wrap1(float x, float s) \{\n    float y = x + s * 0.5f;\n    return y - s * floor(y / s) - s * 0.5f;\n  \}\n  float erf_a(float x) \{\n    // Abramowitz and Stegun 7.1.26 (error under 1.5e-7)\n    float ax = fabs(x);\n    float t = 1.0f / (1.0f + 0.3275911f * ax);\n    float p = ((((1.061405429f * t - 1.453152027f) * t + 1.421413741f) * t - 0.284496736f) * t + 0.254829592f) * t;\n    float r = 1.0f - p * exp(-ax * ax);\n    return x < 0.0f ? -r : r;\n  \}\n  float pi1() \{\n    return 3.14159265358979f;\n  \}\n  int clampi(int x, int a, int b) \{\n    return x < a ? a : (x > b ? b : x);\n  \}\n  // ---- the camera: world point -> pixel x, y (Nuke's, y up, pixel centres at .5) and depth along the view\n  float3 project_cam(float3 P, float3 pos, float3 rr, float3 uu, float3 bb, float th) \{\n    float3 d = P - pos;\n    float x = dot(d, rr);\n    float y = dot(d, uu);\n    float z = -dot(d, bb);\n    float zs = z > 1e-9f ? z : 1e-9f;\n    float tv = th * Hf / Wf;\n    return float3((x / zs / th * 0.5f + 0.5f) * Wf, (y / zs / tv * 0.5f + 0.5f) * Hf, z);\n  \}\n  float3 project_mid(float3 P) \{\n    return project_cam(P, cam_pos, cam_right, cam_up, cam_back, cam_th);\n  \}\n  // the unit direction of the ray through pixel position (px, py)\n  float3 ray_dir(float px, float py) \{\n    float tv = cam_th * Hf / Wf;\n    float3 d = cam_right * ((px / Wf * 2.0f - 1.0f) * cam_th) + cam_up * ((py / Hf * 2.0f - 1.0f) * tv) - cam_back;\n    return unit3(d);\n  \}\n  void init() \{\n    Wf = float(pos.bounds.width());\n    Hf = float(pos.bounds.height());\n  \}\n\n  // coverage and distance along the ray from the position pass at a pixel (0 where empty)\n  float2 cov_ray(int x, int y, float has_a, float premult) \{\n    float4 p = pos(x, y);\n    float4 z = depth(x, y);\n    bool have = fabs(p.x) + fabs(p.y) + fabs(p.z) > 0.0f || z.x > 0.0f || z.y > 0.0f;\n    float cov = has_a > 0.0f ? clamp(p.w, 0.0f, 1.0f) : (have ? 1.0f : 0.0f);\n    if (cov <= 0.0f || fabs(p.x) + fabs(p.y) + fabs(p.z) <= 0.0f) \{\n      return float2(cov, 0.0f);\n    \}\n    float3 P = float3(p.x, p.y, p.z);\n    if (premult > 0.0f) \{\n      P = P / max(cov, 1e-6f);\n    \}\n    return float2(cov, len3(P - cam_pos));\n  \}\n\n  void process(int2 xy) \{\n    float4 f0 = facts(0, 0);\n    float4 f1 = facts(1, 0);\n    float has_a = f0.y;\n    float has_p = f0.z;\n    float has_z = fmod(f0.w, 2.0f);\n    float has_zr = f0.w >= 2.0f ? 1.0f : 0.0f;\n    float premult = p_premult >= 0 ? float(p_premult) : f0.x;\n    float zview = z_kind >= 0 ? float(z_kind) : f1.x;\n    float rview = z_kind >= 0 ? float(z_kind) : f1.z;\n    float zpre = z_premult >= 0 ? float(z_premult) : f1.y;\n    float rpre = z_premult >= 0 ? float(z_premult) : f1.w;\n    if (has_p == 0.0f) \{\n      zpre = 0.0f;\n      rpre = 0.0f;\n      if (z_kind < 0) \{\n        zview = 0.0f;\n        rview = 0.0f;\n      \}\n    \}\n    float2 cr = cov_ray(xy.x, xy.y, has_a, premult);\n    float cov = cr.x;\n    float ray = cr.y;\n    float4 z = depth(xy.x, xy.y);\n    float cosang = max(fabs(dot(ray_dir(float(xy.x) + 0.5f, float(xy.y) + 0.5f), cam_back)), 1e-6f);\n    float zd = 0.0f;\n    float rd = 0.0f;\n    if (cov > 0.0f) \{\n      zd = max(z.x, 0.0f);\n      rd = max(z.y, 0.0f);\n      if (zview > 0.0f) \{\n        zd = zd / cosang;\n      \}\n      if (rview > 0.0f) \{\n        rd = rd / cosang;\n      \}\n      if (zpre > 0.0f) \{\n        zd = zd / max(cov, 1e-6f);\n      \}\n      if (rpre > 0.0f) \{\n        rd = rd / max(cov, 1e-6f);\n      \}\n    \}\n    float dist = has_zr > 0.0f ? rd : (has_z > 0.0f ? zd : (cov > 0.0f ? ray : 0.0f));\n    if (has_p == 0.0f) \{\n      ray = dist;\n    \}\n    // clean: fully covered by one surface (not mixed per the unfiltered depth, no depth jump to a neighbour)\n    float clean = (cov >= 0.98f && ray > 0.0f) ? 1.0f : 0.0f;\n    if (clean > 0.0f && has_zr > 0.0f && has_p > 0.0f && fabs(rd - ray) > 0.02f * max(ray, 1e-6f)) \{\n      clean = 0.0f;\n    \}\n    if (clean > 0.0f && has_p > 0.0f) \{\n      for (int dy = -1; dy <= 1; dy++) \{\n        for (int dx = -1; dx <= 1; dx++) \{\n          int nx = xy.x + dx;\n          int ny = xy.y + dy;\n          if ((dx == 0 && dy == 0) || nx < pos.bounds.x1 || ny < pos.bounds.y1 || nx >= pos.bounds.x2 || ny >= pos.bounds.y2) \{\n            continue;\n          \}\n          float rn = cov_ray(nx, ny, has_a, premult).y;\n          if (fabs(rn - ray) > 0.04f * max(min(rn, ray), 1e-6f)) \{\n            clean = 0.0f;\n          \}\n        \}\n      \}\n    \}\n    dst() = float4(dist, cov, ray, clean);\n  \}\n\};\n"
 rebuild ""
 rebuild_finalise ""
 useGPUIfAvailable {{parent.use_gpu}}
 name mf_surface
 onCreate "import sys, types, nuke\ndef _mf(grp):\n    src = grp\['mf_py'\].value()\n    m = sys.modules.get('_motefield_node')\n    if m is None or getattr(m, '_mf_src', None) != src:\n        m = types.ModuleType('_motefield_node')\n        exec(compile(src, 'MoteField', 'exec'), m.__dict__)\n        m._mf_src = src\n        sys.modules\['_motefield_node'\] = m\n    return m\n_g = nuke.thisGroup()\ntry:\n    _mf(_g).link_kernel(_g, 'mf_surface')\nexcept Exception:\n    pass\n"
